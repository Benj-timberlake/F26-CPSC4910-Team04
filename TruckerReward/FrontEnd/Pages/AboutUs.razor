@page "/about-us"

<PageTitle>About Us | TruckerReward</PageTitle>

<div class="tr-page about-page">
    <h1>About Us</h1>
    <section class="tr-card about-intro">
        <h2>Rewards for the road ahead</h2>
        <p class="tr-subtitle">
            TruckerReward is here to make life on the road a little more rewarding.
            We bring truckers a place to discover products and enjoy benefits built
            around the people who keep America moving.
        </p>
        <a class="tr-btn" href="products">Browse products</a>
    </section>

    <section class="tr-cards about-details" aria-label="About TruckerReward">
        <article class="tr-card">
            <h2>Made with truckers in mind</h2>
            <p>
                Long days and long miles deserve appreciation. Our goal is to make
                finding useful products and rewards straightforward, wherever the
                road takes you.
            </p>
        </article>
        <article class="tr-card">
            <h2>Our purpose</h2>
            <p>
                We want to help drivers get more value from the things they choose,
                with a simple experience that keeps the focus on what matters.
            </p>
        </article>
    </section>
</div>

<style>
    .about-intro {
        margin-bottom: 24px;
        border-left: 4px solid var(--brand);
    }

    .about-intro h2 {
        margin: 0 0 12px;
        font-size: 24px;
    }

    .about-intro p {
        max-width: 650px;
        margin: 0 0 20px;
        line-height: 1.6;
    }

    .about-details h2 {
        margin: 0 0 12px;
        font-size: 20px;
    }

    .about-details p {
        margin: 0;
        color: var(--muted);
        line-height: 1.6;
    }
</style>
