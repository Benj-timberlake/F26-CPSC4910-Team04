@page "/admin/accounts"
@page "/admin/users"
@attribute [Authorize(Roles = "admin")]
@using System.Security.Claims
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Accounts</PageTitle>

<div class="tr-page">
    <h1>Accounts</h1>

    @if (counts is not null)
    {
        <dl class="counts">
            <div><dt>Active drivers</dt><dd class="drivers">@counts.ActiveDrivers</dd></div>
            <div><dt>Active sponsors</dt><dd class="sponsors">@counts.ActiveSponsors</dd></div>
            <div><dt>Active admins</dt><dd>@counts.ActiveAdmins</dd></div>
            <div><dt>Deactivated</dt><dd>@counts.Inactive</dd></div>
        </dl>
    }

    <form class="filters" @onsubmit="Load">
        <input type="search" aria-label="Search accounts" placeholder="Name, username or email" @bind="search" />
        <select aria-label="Account type" @bind="type">
            <option value="">All types</option>
            <option value="driver">Drivers</option>
            <option value="sponsor">Sponsors</option>
            <option value="admin">Admins</option>
        </select>
        <select aria-label="Sponsor" @bind="companyId">
            <option value="0">All sponsors</option>
            <option value="-1">No sponsor</option>
            @foreach (var c in companies)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
        <select aria-label="Status" @bind="status">
            <option value="">Any status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
        <select aria-label="Sort" @bind="sort">
            <option value="name">Sort by name</option>
            <option value="created">Newest accounts first</option>
            <option value="last-login">Most recent sign-in first</option>
        </select>
        <button type="submit" class="tr-btn">Apply</button>
    </form>

    @if (creating is null)
    {
        <button type="button" class="tr-btn-outline new-account" @onclick="() => creating = new()">New account</button>
    }
    else
    {
        <form class="create-form" @onsubmit="Create">
            <select aria-label="New account type" @bind="creating.UserType">
                <option value="driver">Driver</option>
                <option value="sponsor">Sponsor</option>
                <option value="admin">Admin</option>
            </select>
            <input aria-label="New username" placeholder="Username" @bind="creating.Username" />
            <input aria-label="New first name" placeholder="First name" @bind="creating.FirstName" />
            <input aria-label="New last name" placeholder="Last name" @bind="creating.LastName" />
            <input type="email" aria-label="New email" placeholder="Email" @bind="creating.Email" />
            @if (creating.UserType != "admin")
            {
                <select aria-label="New account sponsor" @bind="creating.CompanyId">
                    <option value="0">No sponsor</option>
                    @foreach (var c in companies)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            }
            <button type="submit" class="tr-btn" disabled="@busy">Create</button>
            <button type="button" class="tr-btn-outline" @onclick="() => creating = null">Cancel</button>
        </form>
    }

    @if (notice is not null)
    {
        <p role="status" class="tr-alert-success">@notice</p>
    }
    @if (error is not null)
    {
        <p role="alert" class="tr-alert-error">@error</p>
    }

    @if (accounts is null)
    {
        <p role="status"><em>Loading...</em></p>
    }
    else if (accounts.Count == 0)
    {
        <p class="tr-muted">No accounts match.</p>
    }
    else
    {
        <div class="tr-table-wrap">
            <table class="tr-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Type</th>
                        <th>Created</th>
                        <th>Last sign-in</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in accounts)
                    {
                        <tr class="@(a.Status == "inactive" ? "inactive" : "")">
                            <td>@a.FirstName @a.LastName</td>
                            <td>@a.Username</td>
                            <td>@a.Email</td>
                            <td>@a.UserType</td>
                            <td>@When(a.CreatedAt)</td>
                            <td>@(a.LastLoginAt is null ? "Never" : When(a.LastLoginAt))</td>
                            <td>@a.Status</td>
                            <td>
                                @if (a.Id.ToString() != id)
                                {
                                    <button type="button" class="tr-btn-outline" disabled="@busy" @onclick="() => Toggle(a)">
                                        @(a.Status == "active" ? "Deactivate" : "Reactivate")
                                    </button>
                                    <button type="button" class="tr-btn-outline edit" disabled="@busy" @onclick="() => StartEdit(a)">Edit</button>
                                    @if (a.UserType != "admin" && a.Status == "active")
                                    {
                                        <form class="view-as" method="post" action="account/view-as/@a.Id">
                                            <button type="submit" class="tr-btn-outline">View as</button>
                                        </form>
                                    }
                                }
                            </td>
                        </tr>
                        @if (editing is not null && editing.Id == a.Id)
                        {
                            <tr class="editing">
                                <td colspan="8">
                                    <form class="edit-form" @onsubmit="SaveEdit">
                                        <input aria-label="First name" @bind="editing.FirstName" />
                                        <input aria-label="Last name" @bind="editing.LastName" />
                                        <input type="email" aria-label="Email" @bind="editing.Email" />
                                        <input aria-label="Phone number" @bind="editing.PhoneNumber" />
                                        <input aria-label="Address" @bind="editing.Address" />
                                        @if (a.UserType != "admin")
                                        {
                                            <select aria-label="Account sponsor" @bind="editing.CompanyId">
                                                <option value="0">No sponsor</option>
                                                @foreach (var c in companies)
                                                {
                                                    <option value="@c.Id">@c.Name</option>
                                                }
                                            </select>
                                        }
                                        <button type="submit" class="tr-btn" disabled="@busy">Save</button>
                                        <button type="button" class="tr-btn-outline" @onclick="() => editing = null">Cancel</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 16px;
    }

    .filters input {
        flex: 1;
        min-width: 200px;
    }

    .counts {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin: 0 0 16px;
    }

    .counts div {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 8px 14px;
    }

    .counts dd {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
    }

    form.view-as {
        display: inline;
    }

    .new-account {
        margin-bottom: 16px;
    }

    .create-form, .edit-form {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .create-form {
        margin-bottom: 16px;
    }

    tr.inactive td {
        color: #6b7280;
    }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string? id;
    private List<Account>? accounts;
    private string? search;
    private string type = "";
    private string status = "";
    private string sort = "name";
    private int companyId;
    private Counts? counts;
    private List<Company> companies = [];
    private bool busy;
    private string? error;
    private string? notice;
    private Edit? editing;
    private NewAccount? creating;

    protected override async Task OnInitializedAsync()
    {
        id = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            companies = await client.GetFromJsonAsync<List<Company>>("companies") ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            // the sponsor filter just stays empty
        }
        await Load();
    }

    private async Task Load()
    {
        error = null;
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(search)) query.Add("search=" + Uri.EscapeDataString(search.Trim()));
        if (type != "") query.Add("type=" + type);
        if (companyId > 0) query.Add("companyId=" + companyId);
        if (companyId == -1) query.Add("noSponsor=true");
        if (status != "") query.Add("status=" + status);
        if (sort != "name") query.Add("sort=" + sort);
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            accounts = await client.GetFromJsonAsync<List<Account>>("admin/accounts" + (query.Count > 0 ? "?" + string.Join("&", query) : "")) ?? [];
            counts = await client.GetFromJsonAsync<Counts>("admin/accounts/counts");
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            error = "Couldn't load accounts right now. Try again in a moment.";
        }
    }

    private async Task Toggle(Account a)
    {
        busy = true;
        error = notice = null;
        var next = a.Status == "active" ? "inactive" : "active";
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync($"admin/accounts/{a.Id}/status", new { adminId = int.Parse(id!), status = next });
            if (response.IsSuccessStatusCode)
            {
                notice = $"{a.Username} was {(next == "active" ? "reactivated" : "deactivated")}.";
                await Load();
            }
            else
            {
                error = (await response.Content.ReadFromJsonAsync<Problem>())?.Message ?? "That didn't work.";
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            error = "That didn't work. Reload and try again.";
        }
        busy = false;
    }

    private async Task Create()
    {
        var c = creating!;
        busy = true;
        error = notice = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync("admin/accounts", new
            {
                adminId = int.Parse(id!), userType = c.UserType, username = c.Username, firstName = c.FirstName, lastName = c.LastName,
                email = c.Email, companyId = c.UserType == "admin" || c.CompanyId == 0 ? (int?)null : c.CompanyId
            });
            if (response.IsSuccessStatusCode)
            {
                notice = $"{c.Username.Trim()} was created and emailed a link to set a password.";
                creating = null;
                await Load();
            }
            else
            {
                error = (await response.Content.ReadFromJsonAsync<Problem>())?.Message ?? "That didn't work.";
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            error = "That didn't work. Reload and try again.";
        }
        busy = false;
    }

    private async Task StartEdit(Account a)
    {
        error = notice = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var d = await client.GetFromJsonAsync<Details>($"users/{a.Id}");
            editing = d is null ? null : new Edit { Id = a.Id, Username = a.Username, FirstName = d.FirstName, LastName = d.LastName, Email = d.Email, PhoneNumber = d.PhoneNumber, Address = d.Address, CompanyId = d.CompanyId ?? 0 };
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            error = "Couldn't load that account right now. Try again in a moment.";
        }
    }

    private async Task SaveEdit()
    {
        var e = editing!;
        busy = true;
        error = notice = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PutAsJsonAsync($"admin/accounts/{e.Id}", new
            {
                adminId = int.Parse(id!), firstName = e.FirstName, lastName = e.LastName, email = e.Email,
                phoneNumber = e.PhoneNumber, address = e.Address, companyId = e.CompanyId == 0 ? (int?)null : e.CompanyId
            });
            if (response.IsSuccessStatusCode)
            {
                notice = $"{e.Username} was updated.";
                editing = null;
                await Load();
            }
            else
            {
                error = (await response.Content.ReadFromJsonAsync<Problem>())?.Message ?? "That didn't work.";
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            error = "That didn't work. Reload and try again.";
        }
        busy = false;
    }

    private static string When(DateTime? utc) => utc is null ? "Unknown" : utc.Value.ToString("yyyy-MM-dd HH:mm");

    private sealed record Account(int Id, string Username, string FirstName, string LastName, string Email, string UserType, string Status, DateTime? CreatedAt, DateTime? LastLoginAt);
    private sealed record Problem(string? Message);
    private sealed record Counts(int ActiveDrivers, int ActiveSponsors, int ActiveAdmins, int Inactive);
    private sealed record Company(int Id, string Name);
    private sealed record Details(string FirstName, string LastName, string Email, string PhoneNumber, string Address, int? CompanyId);

    private sealed class NewAccount
    {
        public string UserType { get; set; } = "driver";
        public string Username { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public int CompanyId { get; set; }
    }

    private sealed class Edit
    {
        public int Id { get; init; }
        public string Username { get; init; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string PhoneNumber { get; set; } = "";
        public string Address { get; set; } = "";
        public int CompanyId { get; set; }
    }
}
