@page "/admin/accounts"
@page "/admin/users"
@attribute [Authorize(Roles = "admin")]
@inherits BackendPage

<PageTitle>Accounts</PageTitle>

<div class="tr-page">
    <a class="back-manage-accounts" href="manage-accounts">← Back to Manage Accounts</a>
    <h1>Accounts</h1>

    @if (counts is not null)
    {
        <dl class="counts">
            <div><dt>Active drivers</dt><dd class="drivers">@counts.ActiveDrivers</dd></div>
            <div><dt>Active sponsors</dt><dd class="sponsors">@counts.ActiveSponsors</dd></div>
            <div><dt>Active admins</dt><dd>@counts.ActiveAdmins</dd></div>
            <div><dt>Deactivated</dt><dd>@counts.Inactive</dd></div>
            <div>
                <dt>Drivers without a sponsor</dt>
                <dd><button type="button" class="link no-sponsor" @onclick="ShowUnsponsored">@counts.DriversWithoutSponsor</button></dd>
            </div>
        </dl>
    }

    <form class="filters tr-toolbar" @onsubmit="Load">
        <input type="search" aria-label="Search accounts" placeholder="Name, username or email" @bind="search" />
        <select aria-label="Account type" @bind="type">
            <option value="">All types</option>
            <option value="driver">Drivers</option>
            <option value="sponsor">Sponsors</option>
            <option value="admin">Admins</option>
        </select>
        <select aria-label="Sponsor" @bind="companyId">
            <option value="0">All sponsors</option>
            <option value="-1">No sponsor</option>
            @foreach (var c in companies)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
        <select aria-label="Status" @bind="status">
            <option value="">Any status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
        <select aria-label="Sort" @bind="sort">
            <option value="name">Sort by name</option>
            <option value="created">Newest accounts first</option>
            <option value="last-login">Most recent sign-in first</option>
        </select>
        <button type="submit" class="tr-btn">Apply</button>
    </form>

    <div class="account-actions">
        @if (creating is null)
        {
            <button type="button" class="tr-btn-outline new-account" @onclick="() => creating = new()">New account</button>
        }
        <button type="button" class="mass-account-creation-button" title="Mass Account Creation" aria-label="Open mass account creation" @onclick="() => showMassAccountCreationModal = true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14" />
                <path d="M5 12h14" />
            </svg>
        </button>
    </div>
    @if (creating is not null)
    {
        <form class="create-form tr-toolbar" @onsubmit="Create">
            <select aria-label="New account type" @bind="creating.UserType">
                <option value="driver">Driver</option>
                <option value="sponsor">Sponsor</option>
                <option value="admin">Admin</option>
            </select>
            <input aria-label="New username" placeholder="Username" @bind="creating.Username" />
            <input aria-label="New first name" placeholder="First name" @bind="creating.FirstName" />
            <input aria-label="New last name" placeholder="Last name" @bind="creating.LastName" />
            <input type="email" aria-label="New email" placeholder="Email" @bind="creating.Email" />
            @if (creating.UserType != "admin")
            {
                <select aria-label="New account sponsor" @bind="creating.CompanyId">
                    <option value="0">@(creating.UserType == "driver" ? "Pick a sponsor" : "No sponsor")</option>
                    @foreach (var c in companies)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            }
            <button type="submit" class="tr-btn" disabled="@busy">Create</button>
            <button type="button" class="tr-btn-outline" @onclick="() => creating = null">Cancel</button>
        </form>
    }

    <MassAccountCreationModal IsOpen="@showMassAccountCreationModal" ActorId="@actorId" IsAdmin="true" OnClose="@CloseMassAccountCreationModal" OnCreated="@Load" />

    <Alerts Notice="@notice" Error="@error" />

    @if (accounts is null)
    {
        <p role="status"><em>Loading...</em></p>
    }
    else if (accounts.Count == 0)
    {
        <p class="tr-muted">No accounts match.</p>
    }
    else
    {
        <div class="tr-table-wrap">
            <table class="tr-table" aria-label="Accounts">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Username</th>
                        <th scope="col">Email</th>
                        <th scope="col">Type</th>
                        <th scope="col">Created</th>
                        <th scope="col">Last sign-in</th>
                        <th scope="col">Status</th>
                        <th scope="col">Manage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in accounts)
                    {
                        <tr class="@(a.Status == "inactive" ? "inactive" : "")">
                            <td>@a.FirstName @a.LastName</td>
                            <td>@a.Username</td>
                            <td>@a.Email</td>
                            <td>@a.UserType</td>
                            <td>@When(a.CreatedAt)</td>
                            <td>@(a.LastLoginAt is null ? "Never" : When(a.LastLoginAt))</td>
                            <td>@a.Status</td>
                            <td class="manage-cell">
                                @if (a.Id.ToString() != id)
                                {
                                    <button type="button" class="manage-account-button" disabled="@busy" @onclick="() => OpenManage(a)">Manage</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (managing is not null)
    {
        <div class="manage-backdrop" @onclick="CloseManage">
            <section class="manage-dialog" role="dialog" aria-modal="true" aria-labelledby="manage-account-title" @onclick:stopPropagation="true">
                <button type="button" class="manage-close" aria-label="Close" @onclick="CloseManage">×</button>
                <p class="manage-eyebrow">ACCOUNT ACTIONS</p>
                <h2 id="manage-account-title">@managing.FirstName @managing.LastName</h2>
                <p class="manage-subtitle">@managing.Username · @managing.UserType · @managing.Status</p>
                @if (error is not null) { <p role="alert" class="tr-alert-error">@error</p> }
                @if (editing is not null && editing.Id == managing.Id)
                {
                    <form class="manage-edit-form" @onsubmit="SaveEdit" @onsubmit:preventDefault="true">
                        <label>First name<input aria-label="First name" @bind="editing.FirstName" /></label>
                        <label>Last name<input aria-label="Last name" @bind="editing.LastName" /></label>
                        <label>Email<input type="email" aria-label="Email" @bind="editing.Email" /></label>
                        <label>Phone<input aria-label="Phone number" @bind="editing.PhoneNumber" /></label>
                        <label>Address<input aria-label="Address" @bind="editing.Address" /></label>
                        @if (managing.UserType != "admin")
                        {
                            <label>Sponsor<select aria-label="Account sponsor" @bind="editing.CompanyId"><option value="0">No sponsor</option>@foreach (var c in companies) { <option value="@c.Id">@c.Name</option> }</select></label>
                        }
                        <div class="manage-actions"><button type="submit" class="tr-btn" disabled="@busy">Save</button><button type="button" class="tr-btn-outline" @onclick="() => editing = null">Cancel</button></div>
                    </form>
                }
                else
                {
                    <div class="manage-action-grid">
                        <button type="button" disabled="@busy" @onclick="() => StartEdit(managing)">Edit</button>
                        <button type="button" disabled="@busy" @onclick="() => Toggle(managing)">@(managing.Status == "active" ? "Deactivate" : "Reactivate")</button>
                        <button type="button" disabled="@busy" @onclick="() => SignOutEverywhere(managing)">Sign out</button>
                        @if (managing.Status == "active")
                        {
                            <button type="button" disabled="@busy" @onclick="() => SendResetLink(managing)">Send reset link</button>
                        }
                        @if (managing.UserType != "admin" && managing.Status == "active")
                        {
                            <form method="post" action="account/view-as/@managing.Id"><button type="submit">View as</button></form>
                        }
                        @if (deleting == managing.Id)
                        {
                            <div class="delete-confirm"><p>Delete @managing.Username permanently? This cannot be undone.</p><button type="button" class="danger-button" disabled="@busy" @onclick="() => Delete(managing)">Delete</button><button type="button" class="tr-btn-outline" @onclick="() => deleting = null">Cancel</button></div>
                        }
                        else
                        {
                            <button type="button" class="danger-outline" disabled="@busy" @onclick="() => deleting = managing.Id">Delete</button>
                        }
                    </div>
                }
                <div class="manage-footer"><button type="button" class="tr-btn-outline" @onclick="CloseManage">Close</button></div>
            </section>
        </div>
    }
</div>

<style>
    .filters input {
        flex: 1;
        min-width: 200px;
    }

    .counts {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin: 0 0 16px;
    }

    .counts div {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 8px 14px;
    }

    .counts dd {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
    }

    .new-account {
        margin: 0;
    }

    .account-actions { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; }
    .manage-cell { min-width: 105px; }
    .manage-account-button { padding: 8px 16px; border: 1px solid #2455a4; border-radius: 7px; background: #2455a4; color: white; font: inherit; font-weight: 600; cursor: pointer; }
    .manage-account-button:hover { background: #1e478b; }
    .manage-backdrop { position: fixed; inset: 0; z-index: 1100; display: flex; align-items: center; justify-content: center; padding: 20px; background: #10182799; backdrop-filter: blur(3px); }
    .manage-dialog { position: relative; width: min(560px, 100%); max-height: min(85vh, 760px); overflow-y: auto; padding: 30px; border: 1px solid #e3e9f0; border-radius: 16px; background: #fff; color: #1f2937; box-shadow: 0 24px 70px #0004; }
    .manage-dialog h2 { margin: 0; font-size: 25px; }
    .manage-close { position: absolute; top: 14px; right: 16px; width: 36px; height: 36px; border: 0; border-radius: 50%; background: #f1f4f8; color: #465366; font-size: 24px; cursor: pointer; }
    .manage-eyebrow { margin: 0 0 6px; color: #2455a4; font-size: 11px; font-weight: 800; letter-spacing: .12em; }
    .manage-subtitle { margin: 6px 0 22px; color: #6b7280; text-transform: capitalize; }
    .manage-action-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .manage-action-grid > button, .manage-action-grid form button { box-sizing: border-box; width: 100%; min-height: 52px; padding: 12px 14px; border: 1px solid #dbe2eb; border-radius: 9px; background: #f8fafc; color: #26364b; font: inherit; font-weight: 600; text-align: left; cursor: pointer; }
    .manage-action-grid > button:hover, .manage-action-grid form button:hover { border-color: #9db4d3; background: #eff4fa; }
    .manage-action-grid form { margin: 0; }
    .manage-action-grid .danger-outline { color: #a32c2c; border-color: #efcaca; background: #fff8f8; }
    .delete-confirm { grid-column: 1 / -1; padding: 14px; border: 1px solid #efcaca; border-radius: 9px; background: #fff8f8; }
    .delete-confirm p { margin: 0 0 12px; font-weight: 600; }
    .danger-button { padding: 9px 12px; border: 0; border-radius: 7px; background: #b42323; color: white; font: inherit; font-weight: 600; cursor: pointer; }
    .delete-confirm .tr-btn-outline { margin-left: 8px; }
    .manage-edit-form { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .manage-edit-form label { display: grid; gap: 5px; color: #526071; font-size: 13px; font-weight: 600; }
    .manage-edit-form input, .manage-edit-form select { box-sizing: border-box; width: 100%; min-height: 40px; padding: 8px 10px; border: 1px solid #cbd3dd; border-radius: 7px; font: inherit; }
    .manage-actions { grid-column: 1 / -1; display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px; }
    .manage-footer { display: flex; justify-content: flex-end; padding-top: 18px; margin-top: 18px; border-top: 1px solid #edf0f4; }
    .mass-account-creation-button { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; padding: 0; border: 0; border-radius: 6px; background: white; color: var(--brand); cursor: pointer; }
    .mass-account-creation-button:hover { background: #edf1f6; }
    .mass-account-creation-button:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
    .edit-form {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    button.link {
        background: none;
        border: none;
        padding: 0;
        font: inherit;
        color: inherit;
        text-decoration: underline;
        cursor: pointer;
    }

    tr.inactive td {
        color: #6b7280;
    }
</style>

@code {
    private List<Account>? accounts;
    private string? search;
    private string type = "";
    private string status = "";
    private string sort = "name";
    private int companyId;
    private Counts? counts;
    private List<Company> companies = [];
    private Edit? editing;
    private int? deleting;
    private Account? managing;
    private NewAccount? creating;
    private bool showMassAccountCreationModal;
    private int actorId;

    private void CloseMassAccountCreationModal() => showMassAccountCreationModal = false;

    private void OpenManage(Account a)
    {
        managing = a;
        editing = null;
        deleting = null;
        error = null;
        notice = null;
    }

    private void CloseManage()
    {
        if (busy) return;
        managing = null;
        editing = null;
        deleting = null;
        error = null;
    }

    protected override async Task OnInitializedAsync()
    {
        await SignedIn();
        actorId = int.Parse(id!);
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            companies = await client.GetFromJsonAsync<List<Company>>("companies") ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            // the sponsor filter just stays empty
        }
        await Load();
    }

    private async Task ShowUnsponsored()
    {
        (type, companyId, status) = ("driver", -1, "active");
        await Load();
    }

    private async Task Load()
    {
        error = null;
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(search)) query.Add("search=" + Uri.EscapeDataString(search.Trim()));
        if (type != "") query.Add("type=" + type);
        if (companyId > 0) query.Add("companyId=" + companyId);
        if (companyId == -1) query.Add("noSponsor=true");
        if (status != "") query.Add("status=" + status);
        if (sort != "name") query.Add("sort=" + sort);
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            accounts = await client.GetFromJsonAsync<List<Account>>("admin/accounts" + (query.Count > 0 ? "?" + string.Join("&", query) : "")) ?? [];
            counts = await client.GetFromJsonAsync<Counts>("admin/accounts/counts");
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            error = "Couldn't load accounts right now. Try again in a moment.";
        }
    }

    private Task Toggle(Account a)
    {
        var next = a.Status == "active" ? "inactive" : "active";
        return Send(c => c.PostAsJsonAsync($"admin/accounts/{a.Id}/status", new { adminId = int.Parse(id!), status = next }), async _ =>
        {
            notice = $"{a.Username} was {(next == "active" ? "reactivated" : "deactivated")}.";
            await Load();
            managing = accounts?.FirstOrDefault(x => x.Id == a.Id);
        });
    }

    private Task SendResetLink(Account a) =>
        Send(c => c.PostAsJsonAsync($"admin/accounts/{a.Id}/reset-link", new { adminId = int.Parse(id!) }),
            async r => notice = await Message(r) ?? $"A reset link was emailed to {a.Username}.");

    private Task SignOutEverywhere(Account a) =>
        Send(c => c.PostAsJsonAsync($"users/{a.Id}/sessions/revoke", new { actorId = int.Parse(id!) }),
            _ => notice = $"{a.Username} will be signed out everywhere within five minutes.", failed: "That didn't work.");

    private async Task Delete(Account a)
    {
        await Send(c => c.DeleteAsync($"admin/accounts/{a.Id}?adminId={id}"), async _ =>
        {
            notice = $"{a.Username} was deleted.";
            await Load();
            managing = null;
        });
        deleting = null;
    }

    private Task Create()
    {
        var c = creating!;
        return Send(client => client.PostAsJsonAsync("admin/accounts", new
        {
            adminId = int.Parse(id!), userType = c.UserType, username = c.Username, firstName = c.FirstName, lastName = c.LastName,
            email = c.Email, companyId = c.UserType == "admin" || c.CompanyId == 0 ? (int?)null : c.CompanyId
        }), async _ =>
        {
            notice = $"{c.Username.Trim()} was created and emailed a link to set a password.";
            creating = null;
            await Load();
        });
    }

    private async Task StartEdit(Account a)
    {
        error = notice = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var d = await client.GetFromJsonAsync<Details>($"users/{a.Id}");
            editing = d is null ? null : new Edit { Id = a.Id, Username = a.Username, FirstName = d.FirstName, LastName = d.LastName, Email = d.Email, PhoneNumber = d.PhoneNumber, Address = d.Address, CompanyId = d.CompanyId ?? 0 };
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            error = "Couldn't load that account right now. Try again in a moment.";
        }
    }

    private Task SaveEdit()
    {
        var e = editing!;
        return Send(c => c.PutAsJsonAsync($"admin/accounts/{e.Id}", new
        {
            adminId = int.Parse(id!), firstName = e.FirstName, lastName = e.LastName, email = e.Email,
            phoneNumber = e.PhoneNumber, address = e.Address, companyId = e.CompanyId == 0 ? (int?)null : e.CompanyId
        }), async _ =>
        {
            notice = $"{e.Username} was updated.";
            editing = null;
            await Load();
            managing = accounts?.FirstOrDefault(x => x.Id == e.Id);
        });
    }

    private static string When(DateTime? utc) => utc is null ? "Unknown" : utc.Value.ToString("yyyy-MM-dd HH:mm") + " UTC";

    private sealed record Account(int Id, string Username, string FirstName, string LastName, string Email, string UserType, string Status, DateTime? CreatedAt, DateTime? LastLoginAt);
    private sealed record Counts(int ActiveDrivers, int ActiveSponsors, int ActiveAdmins, int Inactive, int DriversWithoutSponsor);
    private sealed record Details(string FirstName, string LastName, string Email, string PhoneNumber, string Address, int? CompanyId);

    private sealed class NewAccount
    {
        public string UserType { get; set; } = "driver";
        public string Username { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public int CompanyId { get; set; }
    }

    private sealed class Edit
    {
        public int Id { get; init; }
        public string Username { get; init; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string PhoneNumber { get; set; } = "";
        public string Address { get; set; } = "";
        public int CompanyId { get; set; }
    }
}
