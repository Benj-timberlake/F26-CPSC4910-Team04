@page "/admin/users"
@attribute [Authorize(Roles = "admin")]
@inject IHttpClientFactory HttpClientFactory

<PageTitle>User Management</PageTitle>

<div class="tr-page">

    <h1>User Management</h1>

    @if (users == null)
    {
        <p>Loading users...</p>
    }
    else
    {
        <div class="tr-table-wrap">
            <table class="tr-table">

                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Points</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var user in users)
                    {
                        <tr>
                            <td>@user.Username</td>
                            <td>@user.UserType</td>
                            <td>@user.Email</td>
                            <td>@user.PhoneNumber</td>

                            <td>
                                @(user.UserType == "driver"
                                    ? user.Points
                                    : 0)
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>
    }

</div>

@code {

    private List<AdminUser>? users;

    protected override async Task OnInitializedAsync()
    {
        using var client =
            HttpClientFactory.CreateClient("Backend");

        users =
            await client.GetFromJsonAsync<List<AdminUser>>(
                "admin/users"
            );
    }

    private sealed record AdminUser(
        int Id,
        string Username,
        string Email,
        string UserType,
        string? FirstName,
        string? LastName,
        string PhoneNumber,
        int Points
    );
}