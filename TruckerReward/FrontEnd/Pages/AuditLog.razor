@page "/audit"
@attribute [Authorize(Roles = "sponsor,admin")]
@using System.Security.Claims
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Audit log</PageTitle>

<div class="tr-page">
    <h1>Audit log</h1>

    @if (noCompany)
    {
        <p>You aren't with a company yet, so there's nothing to audit.</p>
    }
    else
    {
        <form class="filters @(admin ? "admin-filters" : "sponsor-filters")" @onsubmit="Load">
            <label class="filter-field">
                <span>Category</span>
                <select aria-label="Category" @bind="category">
                    <option value="">All categories</option>
                    <option value="logins">Sign-ins</option>
                    <option value="passwords">Password changes</option>
                    <option value="points">Point changes</option>
                    <option value="views">Viewed as</option>
                </select>
            </label>
            @if (admin)
            {
                <label class="filter-field">
                    <span>Company</span>
                    <select aria-label="Company" @bind="companyId">
                        <option value="0">All companies</option>
                        @foreach (var c in companies)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </label>
            }
            <label class="filter-field">
                <span>Account</span>
                <select aria-label="Account" @bind="driverId">
                    <option value="0">All accounts</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                </select>
            </label>
            <label class="filter-field">
                <span>Made by</span>
                <select aria-label="Made by" @bind="madeBy">
                    <option value="">All sponsors/admins</option>
                    @foreach (var maker in makers)
                    {
                        <option value="@maker">@maker</option>
                    }
                </select>
            </label>
            <label class="filter-field"><span>From</span><input type="date" @bind="from" /></label>
            <label class="filter-field"><span>To</span><input type="date" @bind="to" /></label>
            <button type="submit" class="tr-btn">Apply</button>
        </form>

        @if (error is not null)
        {
            <p role="alert" class="tr-alert-error">@error</p>
        }
        else if (rows is null)
        {
            <p role="status"><em>Loading...</em></p>
        }
        else if (rows.Count == 0)
        {
            <p class="tr-muted">Nothing in this range.</p>
        }
        else
        {
            <p class="tr-muted">Showing the newest @rows.Count entries. <a class="export" href="@ExportUrl">Download CSV</a></p>
            <div class="tr-table-wrap">
                <table class="tr-table">
                    <thead>
                        <tr>
                            <th>When (UTC)</th>
                            <th>Category</th>
                            <th>Account</th>
                            <th>What happened</th>
                            <th>By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rows)
                        {
                            <tr>
                                <td>@r.At.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@Label(r.Category)</td>
                                <td>@r.Username</td>
                                <td>@r.Detail</td>
                                <td>@(r.By ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

<style>
    .filters {
        display: grid;
        align-items: center;
        grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(140px, 1.2fr) repeat(2, minmax(110px, .85fr)) auto;
        gap: 8px;
        margin-bottom: 16px;
    }

    .filters.sponsor-filters {
        grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(140px, 1.2fr) repeat(2, minmax(110px, .85fr)) auto;
    }

    .filter-field {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
    }

    .filter-field select,
    .filter-field input[type="date"] {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
    }

    @@media (max-width: 1000px) {
        .filters,
        .filters.sponsor-filters {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .filters,
        .filters.sponsor-filters {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string? id;
    private bool admin;
    private bool noCompany;
    private List<Company> companies = [];
    private List<AccountOption> accounts = [];
    private List<string> makers = [];
    private List<Row>? rows;
    private string category = "";
    private int companyId;
    private int driverId;
    private string madeBy = "";
    private DateOnly? from;
    private DateOnly? to;
    private string? error;
    private string applied = "";

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        admin = user.IsInRole("admin");
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.GetAsync($"users/{id}/points/drivers");
            // sponsors without a company get a 403
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                noCompany = true;
                return;
            }
            response.EnsureSuccessStatusCode();
            if (admin)
                companies = await client.GetFromJsonAsync<List<Company>>("companies") ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            error = "Couldn't load the audit log right now. Try again in a moment.";
            return;
        }
        await Load();
    }

    private async Task Load()
    {
        error = null;
        var query = new List<string>();
        if (category != "") query.Add("category=" + category);
        if (companyId != 0) query.Add("companyId=" + companyId);
        if (driverId != 0) query.Add("driverId=" + driverId);
        if (!string.IsNullOrWhiteSpace(madeBy)) query.Add("by=" + Uri.EscapeDataString(madeBy));
        if (from is not null) query.Add("from=" + from.Value.ToString("yyyy-MM-dd"));
        if (to is not null) query.Add("to=" + to.Value.ToString("yyyy-MM-dd"));
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            applied = string.Join("&", query);
            rows = await client.GetFromJsonAsync<List<Row>>($"users/{id}/audit" + (applied == "" ? "" : "?" + applied)) ?? [];
            if (madeBy == "" && driverId == 0)
            {
                makers = rows.Select(row => row.By).Where(name => !string.IsNullOrWhiteSpace(name))
                    .Select(name => name!).Distinct(StringComparer.OrdinalIgnoreCase).Order().ToList();
                accounts = rows.Where(row => row.UserId is not null)
                    .Select(row => new AccountOption(row.UserId!.Value, $"{row.Username} ({row.UserId})"))
                    .DistinctBy(account => account.Id).OrderBy(account => account.Name).ToList();
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            error = "Couldn't load the audit log right now. Try again in a moment.";
        }
    }

    private string ExportUrl => "audit/export" + (applied == "" ? "" : "?" + applied);

    private static string Label(string category) => category switch
    {
        "logins" => "Sign-in",
        "passwords" => "Password",
        "points" => "Points",
        "views" => "Viewed as",
        _ => category
    };

    private sealed record Company(int Id, string Name);
    private sealed record AccountOption(int Id, string Name);
    private sealed record Row(DateTime At, string Category, int? UserId, string Username, string Detail, string? By);
}
