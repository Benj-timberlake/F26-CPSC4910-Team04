@page "/cart"
@attribute [Authorize]
@using System.Security.Claims
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Cart</PageTitle>

<div class="tr-page cart-page">
    <h1>cart</h1>
    @if (loadError is not null)
    {
        <p role="alert" class="tr-alert-error">@loadError</p>
    }
    else if (items is null)
    {
        <p role="status">Loading your cart...</p>
    }
    else
    {
        @if (orderSent)
        {
            <p role="alert" class="tr-alert-success">Order sent successfully!</p>
        }
        @if (actionError is not null)
        {
            <p role="alert" class="tr-alert-error">@actionError</p>
        }
        <div class="tr-table-wrap">
            <table class="tr-table">
                <thead>
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col">Price</th>
                        <th scope="col">Description</th>
                        <th scope="col">Quantity</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Price.ToString("F2")</td>
                            <td>@item.Description</td>
                            <td class="cart-quantity">
                                <button type="button" disabled="@(saving || item.Quantity <= 1)" aria-label="Decrease quantity of @item.Name" @onclick="() => ChangeQuantity(item, -1)">−</button>
                                <span>@item.Quantity</span>
                                <button type="button" disabled="@(saving || item.Quantity >= 999)" aria-label="Increase quantity of @item.Name" @onclick="() => ChangeQuantity(item, 1)">+</button>
                            </td>
                            <td><button type="button" disabled="@saving" @onclick="() => RemoveItem(item)">Remove from cart</button></td>
                        </tr>
                    }
                    @if (items.Count == 0)
                    {
                        <tr><td colspan="5">Your cart is empty.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="cart-total">
            <strong>Cart total: @items.Sum(item => item.Price * item.Quantity).ToString("F2")</strong>
            <button type="button" class="tr-btn" disabled="@(saving || items.Count == 0)" @onclick="SendOrder">Send order</button>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<CartItem>? items;
    private string? loadError;
    private string? actionError;
    private bool saving;
    private int userId;
    private bool orderSent;

    private async Task SendOrder()
    {
        if (saving || items is null || items.Count == 0) return;
        saving = true;
        orderSent = false;
        actionError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            using var response = await client.PostAsync($"users/{userId}/cart/send-order", null);
            response.EnsureSuccessStatusCode();
            items.Clear();
            orderSent = true;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            actionError = "Couldn't confirm your order. Please refresh your cart before trying again.";
        }
        finally { saving = false; }
    }

    private Task ChangeQuantity(CartItem item, int delta) => SaveItem(item, item.Quantity + delta);
    private Task RemoveItem(CartItem item) => SaveItem(item, null);

    private async Task SaveItem(CartItem item, int? quantity)
    {
        if (saving) return;
        saving = true;
        actionError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var path = $"users/{userId}/cart/{item.Id}";
            using var response = quantity.HasValue
                ? await client.PutAsJsonAsync(path + "/quantity", new { Quantity = quantity.Value })
                : await client.DeleteAsync(path);
            response.EnsureSuccessStatusCode();
            if (quantity.HasValue)
                items![items.IndexOf(item)] = item with { Quantity = quantity.Value };
            else
                items!.Remove(item);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            actionError = "Couldn't update your cart. Please refresh before trying again.";
        }
        finally { saving = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        if (user.Identity?.IsAuthenticated != true
            || !int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id))
        {
            loadError = "Please sign in to view your cart.";
            return;
        }

        userId = id;
        using var client = HttpClientFactory.CreateClient("Backend");
        try
        {
            items = await client.GetFromJsonAsync<List<CartItem>>($"users/{id}/cart")
                ?? throw new System.Text.Json.JsonException("Missing cart response.");
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            loadError = "Couldn't load your cart right now. Please try again.";
        }
    }

    private sealed record CartItem(uint Id, string Name, decimal Price, string? Description, int Quantity = 1);
}
