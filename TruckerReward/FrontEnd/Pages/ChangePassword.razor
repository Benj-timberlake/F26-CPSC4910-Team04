@page "/account/password"
@attribute [Authorize]
@inject NavigationManager Nav
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Change password</PageTitle>

<div class="tr-page-narrow">
    <div class="tr-card closable-card">
        <a class="close-button" href="account/profile" aria-label="Close and return to account" title="Close">×</a>
        <h1>Change password</h1>

        @if (error is not null)
        {
            <p role="alert" class="tr-alert-error">@error</p>
        }
        <form class="tr-form" method="post" action="account/change-password">
            <label for="currentPassword">Current password</label>
            <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" />
            <p class="help">Leave empty if you only ever signed in with Google or Microsoft.</p>
            <NewPasswordFields Policy="@policy" />
            <button type="submit" class="tr-btn tr-btn-block">Change password</button>
        </form>
    </div>

</div>

<style>
    .closable-card { position: relative; }
    .close-button {
        position: absolute; top: 12px; right: 12px; width: 34px; height: 34px;
        display: grid; place-items: center; border: 1px solid #b8bec7; border-radius: 9px;
        background: #f1f2f4; color: #666; font-size: 24px; line-height: 1; text-decoration: none;
    }
    .close-button:hover { background: #e5e7eb; color: #444; }
</style>

@code {
    private string? error;
    private string? policy;

    protected override async Task OnInitializedAsync()
    {
        error = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["error"];
        policy = await PasswordPolicyText.Load(HttpClientFactory);
    }
}
