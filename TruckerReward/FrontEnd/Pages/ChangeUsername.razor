@page "/account/username"
@attribute [Authorize]
@inject NavigationManager Nav

<PageTitle>Change username</PageTitle>

<div class="tr-page-narrow">
    <div class="tr-card">
        <h1>Change username</h1>

        @if (error is not null)
        {
            <p role="alert" class="tr-alert-error">@error</p>
        }
        <form class="tr-form" method="post" action="account/change-username">
            <label for="username">New username</label>
            <input id="username" name="username" type="text" required maxlength="255" autocomplete="username" value="@current" />
            <p class="help">You'll use this to log in from now on.</p>

            <label for="currentPassword">Current password</label>
            <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" />
            <p class="help">Leave empty if you only ever signed in with Google or Microsoft.</p>
            <button type="submit" class="tr-btn tr-btn-block">Change username</button>
        </form>
    </div>

    <p class="tr-alt"><a href="dashboard">Back to dashboard</a></p>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string? error;
    private string? current;

    protected override async Task OnInitializedAsync()
    {
        error = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["error"];
        current = (await AuthState).User.Identity?.Name;
    }
}
