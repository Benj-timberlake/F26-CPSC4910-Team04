private bool showClassified = false;
private int selectedSecret = 0;

private sealed class AdminTask
{
    public string Title { get; set; } = "";
    public bool Completed { get; set; }
}

private List<AdminTask> adminTasks = new()
{
    new() { Title = "Review accounts" },
    new() { Title = "Check audit log" }
};

private string newAdminTask = "";

private void AddAdminTask()
{
    if (string.IsNullOrWhiteSpace(newAdminTask))
        return;

    adminTasks.Add(new AdminTask
    {
        Title = newAdminTask.Trim()
    });

    newAdminTask = "";
}

private void ConfirmAdminTask(AdminTask task)
{
    if (!task.Completed)
        return;

    adminTasks.Remove(task);
}


private void HandleAdminTaskKeyDown(
