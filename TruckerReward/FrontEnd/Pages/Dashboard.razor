@code {
    private IJSObjectReference? truckModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Run the secret truck for drivers, sponsors, and admins.
        truckModule = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./js/truckEasterEgg.js");
        await truckModule.InvokeVoidAsync("initializeTruckEasterEgg");

        // Preserve the existing admin-only dancing animation.
        var user = (await AuthState).User;
        if (!user.IsInRole("admin")) return;

        var module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./js/adminDance.js");
        try
        {
            await module.InvokeVoidAsync("showAdminDance");
        }
        finally
        {
            await module.DisposeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (truckModule is null) return;

        try
        {
            await truckModule.InvokeVoidAsync("disposeTruckEasterEgg");
            await truckModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The Blazor circuit may already be disconnected.
        }
    }
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

