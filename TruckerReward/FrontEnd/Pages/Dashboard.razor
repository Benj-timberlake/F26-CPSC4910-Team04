@page "/dashboard"
@attribute [Authorize]
@using System.Security.Claims
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable


<PageTitle>
    @(account?.UserType == "admin"
        ? "Admin Command Center | TruckerReward"
        : "Dashboard | TruckerReward")
</PageTitle>


<div class="tr-page">
    @if (loadError != null)
    {
        <h1>Dashboard</h1>
        <p role="alert" class="tr-alert-error">@loadError</p>
    }
    else if (account == null)
    {
        <h1>Dashboard</h1>
        <p role="status"><em>Loading your account...</em></p>
    }
    else
    {
        
        @if (account.UserType == "admin")
        {
            <h1 class="admin-command-title">Admin Command Center</h1>
            <p class="admin-command-subtitle">
                Manage your platform. Keep the wheels turning.
            </p>
        }
        else
        {
            <h1>My TruckerReward Dashboard</h1>
        }

        @if (account.UserType == "driver" && System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["cdlUpload"] == "failed")
        {
            <p role="alert" class="tr-alert-error">Your account was created, but your CDL upload failed. Please retry below.</p>
            <CdlLicenseUpload Id="retry-cdl-license" />
        }
        @if (account.UserType == "sponsor")
        {
            <p><a class="tr-btn" href="catalog">Catalog</a> <a class="tr-btn" href="sponsor/orders">Order</a> <button type="button" class="tr-btn" @onclick="OpenMonthlyPoints">Montly Points</button></p>
        }

        else if (account.UserType == "driver")
        {
            <p><a class="tr-btn" href="pastorders">Past Orders</a></p>
        }

        @if (notice is not null)
        {
            <p role="status" class="tr-alert-success">@notice</p>
        }

        @if (account.UserType == "admin")
        {
            <div class="admin-command-center">

                <!-- QUICK ACTIONS -->
                <section class="admin-command-panel">
                    <div class="admin-panel-heading">
                        <span class="admin-panel-symbol">⚡</span>
                        <h2>Quick Actions</h2>
                    </div>

                    <div class="admin-quick-grid">
                        <a href="admin/accounts" class="admin-action-card">
                            <span class="admin-action-icon">👥</span>
                            <strong>Manage Accounts</strong>
                            <small>Users and profiles</small>
                        </a>

                        <a href="manage-points" class="admin-action-card">
                            <span class="admin-action-icon">🏅</span>
                            <strong>Driver Points</strong>
                            <small>Manage rewards</small>
                        </a>

                        <a href="admin/banner" class="admin-action-card">
                            <span class="admin-action-icon">📢</span>
                            <strong>Edit Banners</strong>
                            <small>Site announcements</small>
                        </a>

                        <a href="admin/security" class="admin-action-card">
                            <span class="admin-action-icon">🛡️</span>
                            <strong>Security</strong>
                            <small>Protect the platform</small>
                        </a>

                        <a href="audit" class="admin-action-card">
                            <span class="admin-action-icon">📋</span>
                            <strong>Audit Logs</strong>
                            <small>Review site activity</small>
                        </a>

                        <button type="button"
                                class="admin-action-card admin-secret-action"
                                @onclick="() => showClassified = !showClassified"
                                aria-expanded="@showClassified"
                                aria-controls="classified-archive">
                            <span class="admin-action-icon">🥚</span>
                            <strong>Classified</strong>
                            <small>Authorized personnel only</small>
                        </button>
                    </div>
                </section>

                <!-- CLASSIFIED FILES -->
                @if (showClassified)
                {
                    <section id="classified-archive"
                            class="admin-command-panel classified-panel">
                        <div class="admin-panel-heading">
                            <span class="admin-panel-symbol">🔒</span>
                            <h2>Secret Archives</h2>
                        </div>

                        <p class="admin-panel-description">
                            The following incidents have been documented.
                            Their origins remain unexplained.
                        </p>

                        <div class="classified-files">
                            <button type="button" @onclick="() => selectedSecret = 1">
                                📁 FILE 001 — THE GHOST TRUCK
                            </button>
                            <button type="button" @onclick="() => selectedSecret = 2">
                                📁 FILE 002 — THE DANCING ADMIN
                            </button>
                            <button type="button" @onclick="() => selectedSecret = 3">
                                🔒 FILE 003 — ???
                            </button>
                        </div>

                        @if (selectedSecret == 1)
                        {
                            <div class="classified-report">
                                <strong>FILE 001 — THE GHOST TRUCK</strong>
                                <p>
                                    Some say it only appears when you stop moving.
                                    Patience is your only clue.
                                </p>
                            </div>
                        }
                        else if (selectedSecret == 2)
                        {
                            <div class="classified-report">
                                <strong>FILE 002 — THE DANCING ADMIN</strong>
                                <p>
                                    Classified footage suggests that certain
                                    administrators have unusual dance moves.
                                </p>
                            </div>
                        }
                        else if (selectedSecret == 3)
                        {
                            <div class="classified-report">
                                <strong>FILE 003 — REDACTED</strong>
                                <p>
                                    This file has been sealed by the Department
                                    of Extremely Suspicious Trucking Activity.
                                </p>
                            </div>
                        }
                    </section>
                }

                <!-- SECOND ROW -->
                <div class="admin-bottom-grid">

                    <!-- RECENT ACTIVITY -->
                    <section class="admin-command-panel">
                        <div class="admin-panel-heading">
                            <span class="admin-panel-symbol">📈</span>
                            <h2>Recent Activity</h2>
                        </div>

                        <p class="admin-panel-description">
                            Monitor account changes, driver point updates,
                            and administrative activity.
                        </p>

                        <div class="admin-empty-content">
                            <span>📋</span>
                            <p>Review the latest recorded activity.</p>
                        </div>

                        <a href="audit" class="admin-secondary-button">
                            View Audit Log →
                        </a>
                    </section>

                    <!-- ADMIN TASKS -->
                    <section class="admin-command-panel">
                        <div class="admin-panel-heading">
                            <span class="admin-panel-symbol">✅</span>
                            <h2>Admin Tasks</h2>
                        </div>

                        <p class="admin-panel-description">
                            Keep track of what needs to get done.
                        </p>

                        
<div class="admin-task-list">
    @foreach (var task in adminTasks)
    {
        <div class="admin-task-item" @key="task">

            <label class="admin-task-row">
                <input type="checkbox"
                       @bind="task.Completed" />

                <span class="@(task.Completed ? "task-complete" : "")">
                    @task.Title
                </span>
            </label>

            @if (task.Completed)
            {
                <div class="admin-task-confirmation">
                    <span>Mark this task as finished?</span>

                    <div class="admin-task-buttons">
                        <button type="button"
                                class="admin-confirm-button"
                                @onclick="() => ConfirmAdminTask(task)">
                            Confirm Completion
                        </button>

                        <button type="button"
                                class="admin-cancel-button"
                                @onclick="() => task.Completed = false">
                            Cancel
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>


                        <div class="admin-add-task">
                            <input @bind="newAdminTask"
                                @bind:event="oninput"
                                @onkeydown="HandleAdminTaskKeyDown"
                                maxlength="100"
                                placeholder="Add an admin task..." />
                            <button type="button" @onclick="AddAdminTask">
                                Add
                            </button>
                        </div>
                    </section>

                </div>
            </div>
        }

        <div class="tr-cards">
            @if (account.UserType == "sponsor")
            {
                <section class="tr-card points">
                    <h2>Budget</h2>
                    <p class="balance">@FrontEnd.Shared.RewardPoints.Format(account.Points)</p>
                    <p class="hint">Available points. Your balance resets to your company's monthly budget on the first of each month.</p>
                </section>
            }

            @if ((account.UserType == "sponsor" || account.UserType == "driver") &&
                (account.CompanyId is null || account.UserType == "driver"))
            {
                <section class="tr-card">
                    <div class="company-card-heading">
                        <h2>Company</h2>
                        @if (!string.IsNullOrWhiteSpace(account.PendingCompanyName))
                        {
                            <button type="button" class="cancel-application-button" @onclick="OpenCancelApplication">Cancel</button>
                        }
                    </div>
                    @if (account.UserType == "driver" && account.CompanyId is not null)
                    {
                        <ul class="driver-company-list">
                            @foreach (var company in account.Companies ?? [])
                            {
                                <li>
                                    <span>@company.Name</span>
                                    @if (company.CurrentCompanyViewed)
                                    {
                                        <span class="current-company-badge">Currently viewing</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="tr-btn" disabled="@(switchingCompanyId is not null)" @onclick="() => SwitchCompany(company.Id)">
                                            @(switchingCompanyId == company.Id ? "Switching..." : "Switch here")
                                        </button>
                                    }
                                </li>
                            }
                        </ul>
                        @if (companySwitchError is not null)
                        {
                            <p role="alert" class="tr-alert-error">@companySwitchError</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(account.PendingCompanyName))
                        {
                            <p class="pending-company-name">@account.PendingCompanyName <span class="pending-badge">Pending...</span></p>
                        }
                        <button type="button" class="tr-btn" @onclick="ShowCompanyModal">Apply To Another Company</button>
                    }
                    else if (!string.IsNullOrWhiteSpace(account.PendingCompanyName))
                    {
                        <p class="pending-company-name">@account.PendingCompanyName <span class="pending-badge">Pending...</span></p>
                        <p class="pending-help">Your application is waiting for review.</p>
                        @if (account.UserType == "driver")
                        {
                            <button type="button" class="tr-btn" @onclick="ShowCompanyModal">Apply To Another Company</button>
                        }
                    }
                    else
                    {
                        <p>You are not currently associated with a company.</p>
                        <button type="button" class="tr-btn" @onclick="ShowCompanyModal">Apply To Company</button>
                    }
                </section>
            }

            @if (account.UserType == "driver" && account.CompanyId is not null)
            {
                <section class="tr-card points">
                    <h2>Points</h2>
                    <p class="balance">@FrontEnd.Shared.RewardPoints.Format(account.Points)</p>
                    <p class="hint">Earned for good driving. Spend them in your sponsor's <a href="products">product catalog</a>.</p>
                    @if (account.NextMonthlyReward is DateTime nextReward)
                    {
                        <p class="hint">Next monthly reward: <strong>@nextReward.ToString("MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</strong> (Eastern time).</p>
                        <p class="hint">You'll receive @FrontEnd.Shared.RewardPoints.Format(account.MonthlyDriverPoints) points from @account.CompanyName.</p>
                    }
                    else
                    {
                        <p class="hint">No monthly points reward is currently scheduled.</p>
                    }
                </section>
            }

            @if (account.UserType == "driver")
            {
                <FrontEnd.Shared.WishlistGoal UserId="@account.Id" Points="@account.Points" />
            }
        </div>

        @if (account.UserType == "sponsor")
        {
            <section class="tr-card drivers-card @(driversCollapsed ? "drivers-card-collapsed" : "")">
                <div class="drivers-heading">
                    <h2>Drivers</h2>
                    <div class="drivers-heading-actions">
                    @if (account.CompanyId is not null)
                    {
                        <button type="button" class="drivers-filter" title="Filter drivers" aria-label="Filter drivers" @onclick="OpenDriverFilters">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 4h18l-7 8v7l-4 2v-9Z" />
                            </svg>
                        </button>
                    }
                    <button type="button" class="drivers-filter" title="Mass Account Creation" aria-label="Open mass account creation" @onclick="() => showMassAccountCreationModal = true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 5v14" />
                            <path d="M5 12h14" />
                        </svg>
                    </button>
                    <a href="applications" class="drivers-leaderboard" title="Applications" aria-label="Open driver applications">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="14" rx="2" />
                            <path d="m3 7 9 6 9-6" />
                        </svg>
                    </a>
                    <a href="leaderboard" class="drivers-leaderboard" title="Leaderboard" aria-label="Open driver leaderboard">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="8" r="5" />
                            <path d="m8.5 12-1.5 9 5-3 5 3-1.5-9" />
                        </svg>
                    </a>
                    <button type="button" class="drivers-toggle" @onclick="() => driversCollapsed = !driversCollapsed"
                            aria-expanded="@(!driversCollapsed)" aria-controls="dashboard-driver-table"
                            aria-label="@(driversCollapsed ? "Show drivers table" : "Hide drivers table")"
                            title="@(driversCollapsed ? "Show drivers table" : "Hide drivers table")">
                        <span aria-hidden="true" class="@(driversCollapsed ? "collapsed" : "")">^</span>
                    </button>
                    </div>
                </div>
                <div id="dashboard-driver-table" hidden="@driversCollapsed">
                @if (account.CompanyId is null)
                {
                    <p>Join a company to see its associated drivers.</p>
                }
                else
                {
                    <FrontEnd.Pages.ManagePoints @ref="driverManagement" Embedded="true" PointsChanged="RefreshSponsorBudget" />
                }
                </div>
            </section>
        }

        @if (showMonthlyPointsModal && account.UserType == "sponsor")
        {
            <div class="company-backdrop" @onclick="() => showMonthlyPointsModal = false">
                <section class="company-dialog" role="dialog" aria-modal="true" aria-labelledby="monthly-points-title" @onclick:stopPropagation="true">
                    <button type="button" class="company-close-button" aria-label="Close" title="Close" @onclick="() => showMonthlyPointsModal = false">×</button>
                    <h2 id="monthly-points-title">Montly Points</h2>
                    <p>Available points: @FrontEnd.Shared.RewardPoints.Format(account.Points)</p>
                    <p>Your balance resets to your company's monthly budget on the first of each month.</p>
                    <p>Each active driver receives this amount on the first of each month (Eastern time), starting next month. Enter 0 to disable awards.</p>
                    @if (monthlyPointsError is not null)
                    {
                        <p role="alert" class="tr-alert-error">@monthlyPointsError</p>
                    }
                    <form @onsubmit="SaveMonthlyPoints" @onsubmit:preventDefault="true">
                        <label class="extra-info-label" for="monthly-points-input">Monthly points</label>
                        <input id="monthly-points-input" class="extra-info-input" type="number" min="0" max="1000000" step="1" required @bind="monthlyPoints" />
                        <div class="monthly-points-actions">
                            <button type="submit" class="tr-btn" disabled="@savingMonthlyPoints">@(savingMonthlyPoints ? "Saving..." : "Confirm")</button>
                        </div>
                    </form>
                </section>
            </div>
        }

        <MassAccountCreationModal IsOpen="@showMassAccountCreationModal" ActorId="@account.Id" IsAdmin="@(account.UserType == "admin")" OnClose="@CloseMassAccountCreationModal" />

        @if (showCompanyModal)
        {
            <div class="company-backdrop" @onclick="CloseCompanyModal">
                <section class="company-dialog" role="dialog" aria-modal="true" aria-labelledby="company-title" @onclick:stopPropagation="true">
                    <button type="button" class="company-close-button" aria-label="Close" title="Close" @onclick="CloseCompanyModal">×</button>
                    <h2 id="company-title">Apply To Company</h2>
                    <p>Select a company:</p>
                    @if (companyLoadError is not null)
                    {
                        <p role="alert" class="tr-alert-error">@companyLoadError</p>
                    }
                    else if (companies is { Count: 0 })
                    {
                        <p>No companies are available.</p>
                    }
                    else
                    {
                        <fieldset class="company-options">
                            <legend class="visually-hidden">Available companies</legend>
                            @foreach (var company in companies ?? [])
                            {
                                <div class="company-option-group">
                                    <button type="button" role="radio" aria-checked="@(selectedCompanyId == company.Id)"
                                            class="company-option @(selectedCompanyId == company.Id ? "selected" : "")"
                                            @onclick="() => SelectCompany(company.Id)">
                                        <span class="company-option-name">@company.Name</span>
                                        <span class="company-option-description">@(string.IsNullOrWhiteSpace(company.Description) ? "No description available." : company.Description)</span>
                                    </button>
                                    @if (selectedCompanyId == company.Id)
                                    {
                                        <div class="selected-company-application">
                                            <CdlLicenseUpload Id="application-cdl-license" />
                                            <label class="extra-info-label" for="application-extra-info">Extra Info <span>(optional)</span></label>
                                            <textarea id="application-extra-info" class="extra-info-input" @bind="applicantExtraInfo" rows="4" maxlength="4000"></textarea>
                                            @if (applicationError is not null)
                                            {
                                                <p role="alert" class="tr-alert-error">@applicationError</p>
                                            }
                                            <button type="button" class="tr-btn" disabled="@isSubmitting" @onclick="SubmitApplication">
                                                @(isSubmitting ? "Submitting..." : "Apply")
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </fieldset>
                    }
                </section>
            </div>
        }

        @if (showCancelApplicationModal)
        {
            <div class="company-backdrop" @onclick="CloseCancelApplication">
                <section class="company-dialog" role="dialog" aria-modal="true" aria-labelledby="cancel-application-title" @onclick:stopPropagation="true">
                    <button type="button" class="company-close-button" aria-label="Close" title="Close" @onclick="CloseCancelApplication">×</button>
                    <h2 id="cancel-application-title">Cancel company application</h2>
                    <p>Cancel your application to @account.PendingCompanyName?</p>
                    <form @onsubmit="CancelPendingApplication" @onsubmit:preventDefault="true">
                        <label class="extra-info-label" for="cancel-application-reason">Response reason <span>(required)</span></label>
                        <textarea id="cancel-application-reason" class="extra-info-input" @bind="cancellationReason" rows="4" maxlength="4000" required></textarea>
                        @if (cancellationError is not null)
                        {
                            <p role="alert" class="tr-alert-error">@cancellationError</p>
                        }
                        <button type="submit" class="cancel-submit-button" disabled="@isCancelling">
                            @(isCancelling ? "Canceling..." : "Cancel Application")
                        </button>
                    </form>
                </section>
            </div>
        }
    }
</div>

<style>
    .drivers-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
    .drivers-card.drivers-card-collapsed { padding: 10px 16px; }
    .drivers-card-collapsed .drivers-heading { margin-bottom: 0; gap: 24px; }
    .drivers-heading h2 { margin: 0; }
    .drivers-heading-actions { display: flex; align-items: center; gap: 8px; }
    .drivers-filter { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; padding: 0; border: 0; border-radius: 6px; background: white; color: var(--brand); cursor: pointer; }
    .drivers-filter:hover { background: #edf1f6; }
    .drivers-filter:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
    .drivers-toggle { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; padding: 0; border: 0; border-radius: 6px; background: white; color: var(--brand); font-size: 24px; font-weight: 700; cursor: pointer; }
    .drivers-toggle:hover { background: #edf1f6; }
    .drivers-toggle:focus-visible { outline: 2px solid #2455a4; outline-offset: 2px; }
    .drivers-toggle span { display: inline-block; }
    .drivers-toggle span.collapsed { transform: rotate(180deg); }
    .drivers-leaderboard { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 6px; color: var(--brand); }
    .drivers-leaderboard:hover { background: #edf1f6; }
    .drivers-leaderboard:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
    .tr-table .driver-view-action { width: 1%; text-align: right; white-space: nowrap; }
    .driver-view-action form { margin: 0; }
    .driver-view-eye { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; padding: 6px; border: 0; border-radius: 6px; background: transparent; color: var(--brand); cursor: pointer; }
    .driver-view-eye:hover { background: #edf1f6; }
    .driver-view-eye:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
    .points {
        background: var(--brand);
        border-color: var(--brand);
        color: white;
    }

    .points a {
        color: white;
    }

    .balance {
        font-size: 44px;
        font-weight: 700;
        line-height: 1.1;
        margin: 0;
    }

    .hint {
        margin: 8px 0 0;
        opacity: 0.9;
    }

    .pending-company-name { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 18px; font-weight: 600; margin: 0; }
    .pending-help { color: #725a2b; margin: 8px 0 0; }
    .pending-badge { display: inline-block; padding: 4px 9px; border-radius: 20px; background: #fbf0cf; color: #8a641e; font-size: 12px; font-weight: 700; vertical-align: middle; }
    .company-card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
    .company-card-heading h2 { margin: 0 0 12px; }
    .driver-company-list { list-style: none; padding: 0; margin: 0 0 14px; }
    .driver-company-list li { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid #e3e7ee; }
    .current-company-badge { color: #176b3a; font-size: 13px; font-weight: 700; }
    .cancel-application-button, .cancel-submit-button { border: 1px solid #b42318; border-radius: 6px; background: #b42318; color: white; padding: 6px 11px; font-size: 13px; font-weight: 600; cursor: pointer; }
    .cancel-submit-button { display: block; margin-left: auto; padding: 9px 14px; }
    .cancel-application-button:disabled, .cancel-submit-button:disabled { opacity: .65; cursor: wait; }

    .company-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1050;
        background: #0009;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .company-dialog {
        position: relative;
        background: white;
        color: #222;
        border-radius: 12px;
        padding: 24px;
        width: 100%;
        max-width: 520px;
        max-height: 90vh;
        overflow: auto;
        box-shadow: 0 12px 40px #0005;
    }

    .company-close-button {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border: 1px solid #b8bec7;
        border-radius: 9px;
        background: #f1f2f4;
        color: #666;
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
    }

    .company-close-button:hover { background: #e5e7eb; color: #444; }
    .monthly-points-actions { display: flex; justify-content: flex-end; margin-top: 20px; }

    .company-options {
        display: grid;
        gap: 10px;
        margin: 0 0 20px;
        border: 0;
        padding: 0;
    }

    .company-option-group { display: grid; gap: 0; }

    .company-option {
        display: grid;
        gap: 5px;
        width: 100%;
        padding: 12px 14px;
        text-align: left;
        color: #222;
        background: white;
