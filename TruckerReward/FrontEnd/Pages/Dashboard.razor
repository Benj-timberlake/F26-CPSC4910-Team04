@page "/dashboard"
@attribute [Authorize]
@using System.Security.Claims
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<PageTitle>Dashboard</PageTitle>

<div class="tr-page">
    @if (loadError != null)
    {
        <h1>Dashboard</h1>
        <p role="alert" class="tr-alert-error">@loadError</p>
    }
    else if (account == null || activity == null)
    {
        <h1>Dashboard</h1>
        <p role="status"><em>Loading your account...</em></p>
    }
    else
    {
        <h1>My TruckerReward Dashboard</h1>
        <p><a class="tr-btn" href="pastorders">Past Orders</a></p>
        @if (notice is not null)
        {
            <p role="status" class="tr-alert-success">@notice</p>
        }

        <div class="tr-cards">
            @if (account.UserType == "sponsor" && account.CompanyId is null)
            {
                <section class="tr-card">
                    <h2>Company</h2>
                    <p>You are not currently associated with a company.</p>
                    <button type="button" class="tr-btn" @onclick="ShowCompanyModal">Apply To Company</button>
                </section>
            }

            @if (account.UserType == "driver")
            {
                <section class="tr-card points">
                    <h2>Points</h2>
                    <p class="balance">@FrontEnd.Shared.RewardPoints.Format(account.Points)</p>
                    <p class="hint">Earned for good driving. Spend them in your sponsor's <a href="products">product catalog</a>.</p>
                </section>
            }

            <section class="tr-card">
                <div class="account-heading">
                    <h2>@AccountLabel(account.UserType)</h2>
                    <a class="tr-btn account-edit" href="account/profile">Edit</a>
                </div>
                <dl class="tr-kv">
                    @if (account.UserType == "sponsor" && !string.IsNullOrWhiteSpace(account.CompanyName))
                    {
                        <dt>Company</dt>
                        <dd>@account.CompanyName</dd>
                    }
                    <dt>Username</dt>
                    <dd>
                        @account.Username
                        <a href="account/username">Change username</a>
                    </dd>
                    <dt>Name</dt>
                    <dd>@account.FirstName @account.LastName</dd>
                    <dt>Email</dt>
                    <dd>@account.Email</dd>
                    <dt>Phone</dt>
                    <dd>@Shown(account.PhoneNumber)</dd>
                    <dt>Address</dt>
                    <dd>@Shown(account.Address)</dd>
                </dl>
            </section>

            <section class="tr-card">
                <h2>Security</h2>
                @if (activity.FailedSincePreviousLogin > 0)
                {
                    <p role="alert" class="tr-alert-warning">
                        @activity.FailedSincePreviousLogin failed sign-in @(activity.FailedSincePreviousLogin == 1 ? "attempt" : "attempts")
                        on your account since your previous sign-in. If that wasn't you, change your password.
                    </p>
                }
                <dl class="tr-kv">
                    <dt>This sign-in</dt>
                    <dd>@When(activity.LastLoginAt)@Ip(activity.LastLoginIp)</dd>
                    <dt>Previous sign-in</dt>
                    <dd>@(activity.PreviousLoginAt is null ? "This is your first sign-in." : When(activity.PreviousLoginAt))</dd>
                    <dt>Password</dt>
                    <dd>
                        @(activity.PasswordChangedAt is null ? "Not changed since you signed up." : "Changed " + When(activity.PasswordChangedAt))
                        <a href="account/password">Change password</a>
                    </dd>
                </dl>

                @if (activity.Recent.Count > 0)
                {
                    <details>
                        <summary>Recent attempts</summary>
                        <table class="tr-table">
                            <thead>
                                <tr>
                                    <th>When</th>
                                    <th>Result</th>
                                    <th>IP</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in activity.Recent)
                                {
                                    <tr class="@(a.Succeeded ? "" : "failed")">
                                        <td>@When(a.AttemptedAt)</td>
                                        <td>@(a.Succeeded ? "Signed in" : "Failed")</td>
                                        <td>@(a.IpAddress ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </details>
                }
            </section>
        </div>

        @if (showCompanyModal)
        {
            <div class="company-backdrop" @onclick="CloseCompanyModal">
                <section class="company-dialog" role="dialog" aria-modal="true" aria-labelledby="company-title" @onclick:stopPropagation="true">
                    <h2 id="company-title">Apply To Company</h2>
                    <p>Select a company:</p>
                    @if (companyLoadError is not null)
                    {
                        <p role="alert" class="tr-alert-error">@companyLoadError</p>
                    }
                    else if (companies is { Count: 0 })
                    {
                        <p>No companies are available.</p>
                    }
                    else
                    {
                        <fieldset class="company-options">
                            <legend class="visually-hidden">Available companies</legend>
                            @foreach (var company in companies ?? [])
                            {
                                <button type="button" role="radio" aria-checked="@(selectedCompanyId == company.Id)"
                                        class="company-option @(selectedCompanyId == company.Id ? "selected" : "")"
                                        @onclick="() => selectedCompanyId = company.Id">
                                    <span class="company-option-name">@company.Name</span>
                                    <span class="company-option-description">@(string.IsNullOrWhiteSpace(company.Description) ? "No description available." : company.Description)</span>
                                </button>
                            }
                        </fieldset>
                    }
                    <div class="company-actions">
                        <button type="button" class="tr-btn-outline" @onclick="CloseCompanyModal">Cancel</button>
                        <button type="button" class="tr-btn" disabled="@(selectedCompanyId is null || companyLoadError is not null || companies is not { Count: > 0 })">Apply (not functional)</button>
                    </div>
                </section>
            </div>
        }
    }
</div>

<style>
    .points {
        background: var(--brand);
        border-color: var(--brand);
        color: white;
    }

    .points a {
        color: white;
    }

    .balance {
        font-size: 44px;
        font-weight: 700;
        line-height: 1.1;
        margin: 0;
    }

    .hint {
        margin: 8px 0 0;
        opacity: 0.9;
    }

    .tr-kv dd a {
        margin-left: 8px;
    }

    .account-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .account-heading h2 {
        margin-bottom: 12px;
    }

    .account-edit {
        margin-bottom: 12px;
    }

    details {
        margin-top: 14px;
    }

    summary {
        cursor: pointer;
        font-weight: 600;
    }

    details .tr-table {
        margin-top: 8px;
    }

    .company-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1050;
        background: #0009;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .company-dialog {
        background: white;
        color: #222;
        border-radius: 12px;
        padding: 24px;
        width: 100%;
        max-width: 520px;
        max-height: 90vh;
        overflow: auto;
        box-shadow: 0 12px 40px #0005;
    }

    .company-options {
        display: grid;
        gap: 10px;
        margin: 0 0 20px;
        border: 0;
        padding: 0;
    }

    .company-option {
        display: grid;
        gap: 5px;
        width: 100%;
        padding: 12px 14px;
        text-align: left;
        color: #222;
        background: white;
        border: 1px solid #b8c0cc;
        border-radius: 8px;
    }

    .company-option.selected {
        border-color: var(--brand);
        box-shadow: 0 0 0 2px var(--brand);
    }

    .company-option-name {
        font-weight: 700;
    }

    .company-option-description {
        color: #555;
        font-weight: 400;
    }

    .company-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Account? account;
    private SecuritySummary? activity;
    private string? loadError;
    private string? notice;
    private List<CompanyOption>? companies;
    private int? selectedCompanyId;
    private bool showCompanyModal;
    private string? companyLoadError;

    protected override async Task OnInitializedAsync()
    {
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["password"] == "changed")
            notice = "Your password has been changed.";
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["username"] == "changed")
            notice = "Your username has been changed.";
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["profile"] == "updated")
            notice = "Your account information has been updated.";

        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        using var client = HttpClientFactory.CreateClient("Backend");
        try
        {
            account = await client.GetFromJsonAsync<Account>($"users/{id}");
            activity = await client.GetFromJsonAsync<SecuritySummary>($"users/{id}/security");
        }
        catch (HttpRequestException)
        {
            loadError = "Couldn't load your account right now. Try again in a moment.";
        }
    }

    private static string AccountLabel(string userType) => userType switch
    {
        "driver" => "Driver account",
        "sponsor" => "Sponsor account",
        "admin" => "Administrator account",
        _ => "Account"
    };

    private async Task ShowCompanyModal()
    {
        selectedCompanyId = null;
        companyLoadError = null;
        if (companies is null)
        {
            try
            {
                using var client = HttpClientFactory.CreateClient("Backend");
                companies = await client.GetFromJsonAsync<List<CompanyOption>>("companies") ?? [];
            }
            catch (HttpRequestException)
            {
                companyLoadError = "Couldn't load companies right now. Try again in a moment.";
            }
        }
        showCompanyModal = true;
    }

    private void CloseCompanyModal() => showCompanyModal = false;

    private static string Shown(string? value) => string.IsNullOrWhiteSpace(value) ? "Not provided" : value;

    private static string Ip(string? ip) => string.IsNullOrEmpty(ip) ? "" : $" from {ip}";

    // stored in utc, shown as an absolute time plus how long ago so it reads at a glance
    private static string When(DateTime? utc)
    {
        if (utc is null) return "—";
        var t = DateTime.SpecifyKind(utc.Value, DateTimeKind.Utc);
        var ago = DateTime.UtcNow - t;
        var rel = ago.TotalSeconds < 60 ? "just now"
            : ago.TotalMinutes < 60 ? $"{(int)ago.TotalMinutes} min ago"
            : ago.TotalHours < 24 ? $"{(int)ago.TotalHours} h ago"
            : ago.TotalDays < 30 ? $"{(int)ago.TotalDays} d ago"
            : "";
        var abs = t.ToString("yyyy-MM-dd HH:mm") + " UTC";
        return rel == "" ? abs : $"{abs} ({rel})";
    }

    private sealed record Account(int Id, string UserType, string Username, string FirstName, string LastName, string Email, string PhoneNumber, string Address, string? CompanyName, int? CompanyId, int Points);
    private sealed record CompanyOption(int Id, string Name, string? Description);
    private sealed record LoginEvent(DateTime AttemptedAt, bool Succeeded, string? IpAddress);
    private sealed record SecuritySummary(DateTime? LastLoginAt, string? LastLoginIp, DateTime? PreviousLoginAt, int FailedSincePreviousLogin, List<LoginEvent> Recent, DateTime? PasswordChangedAt);
}
