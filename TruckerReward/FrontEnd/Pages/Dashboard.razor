@page "/dashboard"
@attribute [Authorize]
@using System.Security.Claims
@using System.Text.Json.Serialization
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Dashboard</PageTitle>

<div class="dashboard">
    <h1>My TruckerReward Dashboard</h1>

    @if (account == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <section>
            <h2>@(account.UserType == "sponsor" ? "Sponsor information" : "Driver information")</h2>
            <p><strong>@account.Username</strong> · User ID: @account.Id</p>
            @if (!string.IsNullOrEmpty(account.CompanyName))
            {
                <p>Company: @account.CompanyName</p>
            }
            <p>Account type: @account.UserType</p>
            <p>Email: @account.Email</p>
            <p>Phone: @account.PhoneNumber</p>
            <p>Address: @account.Address</p>
        </section>
    }
</div>

<style>
    .dashboard {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px;
    }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Account? account;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        using var client = HttpClientFactory.CreateClient("Backend");
        account = await client.GetFromJsonAsync<Account>($"users/{id}");
    }

    private class Account
    {
        public int Id { get; set; }
        public string UserType { get; set; } = "";
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string PhoneNumber { get; set; } = "";
        public string Address { get; set; } = "";
        public string? CompanyName { get; set; }
    }
}
