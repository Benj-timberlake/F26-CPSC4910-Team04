@page "/dashboard"
@attribute [Authorize]
@using System.Security.Claims
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<PageTitle>Dashboard</PageTitle>

<div class="tr-page">
    @if (loadError != null)
    {
        <h1>Dashboard</h1>
        <p role="alert" class="tr-alert-error">@loadError</p>
    }
    else if (account == null || activity == null)
    {
        <h1>Dashboard</h1>
        <p role="status"><em>Loading your account...</em></p>
    }
    else
    {
        <h1>My TruckerReward Dashboard</h1>
        <p><a class="tr-btn" href="pastorders">Past Orders</a></p>
        @if (notice is not null)
        {
            <p role="status" class="tr-alert-success">@notice</p>
        }

        <div class="tr-cards">
            @if ((account.UserType == "sponsor" || account.UserType == "driver") && account.CompanyId is null)
            {
                <section class="tr-card">
                    <div class="company-card-heading">
                        <h2>Company</h2>
                        @if (!string.IsNullOrWhiteSpace(account.PendingCompanyName))
                        {
                            <button type="button" class="cancel-application-button" @onclick="OpenCancelApplication">Cancel</button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(account.PendingCompanyName))
                    {
                        <p class="pending-company-name">@account.PendingCompanyName <span class="pending-badge">Pending...</span></p>
                        <p class="pending-help">Your application is waiting for review.</p>
                    }
                    else
                    {
                        <p>You are not currently associated with a company.</p>
                        <button type="button" class="tr-btn" @onclick="ShowCompanyModal">Apply To Company</button>
                    }
                </section>
            }

            @if (account.UserType == "driver" && account.CompanyId is not null)
            {
                <section class="tr-card points">
                    <h2>Points</h2>
                    <p class="balance">@FrontEnd.Shared.RewardPoints.Format(account.Points)</p>
                    <p class="hint">Earned for good driving. Spend them in your sponsor's <a href="products">product catalog</a>.</p>
                </section>
            }

            <section class="tr-card">
                <div class="account-heading">
                    <h2>@AccountLabel(account.UserType)</h2>
                    <a class="tr-btn account-edit" href="account/profile">Edit</a>
                </div>
                <dl class="tr-kv">
                    @if ((account.UserType == "sponsor" || account.UserType == "driver") &&
                        !string.IsNullOrWhiteSpace(account.CompanyName))
                    {
                        <dt>Company</dt>
                        <dd>@account.CompanyName</dd>
                    }
                    <dt>Username</dt>
                    <dd>@account.Username</dd>
                    <dt>Email</dt>
                    <dd>@account.Email</dd>
                    <dt>Password</dt>
                    <dd>---------------</dd>
                    <dt>Name</dt>
                    <dd>@account.FirstName @account.LastName</dd>
                    <dt>Phone</dt>
                    <dd>@Shown(account.PhoneNumber)</dd>
                    <dt>Address</dt>
                    <dd>@Shown(account.Address)</dd>
                </dl>
            </section>

            <section class="tr-card">
                <h2>Security</h2>
                @if (activity.FailedSincePreviousLogin > 0)
                {
                    <p role="alert" class="tr-alert-warning">
                        @activity.FailedSincePreviousLogin failed sign-in @(activity.FailedSincePreviousLogin == 1 ? "attempt" : "attempts")
                        on your account since your previous sign-in. If that wasn't you, change your password.
                    </p>
                }
                <dl class="tr-kv">
                    <dt>This sign-in</dt>
                    <dd>@When(activity.LastLoginAt)@Ip(activity.LastLoginIp)</dd>
                    <dt>Previous sign-in</dt>
                    <dd>@(activity.PreviousLoginAt is null ? "This is your first sign-in." : When(activity.PreviousLoginAt))</dd>
                    <dt>Password</dt>
                    <dd>@(activity.PasswordChangedAt is null ? "Not changed since you signed up." : "Changed " + When(activity.PasswordChangedAt))</dd>
                </dl>

                @if (activity.Recent.Count > 0)
                {
                    <details>
                        <summary>Recent attempts</summary>
                        <table class="tr-table">
                            <thead>
                                <tr>
                                    <th>When</th>
                                    <th>Result</th>
                                    <th>IP</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in activity.Recent)
                                {
                                    <tr class="@(a.Succeeded ? "" : "failed")">
                                        <td>@When(a.AttemptedAt)</td>
                                        <td>@(a.Succeeded ? "Signed in" : "Failed")</td>
                                        <td>@(a.IpAddress ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </details>
                }
            </section>
        </div>

        @if (showCompanyModal)
        {
            <div class="company-backdrop" @onclick="CloseCompanyModal">
                <section class="company-dialog" role="dialog" aria-modal="true" aria-labelledby="company-title" @onclick:stopPropagation="true">
                    <button type="button" class="company-close-button" aria-label="Close" title="Close" @onclick="CloseCompanyModal">×</button>
                    <h2 id="company-title">Apply To Company</h2>
                    <p>Select a company:</p>
                    @if (companyLoadError is not null)
                    {
                        <p role="alert" class="tr-alert-error">@companyLoadError</p>
                    }
                    else if (companies is { Count: 0 })
                    {
                        <p>No companies are available.</p>
                    }
                    else
                    {
                        <fieldset class="company-options">
                            <legend class="visually-hidden">Available companies</legend>
                            @foreach (var company in companies ?? [])
                            {
                                <div class="company-option-group">
                                    <button type="button" role="radio" aria-checked="@(selectedCompanyId == company.Id)"
                                            class="company-option @(selectedCompanyId == company.Id ? "selected" : "")"
                                            @onclick="() => SelectCompany(company.Id)">
                                        <span class="company-option-name">@company.Name</span>
                                        <span class="company-option-description">@(string.IsNullOrWhiteSpace(company.Description) ? "No description available." : company.Description)</span>
                                    </button>
                                    @if (selectedCompanyId == company.Id)
                                    {
                                        <div class="selected-company-application">
                                            <label class="extra-info-label" for="application-extra-info">Extra Info <span>(optional)</span></label>
                                            <textarea id="application-extra-info" class="extra-info-input" @bind="applicantExtraInfo" rows="4" maxlength="4000"></textarea>
                                            @if (applicationError is not null)
                                            {
                                                <p role="alert" class="tr-alert-error">@applicationError</p>
                                            }
                                            <button type="button" class="tr-btn" disabled="@isSubmitting" @onclick="SubmitApplication">
                                                @(isSubmitting ? "Submitting..." : "Apply")
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </fieldset>
                    }
                </section>
            </div>
        }

        @if (showCancelApplicationModal)
        {
            <div class="company-backdrop" @onclick="CloseCancelApplication">
                <section class="company-dialog" role="dialog" aria-modal="true" aria-labelledby="cancel-application-title" @onclick:stopPropagation="true">
                    <button type="button" class="company-close-button" aria-label="Close" title="Close" @onclick="CloseCancelApplication">×</button>
                    <h2 id="cancel-application-title">Cancel company application</h2>
                    <p>Cancel your application to @account.PendingCompanyName?</p>
                    <form @onsubmit="CancelPendingApplication" @onsubmit:preventDefault="true">
                        <label class="extra-info-label" for="cancel-application-reason">Response reason <span>(required)</span></label>
                        <textarea id="cancel-application-reason" class="extra-info-input" @bind="cancellationReason" rows="4" maxlength="4000" required></textarea>
                        @if (cancellationError is not null)
                        {
                            <p role="alert" class="tr-alert-error">@cancellationError</p>
                        }
                        <button type="submit" class="cancel-submit-button" disabled="@isCancelling">
                            @(isCancelling ? "Canceling..." : "Cancel Application")
                        </button>
                    </form>
                </section>
            </div>
        }
    }
</div>

<style>
    .points {
        background: var(--brand);
        border-color: var(--brand);
        color: white;
    }

    .points a {
        color: white;
    }

    .balance {
        font-size: 44px;
        font-weight: 700;
        line-height: 1.1;
        margin: 0;
    }

    .hint {
        margin: 8px 0 0;
        opacity: 0.9;
    }

    .pending-company-name { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 18px; font-weight: 600; margin: 0; }
    .pending-help { color: #725a2b; margin: 8px 0 0; }
    .pending-badge { display: inline-block; padding: 4px 9px; border-radius: 20px; background: #fbf0cf; color: #8a641e; font-size: 12px; font-weight: 700; vertical-align: middle; }
    .company-card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
    .company-card-heading h2 { margin: 0 0 12px; }
    .cancel-application-button, .cancel-submit-button { border: 1px solid #b42318; border-radius: 6px; background: #b42318; color: white; padding: 6px 11px; font-size: 13px; font-weight: 600; cursor: pointer; }
    .cancel-submit-button { display: block; margin-left: auto; padding: 9px 14px; }
    .cancel-application-button:disabled, .cancel-submit-button:disabled { opacity: .65; cursor: wait; }

    .tr-kv dd a {
        margin-left: 8px;
    }

    .account-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .account-heading h2 {
        margin-bottom: 12px;
    }

    .account-edit {
        margin-bottom: 12px;
    }

    details {
        margin-top: 14px;
    }

    summary {
        cursor: pointer;
        font-weight: 600;
    }

    details .tr-table {
        margin-top: 8px;
    }

    .company-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1050;
        background: #0009;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .company-dialog {
        position: relative;
        background: white;
        color: #222;
        border-radius: 12px;
        padding: 24px;
        width: 100%;
        max-width: 520px;
        max-height: 90vh;
        overflow: auto;
        box-shadow: 0 12px 40px #0005;
    }

    .company-close-button {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border: 1px solid #b8bec7;
        border-radius: 9px;
        background: #f1f2f4;
        color: #666;
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
    }

    .company-close-button:hover { background: #e5e7eb; color: #444; }

    .company-options {
        display: grid;
        gap: 10px;
        margin: 0 0 20px;
        border: 0;
        padding: 0;
    }

    .company-option-group { display: grid; gap: 0; }

    .company-option {
        display: grid;
        gap: 5px;
        width: 100%;
        padding: 12px 14px;
        text-align: left;
        color: #222;
        background: white;
        border: 1px solid #b8c0cc;
        border-radius: 8px;
    }

    .company-option.selected {
        border-color: var(--brand);
        box-shadow: 0 0 0 2px var(--brand);
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
    }

    .selected-company-application {
        padding: 14px;
        border: 1px solid var(--brand);
        border-top: 0;
        border-bottom-left-radius: 8px;
        border-bottom-right-radius: 8px;
        background: #f8faff;
    }

    .company-option-name {
        font-weight: 700;
    }

    .company-option-description {
        color: #555;
        font-weight: 400;
    }

    .extra-info-label { display: block; font-weight: 600; margin: 0 0 6px; }
    .extra-info-label span { color: #687385; font-size: 13px; font-weight: 400; }
    .extra-info-input { display: block; width: 100%; resize: vertical; padding: 10px; border: 1px solid #b8c0cc; border-radius: 8px; margin-bottom: 14px; font: inherit; }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Account? account;
    private SecuritySummary? activity;
    private string? loadError;
    private string? notice;
    private List<CompanyOption>? companies;
    private int? selectedCompanyId;
    private bool showCompanyModal;
    private string? companyLoadError;
    private string? applicantExtraInfo;
    private string? applicationError;
    private bool isSubmitting;
    private bool showCancelApplicationModal;
    private string cancellationReason = "";
    private string? cancellationError;
    private bool isCancelling;

    protected override async Task OnInitializedAsync()
    {
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["password"] == "changed")
            notice = "Your password has been changed.";
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["username"] == "changed")
            notice = "Your username has been changed.";
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["profile"] == "updated")
            notice = "Your account information has been updated.";
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["email"] == "changed")
            notice = "Your email address has been changed.";

        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        using var client = HttpClientFactory.CreateClient("Backend");
        try
        {
            account = await client.GetFromJsonAsync<Account>($"users/{id}");
            activity = await client.GetFromJsonAsync<SecuritySummary>($"users/{id}/security");
        }
        catch (HttpRequestException)
        {
            loadError = "Couldn't load your account right now. Try again in a moment.";
        }
    }

    private static string AccountLabel(string userType) => userType switch
    {
        "driver" => "Driver account",
        "sponsor" => "Sponsor account",
        "admin" => "Administrator account",
        _ => "Account"
    };

    private async Task ShowCompanyModal()
    {
        selectedCompanyId = null;
        applicantExtraInfo = null;
        applicationError = null;
        companyLoadError = null;
        if (companies is null)
        {
            try
            {
                using var client = HttpClientFactory.CreateClient("Backend");
                companies = await client.GetFromJsonAsync<List<CompanyOption>>("companies") ?? [];
            }
            catch (HttpRequestException)
            {
                companyLoadError = "Couldn't load companies right now. Try again in a moment.";
            }
        }
        showCompanyModal = true;
    }

    private void SelectCompany(int companyId)
    {
        selectedCompanyId = companyId;
        applicantExtraInfo = null;
        applicationError = null;
    }

    private async Task SubmitApplication()
    {
        if (selectedCompanyId is null || isSubmitting)
            return;

        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(id))
        {
            applicationError = "Couldn't identify your account. Please sign in again.";
            return;
        }

        isSubmitting = true;
        applicationError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync($"users/{id}/applications",
                new CreateApplicationRequest(selectedCompanyId.Value, applicantExtraInfo));
            if (response.IsSuccessStatusCode)
            {
                var pendingCompanyName = companies?.FirstOrDefault(company => company.Id == selectedCompanyId.Value)?.Name;
                if (account is not null)
                    account = account with { PendingCompanyName = pendingCompanyName };
                showCompanyModal = false;
                notice = "Your company application has been submitted.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                applicationError = "You already have an application on file.";
            }
            else
            {
                applicationError = "Couldn't submit your application. Please try again.";
            }
        }
        catch (HttpRequestException)
        {
            applicationError = "Couldn't submit your application right now. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void CloseCompanyModal() => showCompanyModal = false;

    private void OpenCancelApplication()
    {
        cancellationReason = "";
        cancellationError = null;
        showCancelApplicationModal = true;
    }

    private void CloseCancelApplication()
    {
        if (!isCancelling)
            showCancelApplicationModal = false;
    }

    private async Task CancelPendingApplication()
    {
        if (isCancelling)
            return;
        if (string.IsNullOrWhiteSpace(cancellationReason))
        {
            cancellationError = "Please provide a response reason.";
            return;
        }

        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(id))
        {
            cancellationError = "Couldn't identify your account. Please sign in again.";
            return;
        }

        isCancelling = true;
        cancellationError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync($"users/{id}/applications/cancel",
                new CancelApplicationRequest(cancellationReason.Trim()));
            if (!response.IsSuccessStatusCode)
            {
                cancellationError = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "No active application was found to cancel."
                    : "Couldn't cancel your application. Please try again.";
                return;
            }

            if (account is not null)
                account = account with { PendingCompanyName = null };
            showCancelApplicationModal = false;
            notice = "Your company application was canceled.";
        }
        catch (HttpRequestException)
        {
            cancellationError = "Couldn't cancel your application right now. Please try again.";
        }
        finally
        {
            isCancelling = false;
        }
    }

    private static string Shown(string? value) => string.IsNullOrWhiteSpace(value) ? "Not provided" : value;

    private static string Ip(string? ip) => string.IsNullOrEmpty(ip) ? "" : $" from {ip}";

    // stored in utc, shown as an absolute time plus how long ago so it reads at a glance
    private static string When(DateTime? utc)
    {
        if (utc is null) return "—";
        var t = DateTime.SpecifyKind(utc.Value, DateTimeKind.Utc);
        var ago = DateTime.UtcNow - t;
        var rel = ago.TotalSeconds < 60 ? "just now"
            : ago.TotalMinutes < 60 ? $"{(int)ago.TotalMinutes} min ago"
            : ago.TotalHours < 24 ? $"{(int)ago.TotalHours} h ago"
            : ago.TotalDays < 30 ? $"{(int)ago.TotalDays} d ago"
            : "";
        var abs = t.ToString("yyyy-MM-dd HH:mm") + " UTC";
        return rel == "" ? abs : $"{abs} ({rel})";
    }

    private sealed record Account(int Id, string UserType, string Username, string FirstName, string LastName, string Email, string PhoneNumber, string Address, string? CompanyName, int? CompanyId, int Points, string? PendingCompanyName);
    private sealed record CompanyOption(int Id, string Name, string? Description);
    private sealed record LoginEvent(DateTime AttemptedAt, bool Succeeded, string? IpAddress);
    private sealed record SecuritySummary(DateTime? LastLoginAt, string? LastLoginIp, DateTime? PreviousLoginAt, int FailedSincePreviousLogin, List<LoginEvent> Recent, DateTime? PasswordChangedAt);
    private sealed record CreateApplicationRequest(int CompanyId, string? ApplicantExtraInfo);
    private sealed record CancelApplicationRequest(string Reasoning);
}
