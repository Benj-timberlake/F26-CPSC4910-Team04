    private FrontEnd.Pages.ManagePoints? driverManagement;

    private void OpenDriverFilters()
    {
        driversCollapsed = false;
        driverManagement?.OpenFilters();
    }
    private void CloseMassAccountCreationModal() => showMassAccountCreationModal = false;
    private string? loadError;
    private string? notice;
    private List<CompanyOption>? companies;
    private int? selectedCompanyId;
    private bool showCompanyModal;
    private bool showMonthlyPointsModal;
    private bool showMassAccountCreationModal;
    private long? monthlyPoints;
    private bool savingMonthlyPoints;
    private string? monthlyPointsError;
    private string? companyLoadError;
    private string? applicantExtraInfo;
    private string? applicationError;
    private bool isSubmitting;
    private bool showCancelApplicationModal;
    private string cancellationReason = "";
    private string? cancellationError;
    private bool isCancelling;
    private int? switchingCompanyId;
    private string? companySwitchError;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        using var client = HttpClientFactory.CreateClient("Backend");
        try
        {
            account = await client.GetFromJsonAsync<Account>($"users/{id}");
        }
        catch (HttpRequestException)
        {
            loadError = "Couldn't load your account right now. Try again in a moment.";
        }

    }

    private async Task RefreshSponsorBudget()
    {
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            account = await client.GetFromJsonAsync<Account>($"users/{account!.Id}");
        }
        catch (HttpRequestException)
        {
            notice = "Points saved, but the budget couldn't refresh. Reload to see the latest budget.";
        }
    }

    private async Task OpenMonthlyPoints()
    {
        monthlyPointsError = null;
        try
        {
            var id = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
            using var client = HttpClientFactory.CreateClient("Backend");
            var setting = await client.GetFromJsonAsync<MonthlyPointsSetting>($"users/{id}/points/monthly");
            monthlyPoints = setting?.Points ?? 0;
            showMonthlyPointsModal = true;
        }
        catch (HttpRequestException)
        {
            notice = "Couldn't load monthly points. Make sure you belong to a company and try again.";
        }
    }

    private sealed record MonthlyPointsSetting(int Points);

    private async Task SaveMonthlyPoints()
    {
        if (savingMonthlyPoints) return;
        if (monthlyPoints is null or < 0 or > 1_000_000)
        {
            monthlyPointsError = "Enter 0 to 1,000,000 whole points.";
            return;
        }
        savingMonthlyPoints = true;
        monthlyPointsError = null;
        try
        {
            var id = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync($"users/{id}/points/monthly", new { Points = (int)monthlyPoints.Value });
            if (!response.IsSuccessStatusCode)
            {
                monthlyPointsError = "Couldn't save monthly points. Make sure you belong to a company and try again.";
                return;
            }
            showMonthlyPointsModal = false;
            notice = monthlyPoints == 0 ? "Monthly driver points disabled." : $"Saved: each active driver will receive {monthlyPoints:N0} points on the first of each month (Eastern time), starting next month.";
        }
        catch (HttpRequestException)
        {
            monthlyPointsError = "Couldn't save monthly points. Please try again.";
        }
        finally { savingMonthlyPoints = false; }
    }

    private async Task ShowCompanyModal()
    {
        selectedCompanyId = null;
        applicantExtraInfo = null;
        applicationError = null;
        companyLoadError = null;
        if (companies is null)
        {
            try
            {
                using var client = HttpClientFactory.CreateClient("Backend");
                companies = await client.GetFromJsonAsync<List<CompanyOption>>("companies") ?? [];
            }
            catch (HttpRequestException)
            {
                companyLoadError = "Couldn't load companies right now. Try again in a moment.";
            }
        }
        showCompanyModal = true;
    }

    private async Task SwitchCompany(int companyId)
    {
        if (switchingCompanyId is not null)
            return;

        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(id))
        {
            companySwitchError = "Couldn't identify your account. Please sign in again.";
            return;
        }

        switchingCompanyId = companyId;
        companySwitchError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsync($"users/{id}/companies/{companyId}/switch", null);
            if (!response.IsSuccessStatusCode)
            {
                companySwitchError = "Couldn't switch companies. Please try again.";
                return;
            }

            account = await client.GetFromJsonAsync<Account>($"users/{id}");
            notice = "Your current company has been switched.";
        }
        catch (HttpRequestException)
        {
            companySwitchError = "Couldn't switch companies right now. Please try again.";
        }
        finally
        {
            switchingCompanyId = null;
        }
    }

    private void SelectCompany(int companyId)
    {
        selectedCompanyId = companyId;
        applicantExtraInfo = null;
        applicationError = null;
    }

    private async Task SubmitApplication()
    {
        if (selectedCompanyId is null || isSubmitting)
            return;

        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(id))
        {
            applicationError = "Couldn't identify your account. Please sign in again.";
            return;
        }

        isSubmitting = true;
        applicationError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync($"users/{id}/applications",
                new CreateApplicationRequest(selectedCompanyId.Value, applicantExtraInfo));
            if (response.IsSuccessStatusCode)
            {
                var pendingCompanyName = companies?.FirstOrDefault(company => company.Id == selectedCompanyId.Value)?.Name;
                if (account is not null)
                    account = account with { PendingCompanyName = pendingCompanyName };
                showCompanyModal = false;
                notice = "Your company application has been submitted.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                applicationError = "You already have an application on file.";
            }
            else
            {
                applicationError = "Couldn't submit your application. Please try again.";
            }
        }
        catch (HttpRequestException)
        {
            applicationError = "Couldn't submit your application right now. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void CloseCompanyModal() => showCompanyModal = false;

    private void OpenCancelApplication()
    {
        cancellationReason = "";
        cancellationError = null;
        showCancelApplicationModal = true;
    }

    private void CloseCancelApplication()
    {
        if (!isCancelling)
            showCancelApplicationModal = false;
    }

    private async Task CancelPendingApplication()
    {
        if (isCancelling)
            return;
        if (string.IsNullOrWhiteSpace(cancellationReason))
        {
            cancellationError = "Please provide a response reason.";
            return;
        }

        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(id))
        {
            cancellationError = "Couldn't identify your account. Please sign in again.";
            return;
        }

        isCancelling = true;
        cancellationError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync($"users/{id}/applications/cancel",
                new CancelApplicationRequest(cancellationReason.Trim()));
            if (!response.IsSuccessStatusCode)
            {
                cancellationError = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "No active application was found to cancel."
                    : "Couldn't cancel your application. Please try again.";
                return;
            }

            if (account is not null)
                account = account with { PendingCompanyName = null };
            showCancelApplicationModal = false;
            notice = "Your company application was canceled.";
        }
        catch (HttpRequestException)
        {
            cancellationError = "Couldn't cancel your application right now. Please try again.";
        }
        finally
        {
            isCancelling = false;
        }
    }

    private sealed record Account(int Id, string UserType, string Username, string FirstName, string LastName, string Email, string PhoneNumber, string Address, string? CompanyName, List<string>? CompanyNames, List<CompanyMembership>? Companies, int? CompanyId, long Points, string? PendingCompanyName, decimal? MonthlyBudget, int MonthlyDriverPoints = 0, DateTime? NextMonthlyReward = null);
    private sealed record CompanyMembership(int Id, string Name, bool CurrentCompanyViewed);
    private sealed record CompanyOption(int Id, string Name, string? Description);
    private sealed record CreateApplicationRequest(int CompanyId, string? ApplicantExtraInfo);
    private sealed record CancelApplicationRequest(string Reasoning);
