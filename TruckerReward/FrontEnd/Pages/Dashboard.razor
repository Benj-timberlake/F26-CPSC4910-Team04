@page "/dashboard"
@attribute [Authorize]
@using System.Security.Claims
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<PageTitle>Dashboard</PageTitle>

<div class="tr-page">
    @if (loadError != null)
    {
        <h1>Dashboard</h1>
        <p role="alert" class="tr-alert-error">@loadError</p>
    }
    else if (account == null)
    {
        <h1>Dashboard</h1>
        <p role="status"><em>Loading your account...</em></p>
    }
    else
    {
        
@if (account.UserType == "admin")
{
    <div class="admin-dashboard">

        <!-- Admin Header -->
        <header class="admin-header">
            <div>
                <span class="admin-eyebrow">
                    TRUCKERREWARD / ADMINISTRATION
                </span>

                <h1>Admin Dashboard</h1>

                <p>
                    Welcome back, @account.FirstName.
                    Manage your platform from one place.
                </p>
            </div>

            <div class="admin-header-actions">
                <a href="audit" class="admin-button-secondary">
                    View Audit Log
                </a>

                <a href="admin/accounts" class="admin-button-primary">
                    Manage Accounts
                </a>
            </div>
        </header>

        <!-- Management Overview -->
        <section class="admin-section">
            <div class="admin-section-heading">
                <div>
                    <h2>Platform Overview</h2>
                    <p>Access your core management tools.</p>
                </div>
            </div>

            <div class="admin-stat-grid">

                <a href="admin/accounts" class="admin-stat-card">
                    <div class="admin-stat-top">
                        <span class="admin-stat-icon">👥</span>
                        <span class="admin-card-arrow">↗</span>
                    </div>

                    <h3>Accounts</h3>
                    <p>Manage users and administrative access.</p>
                    <span class="admin-stat-link">
                        Open Accounts →
                    </span>
                </a>

                <a href="manage-points" class="admin-stat-card">
                    <div class="admin-stat-top">
                        <span class="admin-stat-icon">🏆</span>
                        <span class="admin-card-arrow">↗</span>
                    </div>

                    <h3>Driver Points</h3>
                    <p>Review drivers and manage reward points.</p>
                    <span class="admin-stat-link">
                        Manage Points →
                    </span>
                </a>

                <a href="pastorders" class="admin-stat-card">
                    <div class="admin-stat-top">
                        <span class="admin-stat-icon">📦</span>
                        <span class="admin-card-arrow">↗</span>
                    </div>

                    <h3>Past Orders</h3>
                    <p>Access the existing order history page.</p>
                    <span class="admin-stat-link">
                        View Orders →
                    </span>
                </a>

                <a href="admin/security" class="admin-stat-card">
                    <div class="admin-stat-top">
                        <span class="admin-stat-icon">🛡️</span>
                        <span class="admin-card-arrow">↗</span>
                    </div>

                    <h3>Security</h3>
                    <p>Review platform security controls.</p>
                    <span class="admin-stat-link">
                        Open Security →
                    </span>
                </a>

            </div>
        </section>

        <!-- Lower Dashboard -->
        <div class="admin-content-grid">

            <!-- Quick Actions -->
            <section class="admin-panel">
                <div class="admin-panel-header">
                    <div>
                        <h2>Quick Actions</h2>
                        <p>Frequently used admin tools</p>
                    </div>
                </div>

                <div class="admin-action-list">

                    <a href="admin/accounts" class="admin-action">
                        <span class="admin-action-icon">👤</span>
                        <span class="admin-action-text">
                            <strong>Manage Users</strong>
                            <small>View and manage accounts</small>
                        </span>
                        <span class="admin-action-arrow">→</span>
                    </a>

                    <a href="manage-points" class="admin-action">
                        <span class="admin-action-icon">⭐</span>
                        <span class="admin-action-text">
                            <strong>Manage Driver Points</strong>
                            <small>Review and assign rewards</small>
                        </span>
                        <span class="admin-action-arrow">→</span>
                    </a>

                    <a href="admin/banner" class="admin-action">
                        <span class="admin-action-icon">📢</span>
                        <span class="admin-action-text">
                            <strong>Manage Banners</strong>
                            <small>Update site announcements</small>
                        </span>
                        <span class="admin-action-arrow">→</span>
                    </a>

                </div>
            </section>

            <!-- Administration -->
            <section class="admin-panel">
                <div class="admin-panel-header">
                    <div>
                        <h2>Platform Management</h2>
                        <p>Monitoring and administration</p>
                    </div>
                </div>

                <div class="admin-action-list">

                    <a href="audit" class="admin-action">
                        <span class="admin-action-icon">📋</span>
                        <span class="admin-action-text">
                            <strong>Audit Log</strong>
                            <small>Review recorded activity</small>
                        </span>
                        <span class="admin-action-arrow">→</span>
                    </a>

                    <a href="admin/security" class="admin-action">
                        <span class="admin-action-icon">🔐</span>
                        <span class="admin-action-text">
                            <strong>Security Settings</strong>
                            <small>Access security management</small>
                        </span>
                        <span class="admin-action-arrow">→</span>
                    </a>

                    <a href="products" class="admin-action">
                        <span class="admin-action-icon">🛍️</span>
                        <span class="admin-action-text">
                            <strong>Product Catalog</strong>
                            <small>Browse available products</small>
                        </span>
                        <span class="admin-action-arrow">→</span>
                    </a>

                </div>
            </section>

        </div>
    </div>
}
else
{
    <h1>My TruckerReward Dashboard</h1>
}

        
@if (account.UserType == "sponsor")
{
    <p>
        <a class="tr-btn" href="catalog">Catalog</a>
        <a class="tr-btn" href="sponsor/orders">Order</a>
    </p>
}
else if (account.UserType == "driver")
{
    <p>
        <a class="tr-btn" href="pastorders">Past Orders</a>
    </p>
}

        @if (notice is not null)
        {
            <p role="status" class="tr-alert-success">@notice</p>
        }

        <div class="tr-cards">
            @if (account.UserType == "sponsor")
            {
                <section class="tr-card points">
                    <h2>Budget</h2>
                    <p class="balance">@FrontEnd.Shared.RewardPoints.Format(account.Points)</p>
                    <p class="hint">Available points. Your balance resets to your company's monthly budget on the first of each month.</p>
                </section>
            }

            @if ((account.UserType == "sponsor" || account.UserType == "driver") && account.CompanyId is null)
            {
                <section class="tr-card">
                    <div class="company-card-heading">
                        <h2>Company</h2>
                        @if (!string.IsNullOrWhiteSpace(account.PendingCompanyName))
                        {
                            <button type="button" class="cancel-application-button" @onclick="OpenCancelApplication">Cancel</button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(account.PendingCompanyName))
                    {
                        <p class="pending-company-name">@account.PendingCompanyName <span class="pending-badge">Pending...</span></p>
                        <p class="pending-help">Your application is waiting for review.</p>
                    }
                    else
                    {
                        <p>You are not currently associated with a company.</p>
                        <button type="button" class="tr-btn" @onclick="ShowCompanyModal">Apply To Company</button>
                    }
                </section>
            }

            @if (account.UserType == "driver" && account.CompanyId is not null)
            {
                <section class="tr-card points">
                    <h2>Points</h2>
                    <p class="balance">@FrontEnd.Shared.RewardPoints.Format(account.Points)</p>
                    <p class="hint">Earned for good driving. Spend them in your sponsor's <a href="products">product catalog</a>.</p>
                </section>
            }

        </div>

        @if (account.UserType == "sponsor")
        {
            <section class="tr-card">
                <h2>Drivers</h2>
                @if (account.CompanyId is null)
                {
                    <p>Join a company to see its associated drivers.</p>
                }
                else if (driverLoadError is not null)
                {
                    <p role="alert" class="tr-alert-error">@driverLoadError</p>
                }
                else if (drivers is null)
                {
                    <p role="status"><em>Loading drivers...</em></p>
                }
                else if (drivers.Count == 0)
                {
                    <p>No drivers are currently associated with your company.</p>
                }
                else
                {
                    <div class="tr-table-wrap">
                        <table class="tr-table">
                            <thead>
                                <tr>
                                    <th scope="col">Name</th>
                                    <th scope="col">Username</th>
                                    <th scope="col">Email</th>
                                    <th scope="col">Points</th>
                                    <th scope="col">Driver view</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var driver in drivers)
                                {
                                    <tr>
                                        <td>@driver.FirstName @driver.LastName</td>
                                        <td>@driver.Username</td>
                                        <td>@driver.Email</td>
                                        <td>@FrontEnd.Shared.RewardPoints.Format(driver.Points)</td>
                                        <td>
                                            <form method="post" action="@($"account/driver-view/{driver.Id}")">
                                                <button type="submit" class="tr-btn" aria-label="@($"See their view: {driver.Username}")">See their view</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }

        @if (showCompanyModal)
        {
            <div class="company-backdrop" @onclick="CloseCompanyModal">
                <section class="company-dialog" role="dialog" aria-modal="true" aria-labelledby="company-title" @onclick:stopPropagation="true">
                    <button type="button" class="company-close-button" aria-label="Close" title="Close" @onclick="CloseCompanyModal">×</button>
                    <h2 id="company-title">Apply To Company</h2>
                    <p>Select a company:</p>
                    @if (companyLoadError is not null)
                    {
                        <p role="alert" class="tr-alert-error">@companyLoadError</p>
                    }
                    else if (companies is { Count: 0 })
                    {
                        <p>No companies are available.</p>
                    }
                    else
                    {
                        <fieldset class="company-options">
                            <legend class="visually-hidden">Available companies</legend>
                            @foreach (var company in companies ?? [])
                            {
                                <div class="company-option-group">
                                    <button type="button" role="radio" aria-checked="@(selectedCompanyId == company.Id)"
                                            class="company-option @(selectedCompanyId == company.Id ? "selected" : "")"
                                            @onclick="() => SelectCompany(company.Id)">
                                        <span class="company-option-name">@company.Name</span>
                                        <span class="company-option-description">@(string.IsNullOrWhiteSpace(company.Description) ? "No description available." : company.Description)</span>
                                    </button>
                                    @if (selectedCompanyId == company.Id)
                                    {
                                        <div class="selected-company-application">
                                            <label class="extra-info-label" for="application-extra-info">Extra Info <span>(optional)</span></label>
                                            <textarea id="application-extra-info" class="extra-info-input" @bind="applicantExtraInfo" rows="4" maxlength="4000"></textarea>
                                            @if (applicationError is not null)
                                            {
                                                <p role="alert" class="tr-alert-error">@applicationError</p>
                                            }
                                            <button type="button" class="tr-btn" disabled="@isSubmitting" @onclick="SubmitApplication">
                                                @(isSubmitting ? "Submitting..." : "Apply")
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </fieldset>
                    }
                </section>
            </div>
        }

        @if (showCancelApplicationModal)
        {
            <div class="company-backdrop" @onclick="CloseCancelApplication">
                <section class="company-dialog" role="dialog" aria-modal="true" aria-labelledby="cancel-application-title" @onclick:stopPropagation="true">
                    <button type="button" class="company-close-button" aria-label="Close" title="Close" @onclick="CloseCancelApplication">×</button>
                    <h2 id="cancel-application-title">Cancel company application</h2>
                    <p>Cancel your application to @account.PendingCompanyName?</p>
                    <form @onsubmit="CancelPendingApplication" @onsubmit:preventDefault="true">
                        <label class="extra-info-label" for="cancel-application-reason">Response reason <span>(required)</span></label>
                        <textarea id="cancel-application-reason" class="extra-info-input" @bind="cancellationReason" rows="4" maxlength="4000" required></textarea>
                        @if (cancellationError is not null)
                        {
                            <p role="alert" class="tr-alert-error">@cancellationError</p>
                        }
                        <button type="submit" class="cancel-submit-button" disabled="@isCancelling">
                            @(isCancelling ? "Canceling..." : "Cancel Application")
                        </button>
                    </form>
                </section>
            </div>
        }
    }
</div>

<style>
 
/* ===========================================
   ADMIN DASHBOARD - TRUCKERREWARD
   =========================================== */

.admin-dashboard {
    --admin-bg: #0b1120;
    --admin-card: #151e2f;
    --admin-border: #263449;
    --admin-text: #f1f5f9;
    --admin-muted: #94a3b8;
    --admin-accent: #3b82f6;

    background: var(--admin-bg);
    color: var(--admin-text);
    border-radius: 16px;
    padding: 32px;
    min-height: 75vh;
    font-family: Inter, system-ui, sans-serif;
}

/* Header */

.admin-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 38px;
}

.admin-eyebrow {
    color: var(--admin-accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

.admin-header h1 {
    color: var(--admin-text);
    font-size: clamp(28px, 3vw, 38px);
    font-weight: 750;
    margin: 10px 0;
}

.admin-header p {
    color: var(--admin-muted);
    margin: 0;
}

.admin-header-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

/* Buttons */

.admin-button-primary,
.admin-button-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all .2s ease;
}

.admin-button-primary {
    background: #2563eb;
    color: #fff;
}

.admin-button-primary:hover {
    background: #1d4ed8;
    color: #fff;
    transform: translateY(-2px);
}

.admin-button-secondary {
    background: #1e293b;
    border: 1px solid var(--admin-border);
    color: var(--admin-text);
}

.admin-button-secondary:hover {
    background: #334155;
    color: #fff;
}

/* Section Headers */

.admin-section {
    margin-bottom: 30px;
}

.admin-section-heading {
    margin-bottom: 18px;
}

.admin-section-heading h2,
.admin-panel-header h2 {
    color: var(--admin-text);
    font-size: 19px;
    margin: 0 0 7px;
}

.admin-section-heading p,
.admin-panel-header p {
    color: var(--admin-muted);
    font-size: 13px;
    margin: 0;
}

/* Overview Cards */

.admin-stat-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

.admin-stat-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 205px;
    background: var(--admin-card);
    border: 1px solid var(--admin-border);
    border-radius: 14px;
    padding: 22px;
    color: var(--admin-text);
    text-decoration: none;
    transition: all .2s ease;
}

.admin-stat-card:hover {
    border-color: var(--admin-accent);
    background: #1b2940;
    transform: translateY(-4px);
    box-shadow: 0 12px 24px #0003;
    color: var(--admin-text);
}

.admin-stat-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
}

.admin-stat-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 11px;
    background: #233555;
    font-size: 23px;
}

.admin-card-arrow {
    color: var(--admin-muted);
    font-size: 21px;
}

.admin-stat-card h3 {
    color: var(--admin-text);
    margin: 0 0 8px;
    font-size: 19px;
    font-weight: 650;
}

.admin-stat-card p {
    color: var(--admin-muted);
    font-size: 13px;
    line-height: 1.5;
    margin: 0 0 18px;
}

.admin-stat-link {
    color: #60a5fa;
    font-size: 13px;
    font-weight: 600;
    margin-top: auto;
}

/* Lower Panels */

.admin-content-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.admin-panel {
    min-width: 0;
    background: var(--admin-card);
    border: 1px solid var(--admin-border);
    border-radius: 14px;
    padding: 24px;
}

.admin-panel-header {
    margin-bottom: 24px;
}

.admin-action-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.admin-action {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px;
    border: 1px solid transparent;
    border-radius: 10px;
    color: var(--admin-text);
    text-decoration: none;
    transition: all .2s ease;
}

.admin-action:hover {
    background: #1e2d46;
    border-color: var(--admin-border);
    color: var(--admin-text);
}

.admin-action-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 10px;
    background: #233555;
    font-size: 21px;
}

.admin-action-text {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 5px;
}

.admin-action-text strong {
    color: var(--admin-text);
    font-size: 14px;
}

.admin-action-text small {
    color: var(--admin-muted);
    font-size: 12px;
}

.admin-action-arrow {
    margin-left: auto;
    color: #60a5fa;
    font-size: 20px;
}

/* Keyboard Accessibility */

.admin-dashboard a:focus-visible {
    outline: 2px solid #60a5fa;
    outline-offset: 3px;
}

/* Responsive Layout */

@@media (max-width: 1100px) {
    .admin-stat-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@@media (max-width: 760px) {
    .admin-dashboard {
        padding: 20px;
    }

    .admin-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .admin-content-grid {
        grid-template-columns: 1fr;
    }
}

@@media (max-width: 480px) {
    .admin-stat-grid {
        grid-template-columns: 1fr;
    }

    .admin-header-actions {
        width: 100%;
    }

    .admin-button-primary,
    .admin-button-secondary {
        flex: 1;
    }
}

</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Account? account;
    private List<Driver>? drivers;
    private string? driverLoadError;
    private string? loadError;
    private string? notice;
    private List<CompanyOption>? companies;
    private int? selectedCompanyId;
    private bool showCompanyModal;
    private string? companyLoadError;
    private string? applicantExtraInfo;
    private string? applicationError;
    private bool isSubmitting;
    private bool showCancelApplicationModal;
    private string cancellationReason = "";
    private string? cancellationError;
    private bool isCancelling;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        using var client = HttpClientFactory.CreateClient("Backend");
        try
        {
            account = await client.GetFromJsonAsync<Account>($"users/{id}");
        }
        catch (HttpRequestException)
        {
            loadError = "Couldn't load your account right now. Try again in a moment.";
        }

        if (account is { UserType: "sponsor", CompanyId: not null })
        {
            try
            {
                drivers = await client.GetFromJsonAsync<List<Driver>>($"users/{id}/points/drivers") ?? [];
            }
            catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
            {
                driverLoadError = "Couldn't load drivers right now. Try again in a moment.";
            }
        }
    }

    private async Task ShowCompanyModal()
    {
        selectedCompanyId = null;
        applicantExtraInfo = null;
        applicationError = null;
        companyLoadError = null;
        if (companies is null)
        {
            try
            {
                using var client = HttpClientFactory.CreateClient("Backend");
                companies = await client.GetFromJsonAsync<List<CompanyOption>>("companies") ?? [];
            }
            catch (HttpRequestException)
            {
                companyLoadError = "Couldn't load companies right now. Try again in a moment.";
            }
        }
        showCompanyModal = true;
    }

    private void SelectCompany(int companyId)
    {
        selectedCompanyId = companyId;
        applicantExtraInfo = null;
        applicationError = null;
    }

    private async Task SubmitApplication()
    {
        if (selectedCompanyId is null || isSubmitting)
            return;

        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(id))
        {
            applicationError = "Couldn't identify your account. Please sign in again.";
            return;
        }

        isSubmitting = true;
        applicationError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync($"users/{id}/applications",
                new CreateApplicationRequest(selectedCompanyId.Value, applicantExtraInfo));
            if (response.IsSuccessStatusCode)
            {
                var pendingCompanyName = companies?.FirstOrDefault(company => company.Id == selectedCompanyId.Value)?.Name;
                if (account is not null)
                    account = account with { PendingCompanyName = pendingCompanyName };
                showCompanyModal = false;
                notice = "Your company application has been submitted.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                applicationError = "You already have an application on file.";
            }
            else
            {
                applicationError = "Couldn't submit your application. Please try again.";
            }
        }
        catch (HttpRequestException)
        {
            applicationError = "Couldn't submit your application right now. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void CloseCompanyModal() => showCompanyModal = false;

    private void OpenCancelApplication()
    {
        cancellationReason = "";
        cancellationError = null;
        showCancelApplicationModal = true;
    }

    private void CloseCancelApplication()
    {
        if (!isCancelling)
            showCancelApplicationModal = false;
    }

    private async Task CancelPendingApplication()
    {
        if (isCancelling)
            return;
        if (string.IsNullOrWhiteSpace(cancellationReason))
        {
            cancellationError = "Please provide a response reason.";
            return;
        }

        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(id))
        {
            cancellationError = "Couldn't identify your account. Please sign in again.";
            return;
        }

        isCancelling = true;
        cancellationError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync($"users/{id}/applications/cancel",
                new CancelApplicationRequest(cancellationReason.Trim()));
            if (!response.IsSuccessStatusCode)
            {
                cancellationError = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "No active application was found to cancel."
                    : "Couldn't cancel your application. Please try again.";
                return;
            }

            if (account is not null)
                account = account with { PendingCompanyName = null };
            showCancelApplicationModal = false;
            notice = "Your company application was canceled.";
        }
        catch (HttpRequestException)
        {
            cancellationError = "Couldn't cancel your application right now. Please try again.";
        }
        finally
        {
            isCancelling = false;
        }
    }

    private sealed record Account(int Id, string UserType, string Username, string FirstName, string LastName, string Email, string PhoneNumber, string Address, string? CompanyName, int? CompanyId, int Points, string? PendingCompanyName, decimal? MonthlyBudget);
    private sealed record CompanyOption(int Id, string Name, string? Description);
    private sealed record Driver(int Id, string Username, string FirstName, string LastName, string Email, int Points);
    private sealed record CreateApplicationRequest(int CompanyId, string? ApplicantExtraInfo);
    private sealed record CancelApplicationRequest(string Reasoning);
}
