@code {
    private IJSObjectReference? truckModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Run the secret truck for drivers, sponsors, and admins.
        truckModule = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./js/truckEasterEgg.js");
        await truckModule.InvokeVoidAsync("initializeTruckEasterEgg");

        // Preserve the existing admin-only dancing animation.
        var user = (await AuthState).User;
        if (!user.IsInRole("admin")) return;

        var module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./js/adminDance.js");
        try
        {
            await module.InvokeVoidAsync("showAdminDance");
        }
        finally
        {
            await module.DisposeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (truckModule is null) return;

        try
        {
            await truckModule.InvokeVoidAsync("disposeTruckEasterEgg");
            await truckModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The Blazor circuit may already be disconnected.
        }
    }
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Account? account;

private bool showClassified = false;
private int selectedSecret = 0;

private sealed class AdminTask
{
    public string Title { get; set; } = "";
    public bool Completed { get; set; }
}

private List<AdminTask> adminTasks = new()
{
    new() { Title = "Review accounts" },
    new() { Title = "Check audit log" }
};

private string newAdminTask = "";

private void AddAdminTask()
{
    if (string.IsNullOrWhiteSpace(newAdminTask))
        return;

    adminTasks.Add(new AdminTask
    {
        Title = newAdminTask.Trim()
    });

    newAdminTask = "";
}

private void ConfirmAdminTask(AdminTask task)
{
    if (!task.Completed)
        return;

    adminTasks.Remove(task);
}


private void HandleAdminTaskKeyDown(
    Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
{
    if (args.Key == "Enter")
        AddAdminTask();
}

    private string? loadError;
    private bool isAuthenticated;
    private string? notice;
    private List<CompanyOption>? companies;
    private int? selectedCompanyId;
    private int? cancelCompanyId;
    private string? cancelCompanyName;
    private bool showCompanyModal;
    private string? companyLoadError;
    private string? applicantExtraInfo;
    private string? applicationError;
    private bool isSubmitting;
    private bool showCancelApplicationModal;
    private string cancellationReason = "";
    private string? cancellationError;
    private bool isCancelling;
    private int? switchingCompanyId;
    private string? companySwitchError;
    private List<CompanyOption> AvailableCompanies => (companies ?? [])
        .Where(company => !(account?.Companies ?? []).Any(membership => membership.Id == company.Id))
        .Where(company => !(account?.PendingCompanies ?? []).Any(pending => pending.Id == company.Id) &&
            (account?.PendingCompanyName is null || !string.Equals(company.Name, account.PendingCompanyName, StringComparison.OrdinalIgnoreCase)))
        .ToList();
    private List<PendingCompany> PendingCompanyRows
    {
        get
        {
            if (account?.PendingCompanies is { Count: > 0 } pendingCompanies)
                return pendingCompanies;
            if (string.IsNullOrWhiteSpace(account?.PendingCompanyName))
                return [];
            var company = companies?.FirstOrDefault(option => string.Equals(option.Name, account.PendingCompanyName, StringComparison.OrdinalIgnoreCase));
            return [new PendingCompany(company?.Id ?? 0, account.PendingCompanyName)];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        isAuthenticated = user.Identity?.IsAuthenticated == true;
        if (!isAuthenticated)
            return;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        using var client = HttpClientFactory.CreateClient("Backend");
        try
        {
            account = await client.GetFromJsonAsync<Account>($"users/{id}");
            if (account?.UserType == "driver")
            {
                try
                {
                    var pendingCompanies = await client.GetFromJsonAsync<List<PendingCompany>>($"users/{id}/pending-applications");
                    if (pendingCompanies is not null)
                        account = account with
                        {
                            PendingCompanies = pendingCompanies,
                            PendingCompanyName = pendingCompanies.FirstOrDefault()?.Name
                        };
                }
                catch (HttpRequestException)
                {
                    // Keep the summary response as a fallback while older backend instances are restarting.
                }
            }
        }
        catch (HttpRequestException)
        {
            loadError = "Couldn't load your account right now. Try again in a moment.";
        }

    }

    private async Task ShowCompanyModal()
    {
        selectedCompanyId = null;
        applicantExtraInfo = null;
        applicationError = null;
        companyLoadError = null;
        if (companies is null)
        {
            try
            {
                using var client = HttpClientFactory.CreateClient("Backend");
                companies = await client.GetFromJsonAsync<List<CompanyOption>>("companies") ?? [];
            }
            catch (HttpRequestException)
            {
                companyLoadError = "Couldn't load companies right now. Try again in a moment.";
            }
        }
        showCompanyModal = true;
    }

    private async Task SwitchCompany(int companyId)
    {
        if (switchingCompanyId is not null)
            return;

        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(id))
        {
            companySwitchError = "Couldn't identify your account. Please sign in again.";
            return;
        }

        switchingCompanyId = companyId;
        companySwitchError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsync($"users/{id}/companies/{companyId}/switch", null);
            if (!response.IsSuccessStatusCode)
            {
                companySwitchError = "Couldn't switch companies. Please try again.";
                return;
            }

            account = await client.GetFromJsonAsync<Account>($"users/{id}");
            notice = "Your current company has been switched.";
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
        catch (HttpRequestException)
        {
            companySwitchError = "Couldn't switch companies right now. Please try again.";
        }
        finally
        {
            switchingCompanyId = null;
        }
    }

    private void SelectCompany(int companyId)
    {
        selectedCompanyId = companyId;
        applicantExtraInfo = null;
        applicationError = null;
    }

    private async Task SubmitApplication()
    {
        if (selectedCompanyId is null || isSubmitting)
            return;

        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(id))
        {
            applicationError = "Couldn't identify your account. Please sign in again.";
            return;
        }

        isSubmitting = true;
        applicationError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync($"users/{id}/applications",
                new CreateApplicationRequest(selectedCompanyId.Value, applicantExtraInfo));
            if (response.IsSuccessStatusCode)
            {
                var pendingCompanyName = companies?.FirstOrDefault(company => company.Id == selectedCompanyId.Value)?.Name;
                if (account is not null)
                    account = account with
                    {
                        PendingCompanyName = pendingCompanyName,
                        PendingCompanies = [new PendingCompany(selectedCompanyId.Value, pendingCompanyName ?? "Company"), .. account.PendingCompanies ?? []]
                    };
                showCompanyModal = false;
                notice = "Your company application has been submitted.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                applicationError = "You already have an application on file.";
            }
            else
            {
                applicationError = "Couldn't submit your application. Please try again.";
            }
        }
        catch (HttpRequestException)
        {
            applicationError = "Couldn't submit your application right now. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void CloseCompanyModal() => showCompanyModal = false;

    private void OpenCancelApplication(PendingCompany? pendingCompany = null)
    {
        cancellationReason = "";
        cancellationError = null;
        cancelCompanyId = pendingCompany is { Id: > 0 } ? pendingCompany.Id : null;
        cancelCompanyName = pendingCompany?.Name ?? account?.PendingCompanyName;
        showCancelApplicationModal = true;
    }

    private void CloseCancelApplication()
    {
        if (!isCancelling)
            showCancelApplicationModal = false;
    }

    private async Task CancelPendingApplication()
    {
        if (isCancelling)
            return;
        if (string.IsNullOrWhiteSpace(cancellationReason))
        {
            cancellationError = "Please provide a response reason.";
            return;
        }

        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(id))
        {
            cancellationError = "Couldn't identify your account. Please sign in again.";
            return;
        }

        isCancelling = true;
        cancellationError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync($"users/{id}/applications/cancel",
                new CancelApplicationRequest(cancellationReason.Trim(), cancelCompanyId));
            if (!response.IsSuccessStatusCode)
            {
                cancellationError = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "No active application was found to cancel."
                    : "Couldn't cancel your application. Please try again.";
                return;
            }

            if (account is not null)
            {
                var remainingPending = (account.PendingCompanies ?? [])
                    .Where(company => cancelCompanyId is null || company.Id != cancelCompanyId.Value)
                    .ToList();
                account = account with
                {
                    PendingCompanies = remainingPending,
                    PendingCompanyName = remainingPending.FirstOrDefault()?.Name
                };
            }
            showCancelApplicationModal = false;
            cancelCompanyId = null;
            cancelCompanyName = null;
            notice = "Your company application was canceled.";
        }
        catch (HttpRequestException)
        {
            cancellationError = "Couldn't cancel your application right now. Please try again.";
        }
        finally
        {
            isCancelling = false;
        }
    }

    private sealed record Account(int Id, string UserType, string Username, string FirstName, string LastName, string Email, string PhoneNumber, string Address, string? CompanyName, List<string>? CompanyNames, List<CompanyMembership>? Companies, int? CompanyId, long Points, string? PendingCompanyName, decimal? MonthlyBudget, int MonthlyDriverPoints = 0, DateTime? NextMonthlyReward = null, List<PendingCompany>? PendingCompanies = null);
    private sealed record CompanyMembership(int Id, string Name, bool CurrentCompanyViewed);
    private sealed record PendingCompany(int Id, string Name);
    private sealed record CompanyOption(int Id, string Name, string? Description);
    private sealed record CreateApplicationRequest(int CompanyId, string? ApplicantExtraInfo);
    private sealed record CancelApplicationRequest(string Reasoning, int? CompanyId = null);
