@page "/account/profile"
@attribute [Authorize]
@using System.Security.Claims
@inject NavigationManager Nav
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Edit account</PageTitle>

<div class="tr-page-narrow">
    <div class="tr-card">
        <h1>Edit account</h1>
        @if (error is not null)
        {
            <p role="alert" class="tr-alert-error">@error</p>
        }
        @if (loadError is not null)
        {
            <p role="alert" class="tr-alert-error">@loadError</p>
        }
        else if (account is null)
        {
            <p role="status"><em>Loading your account...</em></p>
        }
        else
        {
            <form class="tr-form" method="post" action="account/update-profile">
                <label for="firstName">First name</label>
                <input id="firstName" name="firstName" type="text" required maxlength="100" autocomplete="given-name" value="@account.FirstName" />

                <label for="lastName">Last name</label>
                <input id="lastName" name="lastName" type="text" required maxlength="100" autocomplete="family-name" value="@account.LastName" />

                <label for="phoneNumber">Phone</label>
                <input id="phoneNumber" name="phoneNumber" type="tel" maxlength="20" autocomplete="tel" value="@account.PhoneNumber" />

                <label for="address">Address</label>
                <input id="address" name="address" type="text" maxlength="255" autocomplete="street-address" value="@account.Address" />

                <label for="username">Username</label>
                <div class="readonly-value" id="username">@account.Username <a href="account/username">Change username</a></div>

                <label for="email">Email</label>
                <div class="readonly-value" id="email">@account.Email</div>

                <button type="submit" class="tr-btn tr-btn-block">Done</button>
            </form>
        }
    </div>
    <p class="tr-alt"><a href="dashboard">Back to dashboard</a></p>
</div>

<style>
    .readonly-value {
        padding: 10px 0;
        overflow-wrap: anywhere;
    }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Account? account;
    private string? error;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        error = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["error"];
        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            account = await client.GetFromJsonAsync<Account>($"users/{id}");
            if (account is null)
                loadError = "Couldn't load your account right now. Try again in a moment.";
        }
        catch (HttpRequestException)
        {
            loadError = "Couldn't load your account right now. Try again in a moment.";
        }
    }

    private sealed record Account(string Username, string FirstName, string LastName, string Email, string PhoneNumber, string Address);
}
