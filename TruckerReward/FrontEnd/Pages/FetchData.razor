@page "/"
@using FrontEnd.Data
@inject TruckerDashboardClient DashboardClient

<PageTitle>TruckerReward Dashboard</PageTitle>

<h1>My TruckerReward Dashboard</h1>

<p>Review your profile, points, and sponsor rewards.</p>

@if (dashboard == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <section class="mb-4">
        <h2>Driver information</h2>
        <p><strong>@dashboard.Trucker.Name</strong> · Driver ID: @dashboard.Trucker.DriverId</p>
        <p>@dashboard.Trucker.Email · @dashboard.Trucker.Phone</p>
        <p>Home terminal: @dashboard.Trucker.HomeTerminal</p>
    </section>

    <section class="mb-4">
        <h2>My points</h2>
        <p><strong>@dashboard.Points.CurrentBalance points</strong> · @dashboard.Points.Tier status</p>
        <p>@dashboard.Points.NextMilestone</p>
    </section>

    <section>
        <h2>My sponsor</h2>
        <p><strong>@dashboard.Sponsor.Name</strong> · @dashboard.Sponsor.Program</p>
        <p>@dashboard.Sponsor.Benefit</p>
        <p>Contact: @dashboard.Sponsor.ContactEmail</p>
    </section>
}

@code {
    private TruckerDashboard? dashboard;

    protected override async Task OnInitializedAsync()
    {
        dashboard = await DashboardClient.GetDashboardAsync();
    }
}
