@page "/forgot-password"
@inject NavigationManager Nav

<PageTitle>Forgot password</PageTitle>

<div class="tr-page-narrow">
    <div class="tr-card">
        <h1>Forgot password</h1>
        <p class="tr-subtitle">Enter the email on your account and we'll send a link to choose a new password.</p>

        @if (sent)
        {
            <p role="status" class="tr-alert-success">If that email has an account, a reset link is on its way. It works for one hour.</p>
        }
        else
        {
            @if (error)
            {
                <p role="alert" class="tr-alert-error">Something went wrong sending the link. Try again in a moment.</p>
            }
            <form class="tr-form" method="post" action="account/forgot">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" required autocomplete="email" autofocus />
                <button type="submit" class="tr-btn tr-btn-block">Send reset link</button>
            </form>
        }
    </div>

    <p class="tr-alt"><a href="login">Back to log in</a></p>
</div>

@code {
    private bool sent;
    private bool error;

    protected override void OnInitialized()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        sent = query["sent"] == "1";
        error = query["error"] == "1";
    }
}
