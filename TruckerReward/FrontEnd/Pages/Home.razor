@page "/"
@inject NavigationManager Nav

<PageTitle>TruckerReward</PageTitle>

@if (!isSponsor)
{
<div class="tr-page-narrow home home-center">
    <h1>TruckerReward</h1>

    <AuthorizeView>
        <Authorized>
            <p>Signed in as <strong>@context.User.Identity?.Name</strong>.</p>
            <p>
                <a class="tr-btn" href="dashboard">Go to your dashboard</a>
                <a class="tr-btn-outline" href="products">Browse products</a>
            </p>
        </Authorized>
        <NotAuthorized>
            <p>Welcome to TruckerReward.</p>
            <p>
                <a class="tr-btn" href="login">Log in</a>
                <a class="tr-btn-outline" href="register">Create an account</a>
            </p>
        </NotAuthorized>
    </AuthorizeView>
</div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool isSponsor;

    protected override async Task OnInitializedAsync()
    {
        isSponsor = (await AuthState).User.IsInRole("sponsor");
        if (isSponsor)
            Nav.NavigateTo("dashboard", replace: true);
    }
}
