@page "/"
@inject NavigationManager Nav

<PageTitle>TruckerReward</PageTitle>


@if (!isSponsor)
{
    <div class="tr-page-narrow home home-center">
        <div class="home-intro">
            <h1>TruckerReward</h1>
            <div class="home-accent"></div>

            <AuthorizeView>
                <Authorized>
                    <p class="home-welcome">
                        Welcome back, <strong>@context.User.Identity?.Name</strong>!
                    </p>
                    <div class="home-actions">
                        <a class="tr-btn" href="dashboard">Go to your dashboard</a>
                        <a class="tr-btn-outline" href="products">Browse products</a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <p class="home-welcome">
                        Welcome to TruckerReward!
                    </p>
                    <div class="home-actions">
                        <a class="tr-btn" href="login">Log in</a>
                        <a class="tr-btn-outline" href="register">Create an account</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
}


@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool isSponsor;

    protected override async Task OnInitializedAsync()
    {
        isSponsor = (await AuthState).User.IsInRole("sponsor");
        if (isSponsor)
            Nav.NavigateTo("dashboard", replace: true);
    }
}

<style>
    .home {
        max-width: 640px;
    }

    .home .tr-btn, .home .tr-btn-outline {
        margin: 8px 12px 0 0;
    }
</style>
