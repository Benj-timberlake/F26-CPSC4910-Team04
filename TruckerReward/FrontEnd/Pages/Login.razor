@page "/login"
@using Microsoft.AspNetCore.Authentication
@inject IAuthenticationSchemeProvider Schemes
@inject NavigationManager Nav

<PageTitle>Log in</PageTitle>

<div class="tr-page-narrow">
    <div class="tr-card">
        <h1>Log in</h1>
        <p class="tr-subtitle">Drivers, sponsors and administrators all sign in here.</p>

        @if (error == "1")
        {
            <p role="alert" class="tr-alert-error">Wrong username or password.</p>
        }
        else if (error == "sso")
        {
            <p role="alert" class="tr-alert-error">Sign in with that provider didn't work. Try again or use a password.</p>
        }

        <form class="tr-form" method="post" action="account/login">
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <label for="username">Username</label>
            <input id="username" name="username" required autocomplete="username" autofocus />

            <label for="password">Password</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" />

            <button type="submit" class="tr-btn tr-btn-block">Log in</button>
        </form>

        @if (providers.Count > 0)
        {
            <div class="sso">
                <p class="tr-subtitle">or continue with</p>
                @foreach (var p in providers)
                {
                    <a class="tr-btn-outline tr-btn-block" href="account/external/@p.Name?returnUrl=@Uri.EscapeDataString(returnUrl ?? "")">@p.DisplayName</a>
                }
            </div>
        }
    </div>

    <p class="alt">No account yet? <a href="register">Create one</a></p>
</div>

<style>
    .sso {
        margin-top: 24px;
        text-align: center;
    }

    .sso .tr-btn-block {
        margin-top: 8px;
    }

    .alt {
        margin-top: 20px;
        text-align: center;
    }
</style>

@code {
    private string? error;
    private string? returnUrl;
    private List<AuthenticationScheme> providers = new();

    protected override async Task OnInitializedAsync()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        error = query["error"];
        returnUrl = query["returnUrl"];

        // only google/microsoft have a display name, the cookie schemes don't
        providers = (await Schemes.GetAllSchemesAsync())
            .Where(s => !string.IsNullOrEmpty(s.DisplayName))
            .ToList();
    }
}
