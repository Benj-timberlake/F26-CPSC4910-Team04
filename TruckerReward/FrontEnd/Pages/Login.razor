@page "/login"
@using Microsoft.AspNetCore.Authentication
@inject IAuthenticationSchemeProvider Schemes

<PageTitle>Log in</PageTitle>

<div class="tr-page-narrow">
    <div class="tr-card">
        <h1>Log in</h1>

        @if (message is not null)
        {
            <p role="alert" class="@(Error is null ? "tr-alert-success" : "tr-alert-error")">@message</p>
        }

        <form class="tr-form" method="post" action="account/login">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <label for="username">Username</label>
            <input id="username" name="username" required autocomplete="username" autofocus />

            <label for="password">Password</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" />

            <button type="submit" class="tr-btn tr-btn-block">Log in</button>
            <p class="tr-alt"><a href="forgot-password">Forgot your password?</a></p>
        </form>

        <div class="passkey">
            <button type="button" class="tr-btn-outline tr-btn-block" data-return-url="@ReturnUrl" onclick="truckerPasskeys.signIn(this.dataset.returnUrl, 'passkey-status')">Sign in with Face ID or a passkey</button>
            <p id="passkey-status" role="alert" class="tr-alert-error" hidden></p>
        </div>

        @if (providers.Count > 0)
        {
            <div class="sso">
                <p class="tr-subtitle">or continue with</p>
                @foreach (var p in providers)
                {
                    <a class="tr-btn-outline tr-btn-block" href="account/external/@p.Name?returnUrl=@Uri.EscapeDataString(ReturnUrl ?? "")">@p.DisplayName</a>
                }
            </div>
        }
    </div>

    <p class="tr-alt">No account yet? <a href="register">Create one</a></p>
</div>

<style>
    .passkey {
        margin-top: 16px;
    }

    .sso {
        margin-top: 24px;
        text-align: center;
    }

    .sso .tr-btn-block {
        margin-top: 8px;
    }
</style>

@code {
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private string? Reset { get; set; }
    [SupplyParameterFromQuery] private string? SignedOut { get; set; }
    [SupplyParameterFromQuery] private string? Deleted { get; set; }
    private string? message;
    private List<AuthenticationScheme> providers = new();

    protected override async Task OnInitializedAsync()
    {
        // one message for a bad username or a bad password, saying which would confirm which usernames exist
        message = Error switch
        {
            "1" => "Wrong username or password.",
            "locked" => "Too many failed attempts. Wait a few minutes and try again.",
            "inactive" => "This account has been deactivated. Contact an administrator.",
            "backend" => "Something went wrong on our side. Try again in a moment.",
            "sso" => "Sign in with that provider didn't work. Try again or use a password.",
            "code" => "That sign-in code expired or had too many wrong tries. Log in again for a new one.",
            "codes" => "Too many codes asked for. Wait a few minutes and try again.",
            null when Reset == "1" => "Your password has been reset. Log in with the new one.",
            null when SignedOut == "everywhere" => "You were signed out on every device. Log in again here.",
            null when Deleted == "1" => "Your account has been deleted.",
            _ => null
        };

        // only google/microsoft have a display name, the cookie schemes don't
        providers = (await Schemes.GetAllSchemesAsync())
            .Where(s => !string.IsNullOrEmpty(s.DisplayName))
            .ToList();
    }
}
