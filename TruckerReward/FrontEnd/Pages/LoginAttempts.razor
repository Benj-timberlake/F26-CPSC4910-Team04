@page "/admin/login-attempts"
@attribute [Authorize(Roles = "admin")]
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Login attempts</PageTitle>

<div class="tr-page">
    <h1>Login attempts</h1>
    <p class="tr-subtitle">Every password and single sign-on attempt, newest first. Unknown usernames are listed too.</p>

    <label class="filter">
        <input type="checkbox" @bind="failedOnly" @bind:after="Load" />
        Failed only
    </label>

    @if (attempts == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (attempts.Count == 0)
    {
        <p>Nothing logged yet.</p>
    }
    else
    {
        <div class="tr-card tr-table-wrap">
        <table class="tr-table">
            <thead>
                <tr>
                    <th>When (UTC)</th>
                    <th>Username</th>
                    <th>User ID</th>
                    <th>Result</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in attempts)
                {
                    <tr class="@(a.Succeeded ? "" : "failed")">
                        <td>@a.AttemptedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@a.Username</td>
                        <td>@(a.UserId?.ToString() ?? "no such user")</td>
                        <td>@(a.Succeeded ? "Signed in" : "Failed")</td>
                        <td>@(a.IpAddress ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

<style>
    .filter {
        display: block;
        margin: 0 0 16px;
    }

    .filter input {
        margin-right: 6px;
    }
</style>

@code {
    private bool failedOnly = true;
    private List<Attempt>? attempts;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        using var client = HttpClientFactory.CreateClient("Backend");
        attempts = await client.GetFromJsonAsync<List<Attempt>>($"admin/login-attempts?failedOnly={failedOnly}");
    }

    private class Attempt
    {
        public string Username { get; set; } = "";
        public int? UserId { get; set; }
        public bool Succeeded { get; set; }
        public string? IpAddress { get; set; }
        public DateTime AttemptedAt { get; set; }
    }
}
