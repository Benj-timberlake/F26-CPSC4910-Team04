@page "/login/code"
@inject NavigationManager Nav

<PageTitle>Enter your code</PageTitle>

<div class="tr-page-narrow">
    <div class="tr-card">
        <h1>Enter your code</h1>
        <p>We emailed you a 6-digit code. It works for ten minutes.</p>

        @if (wrong)
        {
            <p role="alert" class="tr-alert-error">That code isn't right. Check the email and try again.</p>
        }

        <form class="tr-form" method="post" action="account/login/code">
            <label for="code">Code</label>
            <input id="code" name="code" required inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" autofocus />
            <button type="submit" class="tr-btn tr-btn-block">Log in</button>
        </form>
    </div>

    <p class="tr-alt"><a href="login">Start over</a></p>
</div>

@code {
    private bool wrong;

    protected override void OnInitialized() =>
        wrong = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["error"] == "wrong";
}
