@page "/manage-points"
@attribute [Authorize(Roles = "sponsor,admin")]
@using System.Security.Claims
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Driver points</PageTitle>

<div class="tr-page">
    <h1>Driver points</h1>
     <p class="tr-muted" style="margin-bottom: 20px;">
        Only drivers who are connected to a sponsor company are
        displayed here. Additional drivers will automatically appear
        once they have been assigned to a sponsor.
    </p>

    @if (notice is not null)
    {
        <p role="status" class="tr-alert-success">@notice</p>
    }
    @if (error is not null)
    {
        <p role="alert" class="tr-alert-error">@error</p>
    }

    @if (noCompany)
    {
        <p>You aren't with a company yet, so there are no drivers to manage.</p>
    }
    else
    {
        <form class="search" @onsubmit="Search">
            <label for="search" class="visually-hidden">Search drivers</label>
            <input id="search" type="search" placeholder="Search by name or username" @bind="search" />
            <select aria-label="Sort" @bind="sort">
                <option value="name">Sort by name</option>
                <option value="points">Highest balance first</option>
                <option value="spent">Most points spent first</option>
                <option value="earned">Most points earned first</option>
            </select>
            <label for="from">From</label>
            <input id="from" type="date" @bind="from" />
            <label for="to">To</label>
            <input id="to" type="date" @bind="to" />
            <button type="submit" class="tr-btn">Search</button>
        </form>

        @if (drivers is null)
        {
            <p role="status"><em>Loading...</em></p>
        }
        else if (drivers.Count == 0)
        {
            <p class="tr-muted">No drivers found.</p>
        }
        else
        {
            <div class="tr-table-wrap">
                <table class="tr-table">
                    <thead>
                        <tr>
                            <th>Driver</th>
                            <th>Email</th>
                            <th>Points</th>
                            <th>Spent</th>
                            @if (ranged)
                            {
                                <th>Earned @RangeLabel</th>
                            }
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in drivers)
                        {
                            <tr>
                                <td>@d.FirstName @d.LastName (@d.Username)</td>
                                <td>@d.Email</td>
                                <td class="balance">@d.Points.ToString("N0")</td>
                                <td class="spent">@d.Spent.ToString("N0")</td>
                                @if (ranged)
                                {
                                    <td class="earned">@d.Earned?.ToString("N0")</td>
                                }
                                <td>
                                    @if (removing == d.Id)
                                    {
                                        <div class="change">
                                            <input type="text" aria-label="Why remove @d.Username" placeholder="Reason" maxlength="500" @bind="reason" />
                                            <button type="button" class="tr-btn" disabled="@busy" @onclick="() => Remove(d)">Remove from sponsor</button>
                                            <button type="button" class="tr-btn-outline" @onclick="() => removing = null">Cancel</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" class="tr-btn-outline" @onclick="() => Edit(d)">Change points</button>
                                        @if (!viewing)
                                        {
                                            <button type="button" class="tr-btn-outline remove" @onclick="() => StartRemove(d)">Remove</button>
                                        }
                                        @if (admin && !viewing)
                                        {
                                            <form class="view-as" method="post" action="account/view-as/@d.Id">
                                                <button type="submit" class="tr-btn-outline">View as</button>
                                            </form>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    @if (editingDriver is not null)
    {
        <div class="modal-backdrop">
            <section class="change-modal" role="dialog" aria-modal="true" aria-labelledby="change-modal-title">
                <h2 id="change-modal-title">Change points for @editingDriver.FirstName @editingDriver.LastName</h2>
                <p><strong>Username:</strong> @editingDriver.Username<br /><strong>Email:</strong> @editingDriver.Email</p>
                <dl class="change-summary">
                    <dt>@(admin ? "Balance in selected company" : "Current company balance")</dt>
                    <dd>@(admin ? selectedCompany?.Points.ToString("N0") ?? "Select a company" : editingDriver.Points.ToString("N0"))</dd>
                    @if (admin)
                    {
                        <dt>Points across companies</dt>
                        <dd>@editingDriver.Points.ToString("N0")</dd>
                    }
                    <dt>Spent on orders</dt>
                    <dd>@editingDriver.Spent.ToString("N0")</dd>
                    @if (ranged)
                    {
                        <dt>Earned @RangeLabel</dt>
                        <dd>@editingDriver.Earned?.ToString("N0")</dd>
                    }
                </dl>

                @if (admin)
                {
                    @if (companyChoicesLoading)
                    {
                        <p role="status"><em>Loading the driver's companies...</em></p>
                    }
                    else if (editCompanies is { Count: > 1 })
                    {
                        <label for="change-company">Company for this points change</label>
                        <select id="change-company" value="@selectedCompanyId" @onchange="SelectEditCompany">
                            <option value="">Choose a company</option>
                            @foreach (var company in editCompanies)
                            {
                                <option value="@company.Id">@company.Name (@company.Points.ToString("N0") points)</option>
                            }
                        </select>
                    }
                    else if (selectedCompany is not null)
                    {
                        <p><strong>Company:</strong> @selectedCompany.Name</p>
                    }
                    @if (companyChoiceError is not null)
                    {
                        <p role="alert" class="tr-alert-error">@companyChoiceError</p>
                    }
                }

                <label for="change-amount">Points change</label>
                <input id="change-amount" type="number" placeholder="+100 or -50" @bind="amount" />
                @if (amount is not null)
                {
                    <p>New balance: @(proposedBalance?.ToString("N0") ?? "Choose a company to preview the balance")</p>
                }
                @if (error is not null)
                {
                    <p role="alert" class="tr-alert-error">@error</p>
                }
                <label for="change-reason">Reason</label>
                <input id="change-reason" type="text" maxlength="500" @bind="reason" />
                <div class="modal-actions">
                    <button type="button" class="tr-btn" disabled="@(!CanSaveChange)" @onclick="Save">Save change</button>
                    <button type="button" class="tr-btn-outline" disabled="@busy" @onclick="CloseEdit">Cancel</button>
                </div>
            </section>
        </div>
    }
</div>

<style>
    form.view-as {
        display: inline;
    }

    .search {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
    }

    .search input {
        flex: 1;
        max-width: 360px;
    }

    .change {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .change input[type=number] {
        width: 120px;
    }

    .modal-backdrop { position: fixed; inset: 0; z-index: 1050; display: flex; align-items: center; justify-content: center; padding: 20px; background: #0009; }
    .change-modal { width: min(560px, 100%); max-height: 90vh; overflow-y: auto; padding: 24px; border-radius: 12px; background: white; color: #222; box-shadow: 0 18px 60px #0005; }
    .change-modal h2 { margin-top: 0; }
    .change-modal label { display: block; margin: 12px 0 5px; font-weight: 600; }
    .change-modal input, .change-modal select { width: 100%; padding: 8px 10px; border: 1px solid #aeb7c4; border-radius: 6px; font: inherit; }
    .change-summary { display: grid; grid-template-columns: 1fr auto; gap: 4px 16px; padding: 12px; background: #f4f6f9; border-radius: 8px; }
    .change-summary dd { margin: 0; font-weight: 700; text-align: right; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px; }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string? id;
    private List<Driver>? drivers;
    private string? search;
    private string sort = "name";
    private DateOnly? from;
    private DateOnly? to;
    private bool ranged;
    private int? removing;
    private int? amount;
    private string? reason;
    private bool busy;
    private bool noCompany;
    private bool viewing;
    private bool admin;
    private string? error;
    private string? notice;
    private Driver? editingDriver;
    private List<DriverCompany>? editCompanies;
    private int? selectedCompanyId;
    private bool companyChoicesLoading;
    private string? companyChoiceError;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        viewing = FrontEnd.Auth.ViewAs.IsViewing(user);
        admin = user.IsInRole("admin");
        await Load();
    }

    private async Task Search()
    {
        notice = null;
        await Load();
    }

    private async Task Load()
    {
        error = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var query = new List<string>();
            if (!string.IsNullOrWhiteSpace(search)) query.Add("search=" + Uri.EscapeDataString(search.Trim()));
            if (sort != "name") query.Add("sort=" + sort);
            if (from is not null) query.Add($"from={from:yyyy-MM-dd}");
            if (to is not null) query.Add($"to={to:yyyy-MM-dd}");
            var url = $"users/{id}/points/drivers" + (query.Count > 0 ? "?" + string.Join("&", query) : "");
            var response = await client.GetAsync(url);
            // sponsors without a company get a 403
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                noCompany = true;
                return;
            }
            if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                error = (await response.Content.ReadFromJsonAsync<Problem>())?.Message;
                return;
            }
            response.EnsureSuccessStatusCode();
            drivers = await response.Content.ReadFromJsonAsync<List<Driver>>() ?? [];
            ranged = from is not null || to is not null;
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            error = "Couldn't load drivers right now. Try again in a moment.";
        }
    }

    private async Task Edit(Driver d)
    {
        editingDriver = d;
        removing = null;
        amount = null;
        reason = null;
        notice = null;
        error = null;
        editCompanies = null;
        selectedCompanyId = null;
        companyChoiceError = null;
        if (!admin)
            return;

        companyChoicesLoading = true;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var details = await client.GetFromJsonAsync<DriverDetails>($"users/{d.Id}");
            editCompanies = details?.Companies ?? [];
            if (editCompanies.Count == 1)
                selectedCompanyId = editCompanies[0].Id;
            else if (editCompanies.Count == 0)
                companyChoiceError = "This driver is not associated with a company.";
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            companyChoiceError = "Couldn't load the driver's companies. Try again.";
        }
        finally
        {
            companyChoicesLoading = false;
        }
    }

    private void SelectEditCompany(ChangeEventArgs args)
    {
        selectedCompanyId = int.TryParse(args.Value?.ToString(), out var value) ? value : null;
    }

    private DriverCompany? selectedCompany => editCompanies?.FirstOrDefault(company => company.Id == selectedCompanyId);
    private long? proposedBalance => (admin ? selectedCompany?.Points : editingDriver?.Points) is long current && amount is int delta
        ? current + delta
        : null;

    private bool CanSaveChange => !busy && !companyChoicesLoading && editingDriver is not null && amount is not null &&
        (!admin || selectedCompanyId is not null);

    private void CloseEdit()
    {
        if (!busy)
            editingDriver = null;
    }

    private async Task Save()
    {
        if (editingDriver is null || !CanSaveChange)
            return;
        var d = editingDriver;
        busy = true;
        error = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync($"users/{id}/points/drivers/{d.Id}", new { points = amount ?? 0, reason, companyId = admin ? selectedCompanyId : null });
            if (response.IsSuccessStatusCode)
            {
                var updated = await response.Content.ReadFromJsonAsync<Driver>();
                if (ranged || admin)
                    await Load();
                else
                    drivers = drivers!.Select(x => x.Id == d.Id && updated is not null ? updated : x).ToList();
                notice = admin
                    ? $"{d.Username}'s selected company balance is now {updated?.Points.ToString("N0")} points."
                    : $"{d.Username} now has {updated?.Points.ToString("N0")} points.";
                editingDriver = null;
            }
            else
            {
                error = (await response.Content.ReadFromJsonAsync<Problem>())?.Message ?? "That didn't work.";
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            error = "That didn't work. Reload and try again.";
        }
        busy = false;
    }

    private void StartRemove(Driver d)
    {
        removing = d.Id;
        editingDriver = null;
        reason = null;
        notice = null;
    }

    private async Task Remove(Driver d)
    {
        busy = true;
        error = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync($"users/{id}/points/drivers/{d.Id}/remove", new { reason });
            if (response.IsSuccessStatusCode)
            {
                drivers = drivers!.Where(x => x.Id != d.Id).ToList();
                notice = $"{d.Username} was removed and told why.";
                removing = null;
            }
            else
            {
                error = (await response.Content.ReadFromJsonAsync<Problem>())?.Message ?? "That didn't work.";
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            error = "That didn't work. Reload and try again.";
        }
        busy = false;
    }

    private string RangeLabel => (from, to) switch
    {
        ({ } f, { } t) => $"{f:MMM d} to {t:MMM d}",
        ({ } f, null) => $"since {f:MMM d}",
        _ => $"through {to:MMM d}"
    };

    private sealed record Driver(int Id, string Username, string FirstName, string LastName, string Email, long Points, long Spent, long? Earned);
    private sealed record DriverDetails(List<DriverCompany>? Companies);
    private sealed record DriverCompany(int Id, string Name, bool CurrentCompanyViewed, long Points);
    private sealed record Problem(string? Message);
}
