@page "/notifications/settings"
@attribute [Authorize]
@inherits BackendPage

<PageTitle>Notification settings</PageTitle>

<div class="tr-page-narrow">
    <div class="tr-card">
        <h1>Notification settings</h1>
        <p class="tr-muted">Password and sign-in notices are always sent. Email alerts start once your address is confirmed.</p>

        @if (loadError is not null)
        {
            <p role="alert" class="tr-alert-error">@loadError</p>
        }
        else if (settings is null)
        {
            <p role="status"><em>Loading...</em></p>
        }
        else if (settings.Count == 0)
        {
            <p>There's nothing to change for your account.</p>
        }
        else
        {
            <Alerts Notice="@notice" Error="@error" />
            <table class="tr-table" aria-label="Notification settings">
                <thead>
                    <tr>
                        <th scope="col">Notification</th>
                        <th scope="col">On</th>
                        <th scope="col">Also email</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in settings)
                    {
                        <tr>
                            <td>@s.Label</td>
                            <td><input type="checkbox" aria-label="@s.Label on" @bind="s.Enabled" /></td>
                            <td><input type="checkbox" aria-label="Email @s.Label" @bind="s.Emailed" disabled="@(!s.Enabled)" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" class="tr-btn tr-btn-block" disabled="@busy" @onclick="Save">Save</button>
        }
    </div>

    <p class="tr-alt"><a href="notifications">Back to notifications</a></p>
</div>

@code {
    private List<Setting>? settings;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        await SignedIn();
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            settings = await client.GetFromJsonAsync<List<Setting>>($"users/{id}/notification-settings") ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            loadError = "Couldn't load your settings right now. Try again in a moment.";
        }
    }

    private Task Save() =>
        Send(c => c.PutAsJsonAsync($"users/{id}/notification-settings", settings!.Select(s => new { s.Category, s.Enabled, s.Emailed })),
            _ => notice = "Saved.", failed: "Couldn't save your settings.", crashed: "Couldn't save your settings right now. Try again in a moment.");

    private sealed class Setting
    {
        public string Category { get; set; } = "";
        public string Label { get; set; } = "";
        public bool Enabled { get; set; }
        public bool Emailed { get; set; }
    }
}
