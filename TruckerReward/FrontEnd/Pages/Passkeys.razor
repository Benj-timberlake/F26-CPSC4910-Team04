@page "/account/passkeys"
@attribute [Authorize]
@inherits BackendPage
@inject IJSRuntime JS

<PageTitle>Face ID and passkeys</PageTitle>

<div class="tr-page-narrow">
    <div class="tr-card">
        <h1>Face ID and passkeys</h1>
        <p class="tr-muted">Sign in with Face ID, a fingerprint or a security key instead of your password.</p>

        <Alerts Notice="@notice" Error="@error" />

        @if (viewing)
        {
            <p class="tr-muted">Passkeys can't be changed while viewing the site as someone else.</p>
        }
        else
        {
            <form class="tr-form add-passkey" @onsubmit="Add">
                <label for="passkey-name">Name this device</label>
                <input id="passkey-name" maxlength="100" @bind="name" />
                <button type="submit" class="tr-btn" disabled="@busy">Add a passkey</button>
            </form>
        }

        @if (passkeys is null)
        {
            <p role="status"><em>Loading...</em></p>
        }
        else if (passkeys.Count == 0)
        {
            <p class="tr-muted">No passkeys yet.</p>
        }
        else
        {
            <ul class="passkey-list tr-list">
                @foreach (var p in passkeys)
                {
                    <li>
                        <strong>@p.Name</strong>
                        <span class="tr-muted">Added @p.CreatedAt.ToString("yyyy-MM-dd"), @(p.LastUsedAt is null ? "never used" : "last used " + p.LastUsedAt.Value.ToString("yyyy-MM-dd"))</span>
                        @if (!viewing)
                        {
                            <button type="button" class="tr-btn-outline" disabled="@busy" aria-label="Remove @p.Name" @onclick="() => Remove(p)">Remove</button>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>

<style>
    .add-passkey {
        margin-bottom: 16px;
    }

    .passkey-list li {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
    }
</style>

@code {
    private bool viewing;
    private string name = "This device";
    private List<Passkey>? passkeys;

    protected override async Task OnInitializedAsync()
    {
        var user = await SignedIn();
        viewing = FrontEnd.Auth.ViewAs.IsViewing(user);
        await Load();
    }

    private async Task Load()
    {
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            passkeys = await client.GetFromJsonAsync<List<Passkey>>($"users/{id}/passkeys") ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            error = "Couldn't load your passkeys right now. Try again in a moment.";
        }
    }

    private async Task Add()
    {
        busy = true;
        error = notice = null;
        var problem = await JS.InvokeAsync<string?>("truckerPasskeys.register", name.Trim());
        if (problem is null)
        {
            notice = "Passkey added. You can sign in with it from the login page.";
            await Load();
        }
        else
        {
            error = problem;
        }
        busy = false;
    }

    private Task Remove(Passkey p) =>
        Send(c => c.DeleteAsync($"users/{id}/passkeys/{p.Id}"), async _ =>
        {
            notice = $"{p.Name} was removed.";
            await Load();
        }, failed: "That passkey couldn't be removed.");

    private sealed record Passkey(int Id, string Name, DateTime CreatedAt, DateTime? LastUsedAt);
}
