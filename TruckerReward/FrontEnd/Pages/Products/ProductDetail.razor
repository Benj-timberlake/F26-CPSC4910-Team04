@page "/product"
@using System.Net
@using System.Text.Json
@using System.Security.Claims
@using System.Globalization
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@(product?.Title ?? "Product details")</PageTitle>

<main class="product-detail">
    <a href="/products">Back to catalog</a>
    @if (loading)
    {
        <p role="status">Loading product...</p>
    }
    else if (error is not null)
    {
        <p role="alert">@error</p>
        <button type="button" @onclick="LoadProduct">Retry</button>
    }
    else if (product is not null)
    {
        <div class="detail-layout">
            <div class="detail-photo">
                @if (!string.IsNullOrWhiteSpace(product.Image?.ImageUrl))
                {
                    <img src="@product.Image.ImageUrl" alt="@product.Title" />
                }
                else
                {
                    <p>No image available</p>
                }
            </div>
            <section>
                <h1>@product.Title</h1>
                <p class="detail-price">@(product.Price?.Display ?? "Price unavailable")</p>
                <button type="button" class="buy-button" disabled="@addingToCart" @onclick="AddToCart">@(addingToCart ? "Adding..." : "Buy")</button>
                @if (cartError is not null)
                {
                    <p role="alert">@cartError</p>
                }
            </section>
        </div>
        <section class="description">
            <h2>Description</h2>
            @if (!string.IsNullOrWhiteSpace(product.Description))
            {
                <iframe title="Product description" sandbox="" referrerpolicy="no-referrer"
                        srcdoc="@(DescriptionDocument(product.Description))"></iframe>
            }
            else
            {
                <p>@(string.IsNullOrWhiteSpace(product.ShortDescription) ? "No description available." : product.ShortDescription)</p>
            }
        </section>
    }
</main>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "itemId")]
    public string? ItemId { get; set; }

    private Products.Product? product;
    private bool loading;
    private string? error;
    private CancellationTokenSource? requestCancellation;
    private bool addingToCart;
    private string? cartError;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private async Task AddToCart()
    {
        if (addingToCart || product is null) return;
        cartError = null;
        var user = (await AuthState).User;
        if (user.Identity?.IsAuthenticated != true
            || !int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id))
        {
            cartError = "Please log in to add items to your cart.";
            return;
        }
        if (!decimal.TryParse(product.Price?.Value, NumberStyles.Number, CultureInfo.InvariantCulture, out var price))
        {
            cartError = "This product's price is unavailable.";
            return;
        }

        addingToCart = true;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            using var response = await client.PostAsJsonAsync($"users/{id}/cart", new
            {
                Name = product.Title,
                Price = price,
                Description = product.ShortDescription ?? product.Description
            });
            response.EnsureSuccessStatusCode();
            Nav.NavigateTo("cart");
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            cartError = "Couldn't add this item to your cart. Please check your cart before trying again.";
        }
        finally
        {
            addingToCart = false;
        }
    }

    protected override Task OnParametersSetAsync() => LoadProduct();

    private async Task LoadProduct()
    {
        requestCancellation?.Cancel();
        requestCancellation?.Dispose();
        var cancellation = requestCancellation = new CancellationTokenSource();
        product = null;
        cartError = null;
        error = null;
        loading = true;
        try
        {
            if (string.IsNullOrWhiteSpace(ItemId))
            {
                error = "No product selected.";
                return;
            }
            using var client = HttpClientFactory.CreateClient("Backend");
            using var response = await client.GetAsync("api/products/detail?itemId=" + Uri.EscapeDataString(ItemId), cancellation.Token);
            cancellation.Token.ThrowIfCancellationRequested();
            if (!response.IsSuccessStatusCode)
            {
                error = response.StatusCode == HttpStatusCode.NotFound
                    ? "This product is no longer available." : "Could not load the product. Please try again.";
                return;
            }
            var json = await response.Content.ReadAsStringAsync(cancellation.Token);
            cancellation.Token.ThrowIfCancellationRequested();
            product = JsonSerializer.Deserialize<Products.Product>(json);
            if (string.IsNullOrWhiteSpace(product?.ItemId))
            {
                product = null;
                error = "The product service returned an invalid response.";
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (OperationCanceledException) { error = "The product request timed out. Please try again."; }
        catch (HttpRequestException) { error = "Could not connect to the product service. Please try again."; }
        catch (JsonException) { error = "The product service returned an invalid response."; }
        finally
        {
            if (ReferenceEquals(requestCancellation, cancellation)) loading = false;
        }
    }

    // Keep seller HTML inside an opaque sandbox. Scripts, forms, navigation and
    // external resources are blocked; only inline formatting and embedded images remain.
    private static string DescriptionDocument(string html) =>
        "<!doctype html><html><head><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; img-src data:; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'\">" +
        "<style>body{font:16px/1.5 sans-serif;overflow-wrap:anywhere}img{max-width:100%;height:auto}</style></head><body>" + html + "</body></html>";

    public void Dispose()
    {
        requestCancellation?.Cancel();
        requestCancellation?.Dispose();
    }
}
