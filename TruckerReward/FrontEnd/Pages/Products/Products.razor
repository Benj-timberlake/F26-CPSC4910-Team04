@using System.Net.Http
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Security.Claims
@inject IHttpClientFactory HttpClientFactory


<PageTitle>Product Catalog</PageTitle>

<div class="catalog">
    <h1>Product Catalog</h1>

    <form class="search-bar"
          @onsubmit="SearchProducts"
          @onsubmit:preventDefault="true">

        <input @bind="search"
               placeholder="Search products..."
               aria-label="Search products" />

        <button type="submit" disabled="@loading">
            @(loading ? "Searching..." : "Search")
        </button>
        <fieldset class="catalog-controls" disabled="@loading">
            <legend>Sort and filter products</legend>
            <label for="product-sort">Sort by</label>
            <select id="product-sort" @bind="sort">
                <option value="">Best match</option>
                <option value="price">Points: low to high</option>
                <option value="-price">Points: high to low</option>
                <option value="mostWatched">Popularity</option>
                <option value="availability">Availability</option>
                <option value="newlyListed">Creation date: newest first</option>
            </select>
            <label><input id="available-only" type="checkbox" @bind="availableOnly" /> In stock</label>
        </fieldset>
    </form>

    @if (!string.IsNullOrEmpty(notice))
    {
        <p role="note">@notice</p>
    }

    @if (loading)
    {
        <p role="status">Loading products...</p>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <p role="alert" class="error">@error</p>
    }
    else if (products.Count == 0)
    {
        <p>@(DriverCatalog ? "No catalog products found. Your sponsor may not have added items yet, or no items match your filters." : "No products found. Enter a search or adjust your filters.")</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in products)
            {
                <article class="product-card">
                    @if (!string.IsNullOrWhiteSpace(product.Image?.ImageUrl))
                    {
                        <img src="@product.Image.ImageUrl"
                             alt="@product.Title"
                             loading="lazy" />
                    }
                    else
                    {
                        <div class="no-image">No image available</div>
                    }

                    <h2>@product.Title</h2>
                    <p class="product-price">@(product.Price?.Display ?? "Price unavailable")</p>
                    @if (!string.IsNullOrWhiteSpace(product.ItemId))
                    {
                        <a class="product-link" href="@("/product?itemId=" + Uri.EscapeDataString(product.ItemId))"
                           aria-label="@("View " + product.Title)"></a>
                    }
                    @if (product.WatchCount is not null)
                    {
                        <p>@product.WatchCount watching</p>
                    }
                    @if (product.Availability is not null)
                    {
                        <p>@(product.Availability switch { "IN_STOCK" => "In stock", "LIMITED_STOCK" => "Limited stock", "OUT_OF_STOCK" => "Out of stock", _ => "Availability unknown" })</p>
                    }
                </article>
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool DriverCatalog { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private string search = "";
    private string sort = "";
    private bool availableOnly;
    private bool loading;
    private string? error;
    private string? notice;
    private List<Product> products = new();

    protected override async Task OnInitializedAsync()
    {
        await SearchProducts();
    }

    private async Task SearchProducts()
    {
        if (loading)
            return;

        loading = true;
        error = null;
        notice = null;
        products.Clear();

        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var query = search.Trim();
            if (DriverCatalog)
            {
                await LoadDriverCatalog(client, query);
                return;
            }
            if (query.Length == 0)
            {
                return;
            }
            var url = "api/products?q=" + Uri.EscapeDataString(query);
            if (sort.Length > 0) url += "&sort=" + Uri.EscapeDataString(sort);
            if (availableOnly) url += "&availableOnly=true";
            using var response = await client.GetAsync(url);
            if (!response.IsSuccessStatusCode)
            {
                error = "Could not load eBay products. Please try again.";
                return;
            }

            var json = await response.Content.ReadAsStringAsync();
            var result = JsonSerializer.Deserialize<ProductSearchResponse>(json);
            products = result?.Items ?? new List<Product>();
            notice = result?.Notice;
        }
        catch (HttpRequestException)
        {
            error = "Could not connect to the product service. Please try again.";
        }
        catch (OperationCanceledException)
        {
            error = "The product search timed out. Please try again.";
        }
        catch (JsonException)
        {
            error = "The product service returned an invalid response. Please try again.";
        }
        finally
        {
            loading = false;
        }
    }
    private async Task LoadDriverCatalog(HttpClient client, string query)
    {
        var user = (await AuthState).User;
        if (!user.IsInRole("driver") || !int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id))
        {
            error = "Please log in as a driver to view your catalog.";
            return;
        }
        var itemIds = await client.GetFromJsonAsync<List<string>>($"users/{id}/catalog") ?? [];
        var savedProducts = new List<Product>();
        foreach (var itemId in itemIds.Distinct())
        {
            using var response = await client.GetAsync("api/products/detail?itemId=" + Uri.EscapeDataString(itemId));
            if (!response.IsSuccessStatusCode)
            {
                notice = "Some catalog items are unavailable. Please try again later.";
                continue;
            }
            var item = JsonSerializer.Deserialize<Product>(await response.Content.ReadAsStringAsync());
            if (item is not null && item.ItemId == itemId) savedProducts.Add(item);
        }
        IEnumerable<Product> filtered = savedProducts.Where(item => query.Length == 0
            || item.Title.Contains(query, StringComparison.OrdinalIgnoreCase)
            || (item.ShortDescription?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false));
        if (availableOnly) filtered = filtered.Where(item => item.Availability is "IN_STOCK" or "LIMITED_STOCK"
            || item.EstimatedAvailabilities?.Any(stock => stock.Status is "IN_STOCK" or "LIMITED_STOCK") == true);
        filtered = sort switch
        {
            "price" => filtered.OrderBy(item => PriceForSort(item) ?? decimal.MaxValue),
            "-price" => filtered.OrderByDescending(item => PriceForSort(item) ?? decimal.MinValue),
            "mostWatched" => filtered.OrderByDescending(item => item.WatchCount),
            "newlyListed" => filtered.OrderByDescending(item => item.CreationDate),
            "availability" => filtered.OrderBy(item => item.Availability is "IN_STOCK" or "LIMITED_STOCK"
                || item.EstimatedAvailabilities?.Any(stock => stock.Status is "IN_STOCK" or "LIMITED_STOCK") == true ? 0 : 1),
            _ => filtered
        };
        products = filtered.ToList();
    }

    private static decimal? PriceForSort(Product item) =>
        item.Price is not null && item.Price.TryGetDollars(out var dollars) ? dollars : null;

    public class StockAvailability
    {
        [JsonPropertyName("estimatedAvailabilityStatus")]
        public string? Status { get; set; }
    }

    public class ProductSearchResponse
    {
        [JsonPropertyName("catalogNotice")]
        public string? Notice { get; set; }
        [JsonPropertyName("itemSummaries")]
        public List<Product>? Items { get; set; }
    }

    public class Product
    {
        [JsonPropertyName("estimatedAvailabilities")]
        public List<StockAvailability>? EstimatedAvailabilities { get; set; }
        [JsonPropertyName("itemCreationDate")]
        public DateTimeOffset? CreationDate { get; set; }
        [JsonPropertyName("itemId")]
        public string? ItemId { get; set; }

        [JsonPropertyName("price")]
        public FrontEnd.Shared.ProductPrice? Price { get; set; }

        [JsonPropertyName("description")]
        public string? Description { get; set; }

        [JsonPropertyName("shortDescription")]
        public string? ShortDescription { get; set; }
        [JsonPropertyName("watchCount")]
        public long? WatchCount { get; set; }

        [JsonPropertyName("availability")]
        public string? Availability { get; set; }
        [JsonPropertyName("title")]
        public string Title { get; set; } = "";

        [JsonPropertyName("image")]
        public ProductImage? Image { get; set; }
    }

    public class ProductImage
    {
        [JsonPropertyName("imageUrl")]
        public string ImageUrl { get; set; } = "";
    }
}
