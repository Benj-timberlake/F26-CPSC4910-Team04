@page "/profile"
@attribute [Authorize]
@using System.Security.Claims
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<PageTitle>Profile</PageTitle>

<div class="tr-page">
    <h1>Profile</h1>
    @if (loadError is not null)
    {
        <p role="alert" class="tr-alert-error">@loadError</p>
    }
    else if (account is null || activity is null)
    {
        <p role="status"><em>Loading your account...</em></p>
    }
    else
    {
        @if (notice is not null)
        {
            <p role="status" class="tr-alert-success">@notice</p>
        }
        <div class="tr-cards">
            <section class="tr-card">
                <div class="account-heading">
                    <h2>@AccountLabel(account.UserType)</h2>
                    <a class="tr-btn account-edit" href="account/profile">Edit</a>
                </div>
                <dl class="tr-kv">
                    @if ((account.UserType == "sponsor" || account.UserType == "driver") &&
                        ((account.CompanyNames?.Count ?? 0) > 0 || !string.IsNullOrWhiteSpace(account.CompanyName)))
                    {
                        <dt>Company</dt>
                        <dd>@((account.CompanyNames?.Count ?? 0) > 0 ? string.Join(", ", account.CompanyNames!) : account.CompanyName)</dd>
                    }
                    <dt>Username</dt>
                    <dd>@account.Username</dd>
                    <dt>Email</dt>
                    <dd>
                        @account.Email
                        @if (!account.EmailConfirmed)
                        {
                            <span class="unconfirmed">Not confirmed</span>
                            <button type="button" class="tr-btn-outline resend" disabled="@sending" @onclick="ResendConfirmation">Send the link again</button>
                        }
                    </dd>
                    <dt>Password</dt>
                    <dd>---------------</dd>
                    <dt>Name</dt>
                    <dd>@account.FirstName @account.LastName</dd>
                    <dt>Phone</dt>
                    <dd>@Shown(account.PhoneNumber)</dd>
                    <dt>Address</dt>
                    <dd>@Shown(account.Address)</dd>
                </dl>
            </section>

            @if (account.UserType == "driver")
            {
                <section class="tr-card">
                    <div class="company-card-heading">
                        <h2>Company</h2>
                    </div>
                    @if (account.CompanyId is not null)
                    {
                        <ul class="driver-company-list">
                            @foreach (var company in account.Companies ?? [])
                            {
                                <li>
                                    <span>@company.Name</span>
                                    @if (company.CurrentCompanyViewed)
                                    {
                                        <span class="current-company-badge">Currently viewing</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="tr-btn" disabled="@(switchingCompanyId is not null)" @onclick="() => SwitchCompany(company.Id)">
                                            @(switchingCompanyId == company.Id ? "Switching..." : "Switch here")
                                        </button>
                                    }
                                </li>
                            }
                            @foreach (var pendingCompany in PendingCompanyRows)
                            {
                                <li class="pending-company-item">
                                    <strong class="pending-company-label" title="@pendingCompany.Name">@pendingCompany.Name</strong>
                                    <div class="pending-company-actions">
                                        <span class="pending-badge">Pending...</span>
                                        <button type="button" class="pending-remove-button" @onclick="() => OpenCancelApplication(pendingCompany)">Cancel</button>
                                    </div>
                                </li>
                            }
                        </ul>
                        @if (companySwitchError is not null)
                        {
                            <p role="alert" class="tr-alert-error">@companySwitchError</p>
                        }
                        <button type="button" class="tr-btn" @onclick="ShowCompanyModal">Apply To Another Company</button>
                    }
                    else if (PendingCompanyRows.Count > 0)
                    {
                        <ul class="driver-company-list pending-only-company-list">
                            @foreach (var pendingCompany in PendingCompanyRows)
                            {
                                <li class="pending-company-item">
                                    <strong class="pending-company-label" title="@pendingCompany.Name">@pendingCompany.Name</strong>
                                    <div class="pending-company-actions">
                                        <span class="pending-badge">Pending...</span>
                                        <button type="button" class="pending-remove-button" @onclick="() => OpenCancelApplication(pendingCompany)">Cancel</button>
                                    </div>
                                </li>
                            }
                        </ul>
                        <p class="pending-help">Your application is waiting for review.</p>
                        <button type="button" class="tr-btn" @onclick="ShowCompanyModal">Apply To Another Company</button>
                    }
                    else
                    {
                        <p>You are not currently associated with a company.</p>
                        <button type="button" class="tr-btn" @onclick="ShowCompanyModal">Apply To Company</button>
                    }
                </section>
            }

            <section class="tr-card">
                <h2>Security</h2>
                @if (activity.FailedSincePreviousLogin > 0)
                {
                    <p role="alert" class="tr-alert-warning">
                        @activity.FailedSincePreviousLogin failed sign-in @(activity.FailedSincePreviousLogin == 1 ? "attempt" : "attempts")
                        on your account since your previous sign-in. If that wasn't you, change your password.
                    </p>
                }
                <dl class="tr-kv">
                    <dt>This sign-in</dt>
                    <dd>@When(activity.LastLoginAt)@Ip(activity.LastLoginIp)</dd>
                    <dt>Previous sign-in</dt>
                    <dd>@(activity.PreviousLoginAt is null ? "This is your first sign-in." : When(activity.PreviousLoginAt))</dd>
                    <dt>Password</dt>
                    <dd>@(activity.PasswordChangedAt is null ? "Not changed since you signed up." : "Changed " + When(activity.PasswordChangedAt))</dd>
                </dl>
                <nav class="profile-security-actions" aria-label="Account security settings">
                    <a class="tr-btn-outline profile-security-link" href="account/passkeys">Face ID and passkeys</a>
                    <a class="tr-btn-outline profile-security-link" href="account/sign-in-codes">Sign-in codes: @(account.EmailCodes ? "on" : "off")</a>
                    <a class="tr-btn-outline profile-security-link" href="account/devices">Devices</a>
                    <a class="tr-btn-outline profile-security-link" href="account/data">Your data</a>
                </nav>
                <form method="post" action="account/logout-everywhere" class="logout-everywhere">
                    <button type="submit" class="tr-btn-outline">Sign out everywhere</button>
                    <span class="tr-muted">Ends every session, this one too. Others can take up to five minutes.</span>
                </form>

                @if (activity.Recent.Count > 0)
                {
                    <details>
                        <summary>Recent attempts</summary>
                        <table class="tr-table">
                            <thead>
                                <tr>
                                    <th>When</th>
                                    <th>Result</th>
                                    <th>IP</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in activity.Recent)
                                {
                                    <tr class="@(a.Succeeded ? "" : "failed")">
                                        <td>@When(a.AttemptedAt)</td>
                                        <td>@(a.Succeeded ? "Signed in" : "Failed")</td>
                                        <td>@(a.IpAddress ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </details>
                }
            </section>
        </div>
    }
</div>

@if (showCompanyModal)
{
    <div class="company-backdrop" @onclick="CloseCompanyModal">
        <section class="company-dialog" role="dialog" aria-modal="true" aria-labelledby="company-title" @onclick:stopPropagation="true">
            <button type="button" class="company-close-button" aria-label="Close" title="Close" @onclick="CloseCompanyModal">×</button>
            <h2 id="company-title">Apply To Company</h2>
            <p>Select a company:</p>
            @if (companyLoadError is not null)
            {
                <p role="alert" class="tr-alert-error">@companyLoadError</p>
            }
            else if (AvailableCompanies.Count == 0)
            {
                <p>No other companies are available to apply to.</p>
            }
            else
            {
                <fieldset class="company-options">
                    <legend class="visually-hidden">Available companies</legend>
                    @foreach (var company in AvailableCompanies)
                    {
                        <div class="company-option-group">
                            <button type="button" role="radio" aria-checked="@(selectedCompanyId == company.Id)"
                                    class="company-option @(selectedCompanyId == company.Id ? "selected" : "")"
                                    @onclick="() => SelectCompany(company.Id)">
                                <span class="company-option-name">@company.Name</span>
                                <span class="company-option-description">@(string.IsNullOrWhiteSpace(company.Description) ? "No description available." : company.Description)</span>
                            </button>
                            @if (selectedCompanyId == company.Id)
                            {
                                <div class="selected-company-application">
                                    <CdlLicenseUpload Id="profile-application-cdl-license" />
                                    <label class="extra-info-label" for="profile-application-extra-info">Extra Info <span>(optional)</span></label>
                                    <textarea id="profile-application-extra-info" class="extra-info-input" @bind="applicantExtraInfo" rows="4" maxlength="4000"></textarea>
                                    @if (applicationError is not null)
                                    {
                                        <p role="alert" class="tr-alert-error">@applicationError</p>
                                    }
                                    <button type="button" class="tr-btn" disabled="@isSubmitting" @onclick="SubmitApplication">
                                        @(isSubmitting ? "Submitting..." : "Apply")
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </fieldset>
            }
        </section>
    </div>
}

@if (showCancelApplicationModal)
{
    <div class="company-backdrop" @onclick="CloseCancelApplication">
        <section class="company-dialog" role="dialog" aria-modal="true" aria-labelledby="cancel-application-title" @onclick:stopPropagation="true">
            <button type="button" class="company-close-button" aria-label="Close" title="Close" @onclick="CloseCancelApplication">×</button>
            <h2 id="cancel-application-title">Cancel company application</h2>
            <p>Cancel your application to @cancelCompanyName?</p>
            <form @onsubmit="CancelPendingApplication" @onsubmit:preventDefault="true">
                <label class="extra-info-label" for="cancel-application-reason">Response reason <span>(required)</span></label>
                <textarea id="cancel-application-reason" class="extra-info-input" @bind="cancellationReason" rows="4" maxlength="4000" required></textarea>
                @if (cancellationError is not null)
                {
                    <p role="alert" class="tr-alert-error">@cancellationError</p>
                }
                <button type="submit" class="cancel-submit-button" disabled="@isCancelling">
                    @(isCancelling ? "Canceling..." : "Cancel Application")
                </button>
            </form>
        </section>
    </div>
}

<style>
    .logout-everywhere {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
        margin-bottom: 16px;
    }

    .tr-kv dd a {
        margin-left: 8px;
    }

    .profile-security-actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0; }
    .profile-security-link { display: inline-flex; align-items: center; justify-content: center; margin: 0 !important; text-decoration: none; }

    .account-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .account-heading h2 {
        margin-bottom: 12px;
    }

    .account-edit {
        margin-bottom: 12px;
    }

    details {
        margin-top: 14px;
    }

    summary {
        cursor: pointer;
        font-weight: 600;
    }

    .unconfirmed {
        margin-left: 8px;
        color: #7a3e00;
        font-size: 13px;
        font-weight: 600;
    }

    .tr-kv dd .resend {
        margin-left: 8px;
        padding: 2px 8px;
        font-size: 13px;
    }

    details .tr-table {
        margin-top: 8px;
    }

    .company-card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
    .company-card-heading h2 { margin: 0 0 12px; }
    .driver-company-list { list-style: none; padding: 0; margin: 0 0 14px; }
    .driver-company-list li { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid #e3e7ee; }
    .driver-company-list li.pending-company-item { gap: 8px; }
    .pending-company-label { flex: 1 1 auto; min-width: 0; overflow: hidden; font-size: inherit; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
    .pending-company-actions { display: flex; flex: 0 0 auto; align-items: center; gap: 8px; }
    .pending-remove-button { padding: 5px 10px; border: 1px solid #efcaca; border-radius: 6px; background: #fff8f8; color: #a32c2c; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }
    .pending-remove-button:hover, .pending-remove-button:focus-visible { background: #feecec; border-color: #e4aaaa; }
    .pending-only-company-list { margin-bottom: 8px; }
    .current-company-badge { color: #176b3a; font-size: 13px; font-weight: 700; }
    .pending-help { color: #725a2b; margin: 8px 0 0; }
    .pending-badge { display: inline-block; padding: 4px 9px; border-radius: 20px; background: #fbf0cf; color: #8a641e; font-size: 12px; font-weight: 700; vertical-align: middle; }
    .cancel-submit-button { border: 1px solid #b42318; border-radius: 6px; background: #b42318; color: white; padding: 6px 11px; font-size: 13px; font-weight: 600; cursor: pointer; }
    .cancel-submit-button { display: block; margin-left: auto; padding: 9px 14px; }
    .cancel-submit-button:disabled { opacity: .65; cursor: wait; }
    .company-backdrop { position: fixed; inset: 0; z-index: 1050; background: #0009; display: flex; align-items: center; justify-content: center; padding: 20px; }
    .company-dialog { position: relative; background: white; color: #222; border-radius: 12px; padding: 24px; width: 100%; max-width: 520px; max-height: 90vh; overflow: auto; box-shadow: 0 12px 40px #0005; }
    .company-close-button { position: absolute; top: 12px; right: 12px; width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid #b8bec7; border-radius: 9px; background: #f1f2f4; color: #666; font-size: 24px; line-height: 1; cursor: pointer; }
    .company-close-button:hover { background: #e5e7eb; color: #444; }
    .company-options { display: grid; gap: 10px; margin: 0 0 20px; border: 0; padding: 0; }
    .company-option-group { display: grid; gap: 0; }
    .company-option { display: grid; gap: 5px; width: 100%; padding: 12px 14px; text-align: left; color: #222; background: white; border: 1px solid #b8c0cc; border-radius: 8px; }
    .company-option.selected { border-color: var(--brand); box-shadow: 0 0 0 2px var(--brand); border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
    .selected-company-application { padding: 14px; border: 1px solid var(--brand); border-top: 0; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; background: #f8faff; }
    .company-option-name { font-weight: 700; }
    .company-option-description { color: #555; font-weight: 400; }
    .extra-info-label { display: block; font-weight: 600; margin: 0 0 6px; }
    .extra-info-label span { color: #687385; font-size: 13px; font-weight: 400; }
    .extra-info-input { display: block; width: 100%; resize: vertical; padding: 10px; border: 1px solid #b8c0cc; border-radius: 8px; margin-bottom: 14px; font: inherit; }

</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Account? account;
    private SecuritySummary? activity;
    private string? loadError;
    private string? notice;
    private bool sending;
    private int? switchingCompanyId;
    private string? companySwitchError;
    private List<CompanyOption>? companies;
    private int? selectedCompanyId;
    private bool showCompanyModal;
    private string? companyLoadError;
    private string? applicantExtraInfo;
    private string? applicationError;
    private bool isSubmitting;
    private bool showCancelApplicationModal;
    private int? cancelCompanyId;
    private string? cancelCompanyName;
    private string cancellationReason = "";
    private string? cancellationError;
    private bool isCancelling;
    private List<CompanyOption> AvailableCompanies => (companies ?? [])
        .Where(company => !(account?.Companies ?? []).Any(membership => membership.Id == company.Id))
        .Where(company => !(account?.PendingCompanies ?? []).Any(pending => pending.Id == company.Id))
        .ToList();
    private List<PendingCompany> PendingCompanyRows
    {
        get
        {
            if (account?.PendingCompanies is { Count: > 0 } pendingCompanies)
                return pendingCompanies;
            if (string.IsNullOrWhiteSpace(account?.PendingCompanyName))
                return [];
            var company = companies?.FirstOrDefault(option => string.Equals(option.Name, account.PendingCompanyName, StringComparison.OrdinalIgnoreCase));
            return [new PendingCompany(company?.Id ?? 0, account.PendingCompanyName)];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["password"] == "changed")
            notice = "Your password has been changed.";
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["username"] == "changed")
            notice = "Your username has been changed.";
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["profile"] == "updated")
            notice = "Your account information has been updated.";
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["email"] == "changed")
            notice = "Your email address has been changed.";
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["codes"] is { } codes && codes is "on" or "off")
            notice = $"Sign-in codes are {codes}.";

        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        using var client = HttpClientFactory.CreateClient("Backend");
        try
        {
            account = await client.GetFromJsonAsync<Account>($"users/{id}");
            if (account?.UserType == "driver")
            {
                try
                {
                    var pendingCompanies = await client.GetFromJsonAsync<List<PendingCompany>>($"users/{id}/pending-applications");
                    if (pendingCompanies is not null)
                        account = account with
                        {
                            PendingCompanies = pendingCompanies,
                            PendingCompanyName = pendingCompanies.FirstOrDefault()?.Name
                        };
                }
                catch (HttpRequestException)
                {
                    // Retain the summary response while an older backend instance is restarting.
                }
            }
            activity = await client.GetFromJsonAsync<SecuritySummary>($"users/{id}/security");
        }
        catch (HttpRequestException)
        {
            loadError = "Couldn't load your account right now. Try again in a moment.";
        }
    }

    private static string AccountLabel(string userType) => userType switch
    {
        "driver" => "Driver account",
        "sponsor" => "Sponsor account",
        "admin" => "Administrator account",
        _ => "Account"
    };

    private static string Shown(string? value) => string.IsNullOrWhiteSpace(value) ? "Not provided" : value;

    private static string Ip(string? ip) => string.IsNullOrEmpty(ip) ? "" : $" from {ip}";

    // stored in utc, shown as an absolute time plus how long ago so it reads at a glance
    private static string When(DateTime? utc)
    {
        if (utc is null) return "—";
        var t = DateTime.SpecifyKind(utc.Value, DateTimeKind.Utc);
        var ago = DateTime.UtcNow - t;
        var rel = ago.TotalSeconds < 60 ? "just now"
            : ago.TotalMinutes < 60 ? $"{(int)ago.TotalMinutes} min ago"
            : ago.TotalHours < 24 ? $"{(int)ago.TotalHours} h ago"
            : ago.TotalDays < 30 ? $"{(int)ago.TotalDays} d ago"
            : "";
        var abs = t.ToString("yyyy-MM-dd HH:mm") + " UTC";
        return rel == "" ? abs : $"{abs} ({rel})";
    }

    private sealed record Account(int Id, string UserType, string Username, string FirstName, string LastName, string Email, string PhoneNumber, string Address, string? CompanyName, List<string>? CompanyNames, List<CompanyMembership>? Companies, int? CompanyId, int Points, string? PendingCompanyName, bool EmailConfirmed = true, bool EmailCodes = false, List<PendingCompany>? PendingCompanies = null);
    private sealed record CompanyMembership(int Id, string Name, bool CurrentCompanyViewed, long Points);
    private sealed record PendingCompany(int Id, string Name);
    private sealed record CompanyOption(int Id, string Name, string? Description);
    private sealed record CreateApplicationRequest(int CompanyId, string? ApplicantExtraInfo);
    private sealed record CancelApplicationRequest(string Reasoning, int? CompanyId = null);

    private async Task ShowCompanyModal()
    {
        selectedCompanyId = null;
        applicantExtraInfo = null;
        applicationError = null;
        companyLoadError = null;
        if (companies is null)
        {
            try
            {
                using var client = HttpClientFactory.CreateClient("Backend");
                companies = await client.GetFromJsonAsync<List<CompanyOption>>("companies") ?? [];
            }
            catch (HttpRequestException)
            {
                companyLoadError = "Couldn't load companies right now. Try again in a moment.";
            }
        }
        showCompanyModal = true;
    }

    private void CloseCompanyModal() => showCompanyModal = false;
    private void SelectCompany(int companyId) { selectedCompanyId = companyId; applicationError = null; }

    private async Task SubmitApplication()
    {
        if (selectedCompanyId is null || isSubmitting || account is null)
            return;
        isSubmitting = true;
        applicationError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync($"users/{account.Id}/applications",
                new CreateApplicationRequest(selectedCompanyId.Value, applicantExtraInfo));
            if (!response.IsSuccessStatusCode)
            {
                applicationError = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "You already have an application on file."
                    : "Couldn't submit your application. Please try again.";
                return;
            }
            var company = AvailableCompanies.FirstOrDefault(option => option.Id == selectedCompanyId.Value);
            var pending = new PendingCompany(selectedCompanyId.Value, company?.Name ?? "Company");
            account = account with
            {
                PendingCompanyName = pending.Name,
                PendingCompanies = [pending, .. account.PendingCompanies ?? []]
            };
            companies ??= [];
            showCompanyModal = false;
            notice = "Your company application has been submitted.";
        }
        catch (HttpRequestException)
        {
            applicationError = "Couldn't submit your application right now. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OpenCancelApplication(PendingCompany pendingCompany)
    {
        cancellationReason = "";
        cancellationError = null;
        cancelCompanyId = pendingCompany.Id > 0 ? pendingCompany.Id : null;
        cancelCompanyName = pendingCompany.Name;
        showCancelApplicationModal = true;
    }

    private void CloseCancelApplication()
    {
        if (!isCancelling)
            showCancelApplicationModal = false;
    }

    private async Task CancelPendingApplication()
    {
        if (isCancelling || account is null)
            return;
        if (string.IsNullOrWhiteSpace(cancellationReason))
        {
            cancellationError = "Please provide a response reason.";
            return;
        }
        isCancelling = true;
        cancellationError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsJsonAsync($"users/{account.Id}/applications/cancel",
                new CancelApplicationRequest(cancellationReason.Trim(), cancelCompanyId));
            if (!response.IsSuccessStatusCode)
            {
                cancellationError = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "No active application was found to cancel."
                    : "Couldn't cancel your application. Please try again.";
                return;
            }
            var remaining = (account.PendingCompanies ?? [])
                .Where(company => cancelCompanyId is null || company.Id != cancelCompanyId.Value)
                .ToList();
            account = account with
            {
                PendingCompanies = remaining,
                PendingCompanyName = remaining.FirstOrDefault()?.Name
            };
            showCancelApplicationModal = false;
            cancelCompanyId = null;
            cancelCompanyName = null;
            notice = "Your company application was canceled.";
        }
        catch (HttpRequestException)
        {
            cancellationError = "Couldn't cancel your application right now. Please try again.";
        }
        finally
        {
            isCancelling = false;
        }
    }

    private async Task SwitchCompany(int companyId)
    {
        if (switchingCompanyId is not null || account is null) return;
        switchingCompanyId = companyId;
        companySwitchError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsync($"users/{account.Id}/companies/{companyId}/switch", null);
            if (!response.IsSuccessStatusCode)
            {
                companySwitchError = "Couldn't switch companies. Please try again.";
                return;
            }
            account = await client.GetFromJsonAsync<Account>($"users/{account.Id}");
            notice = "Your current company has been switched.";
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            companySwitchError = "Couldn't switch companies right now. Please try again.";
        }
        finally { switchingCompanyId = null; }
    }

    private async Task ResendConfirmation()
    {
        sending = true;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsync($"users/{account!.Id}/email/confirmation", null);
            notice = (await response.Content.ReadFromJsonAsync<Problem>())?.Message ?? "That didn't work.";
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            notice = "Couldn't reach the server. Try again in a moment.";
        }
        sending = false;
    }

    private sealed record Problem(string? Message);
    private sealed record LoginEvent(DateTime AttemptedAt, bool Succeeded, string? IpAddress);
    private sealed record SecuritySummary(DateTime? LastLoginAt, string? LastLoginIp, DateTime? PreviousLoginAt, int FailedSincePreviousLogin, List<LoginEvent> Recent, DateTime? PasswordChangedAt);
}
