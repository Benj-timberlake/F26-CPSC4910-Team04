@page "/profile"
@attribute [Authorize]
@using System.Security.Claims
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<PageTitle>Profile</PageTitle>

<div class="tr-page">
    <h1>Profile</h1>
    @if (loadError is not null)
    {
        <p role="alert" class="tr-alert-error">@loadError</p>
    }
    else if (account is null || activity is null)
    {
        <p role="status"><em>Loading your account...</em></p>
    }
    else
    {
        @if (notice is not null)
        {
            <p role="status" class="tr-alert-success">@notice</p>
        }
        <div class="tr-cards">
            <section class="tr-card">
                <div class="account-heading">
                    <h2>@AccountLabel(account.UserType)</h2>
                    <a class="tr-btn account-edit" href="account/profile">Edit</a>
                </div>
                <dl class="tr-kv">
                    @if ((account.UserType == "sponsor" || account.UserType == "driver") &&
                        ((account.CompanyNames?.Count ?? 0) > 0 || !string.IsNullOrWhiteSpace(account.CompanyName)))
                    {
                        <dt>Company</dt>
                        <dd>@((account.CompanyNames?.Count ?? 0) > 0 ? string.Join(", ", account.CompanyNames!) : account.CompanyName)</dd>
                    }
                    <dt>Username</dt>
                    <dd>@account.Username</dd>
                    <dt>Email</dt>
                    <dd>
                        @account.Email
                        @if (!account.EmailConfirmed)
                        {
                            <span class="unconfirmed">Not confirmed</span>
                            <button type="button" class="tr-btn-outline resend" disabled="@sending" @onclick="ResendConfirmation">Send the link again</button>
                        }
                    </dd>
                    <dt>Password</dt>
                    <dd>---------------</dd>
                    <dt>Name</dt>
                    <dd>@account.FirstName @account.LastName</dd>
                    <dt>Phone</dt>
                    <dd>@Shown(account.PhoneNumber)</dd>
                    <dt>Address</dt>
                    <dd>@Shown(account.Address)</dd>
                </dl>
            </section>

            <section class="tr-card">
                <h2>Security</h2>
                @if (activity.FailedSincePreviousLogin > 0)
                {
                    <p role="alert" class="tr-alert-warning">
                        @activity.FailedSincePreviousLogin failed sign-in @(activity.FailedSincePreviousLogin == 1 ? "attempt" : "attempts")
                        on your account since your previous sign-in. If that wasn't you, change your password.
                    </p>
                }
                <dl class="tr-kv">
                    <dt>This sign-in</dt>
                    <dd>@When(activity.LastLoginAt)@Ip(activity.LastLoginIp)</dd>
                    <dt>Previous sign-in</dt>
                    <dd>@(activity.PreviousLoginAt is null ? "This is your first sign-in." : When(activity.PreviousLoginAt))</dd>
                    <dt>Password</dt>
                    <dd>@(activity.PasswordChangedAt is null ? "Not changed since you signed up." : "Changed " + When(activity.PasswordChangedAt))</dd>
                </dl>
                <p><a class="passkeys-link" href="account/passkeys">Face ID and passkeys</a> &middot; <a class="codes-link" href="account/sign-in-codes">Sign-in codes: @(account.EmailCodes ? "on" : "off")</a> &middot; <a class="devices-link" href="account/devices">Devices</a></p>
                <form method="post" action="account/logout-everywhere" class="logout-everywhere">
                    <button type="submit" class="tr-btn-outline">Sign out everywhere</button>
                    <span class="tr-muted">Ends every session, this one too. Others can take up to five minutes.</span>
                </form>

                @if (activity.Recent.Count > 0)
                {
                    <details>
                        <summary>Recent attempts</summary>
                        <table class="tr-table">
                            <thead>
                                <tr>
                                    <th>When</th>
                                    <th>Result</th>
                                    <th>IP</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in activity.Recent)
                                {
                                    <tr class="@(a.Succeeded ? "" : "failed")">
                                        <td>@When(a.AttemptedAt)</td>
                                        <td>@(a.Succeeded ? "Signed in" : "Failed")</td>
                                        <td>@(a.IpAddress ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </details>
                }
            </section>
        </div>
    }
</div>

<style>
    .logout-everywhere {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
        margin-bottom: 16px;
    }

    .tr-kv dd a {
        margin-left: 8px;
    }

    .account-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .account-heading h2 {
        margin-bottom: 12px;
    }

    .account-edit {
        margin-bottom: 12px;
    }

    details {
        margin-top: 14px;
    }

    summary {
        cursor: pointer;
        font-weight: 600;
    }

    .unconfirmed {
        margin-left: 8px;
        color: #7a3e00;
        font-size: 13px;
        font-weight: 600;
    }

    .tr-kv dd .resend {
        margin-left: 8px;
        padding: 2px 8px;
        font-size: 13px;
    }

    details .tr-table {
        margin-top: 8px;
    }

</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Account? account;
    private SecuritySummary? activity;
    private string? loadError;
    private string? notice;
    private bool sending;

    protected override async Task OnInitializedAsync()
    {
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["password"] == "changed")
            notice = "Your password has been changed.";
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["username"] == "changed")
            notice = "Your username has been changed.";
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["profile"] == "updated")
            notice = "Your account information has been updated.";
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["email"] == "changed")
            notice = "Your email address has been changed.";
        if (System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["codes"] is { } codes && codes is "on" or "off")
            notice = $"Sign-in codes are {codes}.";

        var user = (await AuthState).User;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        using var client = HttpClientFactory.CreateClient("Backend");
        try
        {
            account = await client.GetFromJsonAsync<Account>($"users/{id}");
            activity = await client.GetFromJsonAsync<SecuritySummary>($"users/{id}/security");
        }
        catch (HttpRequestException)
        {
            loadError = "Couldn't load your account right now. Try again in a moment.";
        }
    }

    private static string AccountLabel(string userType) => userType switch
    {
        "driver" => "Driver account",
        "sponsor" => "Sponsor account",
        "admin" => "Administrator account",
        _ => "Account"
    };

    private static string Shown(string? value) => string.IsNullOrWhiteSpace(value) ? "Not provided" : value;

    private static string Ip(string? ip) => string.IsNullOrEmpty(ip) ? "" : $" from {ip}";

    // stored in utc, shown as an absolute time plus how long ago so it reads at a glance
    private static string When(DateTime? utc)
    {
        if (utc is null) return "—";
        var t = DateTime.SpecifyKind(utc.Value, DateTimeKind.Utc);
        var ago = DateTime.UtcNow - t;
        var rel = ago.TotalSeconds < 60 ? "just now"
            : ago.TotalMinutes < 60 ? $"{(int)ago.TotalMinutes} min ago"
            : ago.TotalHours < 24 ? $"{(int)ago.TotalHours} h ago"
            : ago.TotalDays < 30 ? $"{(int)ago.TotalDays} d ago"
            : "";
        var abs = t.ToString("yyyy-MM-dd HH:mm") + " UTC";
        return rel == "" ? abs : $"{abs} ({rel})";
    }

    private sealed record Account(int Id, string UserType, string Username, string FirstName, string LastName, string Email, string PhoneNumber, string Address, string? CompanyName, List<string>? CompanyNames, int? CompanyId, int Points, string? PendingCompanyName, bool EmailConfirmed = true, bool EmailCodes = false);

    private async Task ResendConfirmation()
    {
        sending = true;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.PostAsync($"users/{account!.Id}/email/confirmation", null);
            notice = (await response.Content.ReadFromJsonAsync<Problem>())?.Message ?? "That didn't work.";
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            notice = "Couldn't reach the server. Try again in a moment.";
        }
        sending = false;
    }

    private sealed record Problem(string? Message);
    private sealed record LoginEvent(DateTime AttemptedAt, bool Succeeded, string? IpAddress);
    private sealed record SecuritySummary(DateTime? LastLoginAt, string? LastLoginIp, DateTime? PreviousLoginAt, int FailedSincePreviousLogin, List<LoginEvent> Recent, DateTime? PasswordChangedAt);
}
