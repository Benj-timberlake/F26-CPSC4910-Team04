@page "/register"
@inject NavigationManager Nav
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Create account</PageTitle>

<div class="tr-page-narrow">
    <div class="tr-card">
        <h1>Create account</h1>

        @if (!string.IsNullOrEmpty(error))
        {
            <p role="alert" class="tr-alert-error">@error</p>
        }

        <form class="tr-form" method="post" action="account/register">
            <label for="userType">I am a</label>
            <select id="userType" name="userType" @bind="userType">
                <option value="driver">Driver</option>
                <option value="sponsor">Sponsor</option>
            </select>

            @if (userType == "driver" && companies.Count > 0)
            {
                <label for="companyId">Sponsor</label>
                <select id="companyId" name="companyId" required>
                    <option value="">Pick the sponsor you drive for</option>
                    @foreach (var c in companies)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                <p class="help">Your sponsor reviews your application before you can earn points.</p>
            }

            <label for="username">Username</label>
            <input id="username" name="username" required autocomplete="username" />

            <label for="firstName">First name</label>
            <input id="firstName" name="firstName" required autocomplete="given-name" />

            <label for="lastName">Last name</label>
            <input id="lastName" name="lastName" required autocomplete="family-name" />

            <label for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" />

            <label for="password">Password</label>
            <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" passwordrules="minlength: 8; required: lower; required: upper; required: digit; required: special;" />
            <p class="help">@policy</p>

            <label for="phoneNumber">Phone</label>
            <input id="phoneNumber" name="phoneNumber" type="tel" autocomplete="tel" />

            <label for="address">Address</label>
            <input id="address" name="address" autocomplete="street-address" />

            <button type="submit" class="tr-btn tr-btn-block">Create account</button>
        </form>
    </div>

    <p class="tr-alt">Already have an account? <a href="login">Log in</a></p>
</div>

@code {
    private string userType = "driver";
    private string? error;
    private string? policy;
    private List<Company> companies = [];

    protected override async Task OnInitializedAsync()
    {
        error = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["error"];
        policy = await PasswordPolicyText.Load(HttpClientFactory);
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            companies = await client.GetFromJsonAsync<List<Company>>("companies") ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            // drivers can still apply from their dashboard
        }
    }

    private sealed record Company(int Id, string Name);
}
