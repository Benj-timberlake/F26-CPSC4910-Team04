@page "/reset-password"
@inject NavigationManager Nav
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Choose a new password</PageTitle>

<div class="tr-page-narrow">
    <div class="tr-card">
        <h1>Choose a new password</h1>

        @if (string.IsNullOrEmpty(token))
        {
            <p role="alert" class="tr-alert-error">This link is missing its token. Open the link from the email again or <a href="forgot-password">request a new one</a>.</p>
        }
        else
        {
            @if (error is not null)
            {
                <p role="alert" class="tr-alert-error">@error</p>
            }
            <form class="tr-form" method="post" action="account/reset">
                <input type="hidden" name="token" value="@token" />
                <NewPasswordFields Policy="@policy" />
                <button type="submit" class="tr-btn tr-btn-block">Set password</button>
            </form>
        }
    </div>

    <p class="tr-alt"><a href="login">Back to log in</a></p>
</div>

@code {
    private string? token;
    private string? error;
    private string? policy;

    protected override async Task OnInitializedAsync()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        token = query["token"];
        error = query["error"];
        policy = await PasswordPolicyText.Load(HttpClientFactory);
    }
}
