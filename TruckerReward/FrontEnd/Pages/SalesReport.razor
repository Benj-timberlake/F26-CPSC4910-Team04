@page "/admin/reports"
@attribute [Authorize(Roles = "admin")]
@inherits BackendPage
@inject IJSRuntime Js

<PageTitle>Sales Report</PageTitle>

<div class="tr-page">
    <h1>Sales Report</h1>
    <p class="tr-muted">Points and dollars spent on driver orders, by sponsor or by driver. Rejected and refunded orders are left out. Dates are in UTC.</p>

    <form class="sales-filters" @onsubmit="Load" @onsubmit:preventDefault="true">
        @if (byDriver)
        {
            <fieldset class="sales-pick">
                <legend>Drivers</legend>
                <label class="filter-field">
                    <span>Sponsor</span>
                    <select id="driver-sponsor" value="@driverCompany" @onchange="PickSponsor">
                        <option value="0">Choose a sponsor</option>
                        @foreach (var c in companies)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </label>
                @if (driverCompany != 0)
                {
                    <input id="driver-search" type="search" placeholder="Search drivers by name" aria-label="Search drivers by name"
                        @bind="driverSearch" @bind:event="oninput" />
                    <p class="sales-count" role="status">@Count(allDrivers, pickedDrivers.Count, drivers.Count, "driver")</p>
                    <div class="sales-options-list">
                        <label class="tr-check"><input id="drivers-all" type="checkbox" checked="@allDrivers" @onchange="e => allDrivers = Clear((bool)e.Value!, pickedDrivers)" /> All drivers</label>
                        @foreach (var d in Matching(drivers, d => $"{d.FirstName} {d.LastName} {d.Username}", driverSearch))
                        {
                            <label class="tr-check"><input id="@($"sales-driver-{d.Id}")" type="checkbox" checked="@pickedDrivers.Contains(d.Id)" disabled="@allDrivers"
                                @onchange="e => Toggle(pickedDrivers, d.Id, (bool)e.Value!)" /> @d.FirstName @d.LastName (@d.Username)</label>
                        }
                    </div>
                }
            </fieldset>
        }
        else
        {
            <fieldset class="sales-pick">
                <legend>Sponsors</legend>
                <input id="sponsor-search" type="search" placeholder="Search sponsors by name" aria-label="Search sponsors by name"
                    @bind="sponsorSearch" @bind:event="oninput" />
                <p class="sales-count" role="status">@Count(allSponsors, picked.Count, companies.Count, "sponsor")</p>
                <div class="sales-options-list">
                    <label class="tr-check"><input id="sales-all" type="checkbox" checked="@allSponsors" @onchange="e => allSponsors = Clear((bool)e.Value!, picked)" /> All sponsors</label>
                    @foreach (var c in Matching(companies, c => c.Name, sponsorSearch))
                    {
                        <label class="tr-check"><input id="@($"sales-company-{c.Id}")" type="checkbox" checked="@picked.Contains(c.Id)" disabled="@allSponsors"
                            @onchange="e => Toggle(picked, c.Id, (bool)e.Value!)" /> @c.Name</label>
                    }
                </div>
            </fieldset>
        }
        <div class="sales-options">
            <label class="filter-field">
                <span>Report by</span>
                <select id="sales-by" @bind="by">
                    <option value="sponsor">Sponsor</option>
                    <option value="driver">Driver</option>
                </select>
            </label>
            <label class="filter-field"><span>From</span><input id="sales-from" type="date" @bind="from" /></label>
            <label class="filter-field"><span>To</span><input id="sales-to" type="date" @bind="to" /></label>
            <label class="filter-field">
                <span>View</span>
                <select id="sales-view" @bind="view">
                    <option value="summary">Summary</option>
                    <option value="detailed">Detailed</option>
                </select>
            </label>
            <button class="tr-btn" type="submit" disabled="@busy">View report</button>
        </div>
    </form>

    @if (error is not null)
    {
        <p class="tr-alert-error" role="alert">@error</p>
    }
    else if (busy && rows.Count == 0)
    {
        <p role="status">Loading report...</p>
    }
    else if (rows.Count > 0)
    {
        <p class="tr-muted">@shown
            <button type="button" class="tr-btn pdf" disabled="@busy" @onclick="() => Download(false)">Download PDF</button>
            <button type="button" class="tr-btn html" disabled="@busy" @onclick="() => Download(true)">Download HTML</button></p>
        <div class="tr-table-wrap">
            <table class="tr-table" aria-label="@(shownByDriver ? "Sales by driver" : "Sales by sponsor")">
                <thead>
                    <tr>
                        @foreach (var c in SummaryColumns)
                        {
                            <th scope="col">@c</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in rows)
                    {
                        <tr>
                            @foreach (var v in SummaryRow(g))
                            {
                                <td>@v</td>
                            }
                        </tr>
                    }
                </tbody>
                @if (rows.Count > 1)
                {
                    <tfoot>
                        <tr>
                            <th scope="row">Total</th>
                            @foreach (var v in TotalRow().Skip(1))
                            {
                                <td>@v</td>
                            }
                        </tr>
                    </tfoot>
                }
            </table>
        </div>

        @if (shownDetailed)
        {
            @foreach (var g in rows)
            {
                <section class="sales-detail">
                    <h2>@Heading(g)</h2>
                    @if (g.Sales.Count == 0)
                    {
                        <p class="tr-muted">No sales in this date range.</p>
                    }
                    else
                    {
                        <div class="tr-table-wrap">
                            <table class="tr-table" aria-label="@($"{Heading(g)} sales")">
                                <thead>
                                    <tr>
                                        @foreach (var c in DetailColumns)
                                        {
                                            <th scope="col">@c</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sale in g.Sales)
                                    {
                                        <tr>
                                            @foreach (var v in DetailRow(sale))
                                            {
                                                <td>@v</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
        }
    }
</div>

<style>
    .sales-filters {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 16px;
        margin-bottom: 16px;
    }

    .sales-pick {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin: 0;
    }

    .sales-options-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 16px;
        max-height: 160px;
        overflow-y: auto;
    }

    .sales-count {
        margin: 0;
        font-size: .9rem;
    }

    .sales-options {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: end;
        align-content: start;
        gap: 8px;
    }

    .sales-options .filter-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .sales-detail h2 {
        margin-top: 24px;
    }

    .tr-table tfoot th, .tr-table tfoot td {
        font-weight: 600;
    }

    @@media (max-width: 760px) {
        .sales-filters, .sales-options {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private List<Company> companies = [];
    private List<Driver> drivers = [];
    private readonly HashSet<int> picked = [];
    private readonly HashSet<int> pickedDrivers = [];
    private bool allSponsors = true;
    private bool allDrivers = true;
    private int driverCompany;
    private string sponsorSearch = "";
    private string driverSearch = "";
    private string by = "sponsor";
    private bool byDriver => by == "driver";
    private DateOnly? from;
    private DateOnly? to;
    private string view = "summary";
    private bool detailed => view == "detailed";
    private bool shownDetailed;
    private bool shownByDriver;
    private string shown = "";
    private List<Group> rows = [];

    protected override async Task OnInitializedAsync()
    {
        await SignedIn();
        await Send(c => c.GetAsync("companies"), async r => companies = await r.Content.ReadFromJsonAsync<List<Company>>() ?? [],
            crashed: "Couldn't load the sponsor list. Please try again.");
        if (error is null) await Load();
    }

    private static IEnumerable<T> Matching<T>(IEnumerable<T> items, Func<T, string> name, string search) =>
        string.IsNullOrWhiteSpace(search) ? items : items.Where(i => name(i).Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));

    private static string Count(bool all, int picked, int total, string noun) =>
        all ? $"All {total} {noun}{(total == 1 ? "" : "s")} selected" : $"{picked} of {total} {noun}{(total == 1 ? "" : "s")} selected";

    private static bool Clear(bool all, HashSet<int> set)
    {
        if (all) set.Clear();
        return all;
    }

    private static void Toggle(HashSet<int> set, int item, bool on)
    {
        if (on) set.Add(item);
        else set.Remove(item);
    }

    private async Task PickSponsor(ChangeEventArgs e)
    {
        driverCompany = int.TryParse(e.Value?.ToString(), out var c) ? c : 0;
        drivers = [];
        pickedDrivers.Clear();
        allDrivers = true;
        driverSearch = "";
        if (driverCompany == 0) return;
        await Send(c => c.GetAsync($"admin/accounts?type=driver&companyId={driverCompany}"),
            async r => drivers = await r.Content.ReadFromJsonAsync<List<Driver>>() ?? [],
            crashed: "Couldn't load that sponsor's drivers. Please try again.");
    }

    private async Task Load()
    {
        error = null;
        if (from > to)
        {
            error = "The start date must be on or before the end date.";
            return;
        }
        var query = new List<string> { "detailed=" + (detailed ? "true" : "false") };
        string path;
        if (byDriver)
        {
            if (driverCompany == 0)
            {
                error = "Choose a sponsor to see its drivers.";
                return;
            }
            if (!allDrivers && pickedDrivers.Count == 0)
            {
                error = "Pick at least one driver, or choose all drivers.";
                return;
            }
            path = "reports/sales/drivers";
            query.Add("companyId=" + driverCompany);
            if (!allDrivers) query.AddRange(pickedDrivers.Order().Select(d => "driverIds=" + d));
        }
        else
        {
            if (!allSponsors && picked.Count == 0)
            {
                error = "Pick at least one sponsor, or choose all sponsors.";
                return;
            }
            path = "reports/sales";
            if (!allSponsors) query.AddRange(picked.Order().Select(c => "companyIds=" + c));
        }
        if (from is not null) query.Add("from=" + from.Value.ToString("yyyy-MM-dd"));
        if (to is not null) query.Add("to=" + to.Value.ToString("yyyy-MM-dd"));
        await Send(c => c.GetAsync($"users/{id}/{path}?" + string.Join("&", query)), async r =>
        {
            rows = await r.Content.ReadFromJsonAsync<List<Group>>() ?? [];
            shownDetailed = detailed;
            shownByDriver = byDriver;
            shown = Summary();
        }, crashed: "Couldn't load the sales report. Please try again.");
    }

    private string Summary()
    {
        var who = shownByDriver
            ? (allDrivers ? "All drivers" : string.Join(", ", rows.Select(g => g.Name))) + " at " + companies.First(c => c.Id == driverCompany).Name
            : allSponsors ? "All sponsors" : string.Join(", ", rows.Select(g => g.Name));
        var range = (from, to) switch
        {
            (null, null) => "all time",
            ({ } f, null) => $"since {f:yyyy-MM-dd}",
            (null, { } t) => $"through {t:yyyy-MM-dd}",
            ({ } f, { } t) => $"{f:yyyy-MM-dd} to {t:yyyy-MM-dd}"
        };
        return $"{who}, {range}, {(shownDetailed ? "detailed" : "summary")}.";
    }

    private string[] SummaryColumns => shownByDriver
        ? ["Driver", "Sponsor", "Orders", "Items", "Points", "Dollars"]
        : ["Sponsor", "Orders", "Items", "Points", "Dollars"];

    private static readonly string[] DetailColumns = ["Date (UTC)", "Sponsor", "Driver", "Products", "Points", "Dollars", "Status"];

    private string Heading(Group g) => shownByDriver ? $"{g.Name} ({g.Username})" : g.Name;

    private string[] SummaryRow(Group g) => shownByDriver
        ? [Heading(g), g.Sponsor ?? "", g.Orders.ToString("N0"), g.Items.ToString("N0"), g.Points.ToString("N0"), Usd(g.Dollars)]
        : [g.Name, g.Orders.ToString("N0"), g.Items.ToString("N0"), g.Points.ToString("N0"), Usd(g.Dollars)];

    private string[] TotalRow()
    {
        string[] totals = [rows.Sum(g => g.Orders).ToString("N0"), rows.Sum(g => g.Items).ToString("N0"),
            rows.Sum(g => g.Points).ToString("N0"), Usd(rows.Sum(g => g.Dollars))];
        return shownByDriver ? ["Total", "", .. totals] : ["Total", .. totals];
    }

    private static string[] DetailRow(Sale s) =>
        [s.At?.ToString("yyyy-MM-dd HH:mm") ?? "Not recorded", s.Sponsor, $"{s.DriverName} ({s.Username})", s.Products,
            s.Points.ToString("N0"), Usd(s.Dollars), s.Status];

    private static string Usd(decimal d) => "$" + d.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);

    private async Task Download(bool html)
    {
        busy = true;
        try
        {
            var sections = new List<PdfSection>
            {
                new("Summary", SummaryColumns, rows.Select(SummaryRow).Concat(rows.Count > 1 ? [TotalRow()] : []).ToArray())
            };
            if (shownDetailed)
                sections.AddRange(rows.Select(g => new PdfSection(Heading(g), DetailColumns, g.Sales.Select(DetailRow).ToArray())));
            var subtitle = $"{shown} {PdfReport.Generated()}";
            if (html)
                await PdfReport.SaveHtml(Js, "Sales report", subtitle, sections, "sales-report.html");
            else
                await PdfReport.Save(Js, "Sales report", subtitle, sections, "sales-report.pdf");
        }
        catch (JSException)
        {
            error = "Couldn't build the download. Try again in a moment.";
        }
        finally
        {
            busy = false;
        }
    }

    private sealed record Driver(int Id, string Username, string FirstName, string LastName);
    private sealed record Group(string Name, string? Username, string? Sponsor, int Orders, int Items, long Points, decimal Dollars, List<Sale> Sales);
    private sealed record Sale(int OrderId, DateTime? At, string Sponsor, string DriverName, string Username, string Products,
        int Items, long Points, decimal Dollars, string Status);
}
