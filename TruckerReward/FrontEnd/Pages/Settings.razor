@page "/settings"
@attribute [Authorize]
@inject IJSRuntime Js

<PageTitle>Settings</PageTitle>

<div class="tr-page">
    <h1>Settings</h1>
    <div class="tr-cards">
        <section class="tr-card">
            <h2>Appearance</h2>
            <p>Use black and dark grey surfaces with emerald green accents.</p>
            <label class="theme-switch" for="dark-mode">
                <input id="dark-mode" type="checkbox" role="switch" checked="@darkMode"
                       disabled="@(!themeReady)" @onchange="ChangeTheme" aria-describedby="theme-help" />
                <span>Dark mode</span>
            </label>
            <p id="theme-help" class="tr-muted">Your choice is saved in this browser.</p>
            @if (themeError is not null)
            {
                <p role="alert" class="tr-alert-error">@themeError</p>
            }
        </section>
        <section class="tr-card">
            <h2>Account</h2>
            <p>Update your personal details and account information.</p>
            <a href="account/profile">Edit account</a>
        </section>
        <section class="tr-card">
            <h2>Notifications</h2>
            <p>Choose which notifications you receive and how they reach you.</p>
            <a href="notifications/settings">Notification settings</a>
        </section>
        <section class="tr-card">
            <h2>Security and privacy</h2>
            <p>Manage your sign-in methods, devices, and personal data.</p>
            <p><a href="account/passkeys">Face ID and passkeys</a></p>
            <p><a href="account/sign-in-codes">Sign-in codes</a></p>
            <p><a href="account/devices">Devices</a></p>
            <p><a href="account/data">Your data</a></p>
        </section>
    </div>
</div>

<style>
    .theme-switch { display: flex; align-items: center; gap: 12px; font-weight: 600; margin: 16px 0; }
    .theme-switch input { width: 40px; height: 22px; accent-color: var(--brand); }
</style>

@code {
    private bool darkMode;
    private bool themeReady;
    private string? themeError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            darkMode = await Js.InvokeAsync<bool>("truckerTheme.getDarkMode");
            themeReady = true;
        }
        catch (JSException)
        {
            themeError = "Couldn't load appearance settings. Please refresh the page.";
        }
        StateHasChanged();
    }

    private async Task ChangeTheme(ChangeEventArgs e)
    {
        var enabled = e.Value is true;
        try
        {
            await Js.InvokeVoidAsync("truckerTheme.setDarkMode", enabled);
            darkMode = enabled;
            themeError = null;
        }
        catch (JSException)
        {
            themeError = "Couldn't change the appearance. Please try again.";
        }
    }
}
