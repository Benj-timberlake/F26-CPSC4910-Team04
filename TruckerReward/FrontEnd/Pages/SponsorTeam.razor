@page "/sponsor-team"
@attribute [Authorize(Roles = "sponsor")]
@inherits BackendPage

<PageTitle>Your team</PageTitle>

<div class="tr-page-narrow">
    <div class="tr-card">
        <h1>Your team</h1>

        <Alerts Notice="@notice" Error="@error" />

        @if (noCompany)
        {
            <p>You aren't with a company yet, so there's no team to manage.</p>
        }
        else
        {
            <form class="tr-form invite" @onsubmit="Invite">
                <h2>Add a sponsor user</h2>
                <label for="invite-username">Username</label>
                <input id="invite-username" @bind="username" />
                <label for="invite-first">First name</label>
                <input id="invite-first" @bind="firstName" />
                <label for="invite-last">Last name</label>
                <input id="invite-last" @bind="lastName" />
                <label for="invite-email">Email</label>
                <input id="invite-email" type="email" @bind="email" />
                <button type="submit" class="tr-btn" disabled="@busy">Send invite</button>
            </form>

            @if (team is not null)
            {
                <ul class="team-list tr-list">
                    @foreach (var m in team)
                    {
                        <li>
                            <strong>@m.FirstName @m.LastName</strong> (@m.Username) <span class="tr-muted">@m.Email@(m.Status == "inactive" ? ", deactivated" : "")</span>
                        </li>
                    }
                </ul>
            }
        }
    </div>
</div>

<style>
    .invite {
        margin-bottom: 24px;
    }

    .team-list li {
        padding: 10px 0;
    }
</style>

@code {
    private List<Member>? team;
    private bool noCompany;
    private string username = "";
    private string firstName = "";
    private string lastName = "";
    private string email = "";

    protected override async Task OnInitializedAsync()
    {
        await SignedIn();
        await Load();
    }

    private async Task Load()
    {
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var response = await client.GetAsync($"users/{id}/sponsor-team");
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                noCompany = true;
                return;
            }
            response.EnsureSuccessStatusCode();
            team = await response.Content.ReadFromJsonAsync<List<Member>>() ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            error = "Couldn't load your team right now. Try again in a moment.";
        }
    }

    private Task Invite() =>
        Send(c => c.PostAsJsonAsync($"users/{id}/sponsor-team", new { username, firstName, lastName, email }), async _ =>
        {
            notice = $"{username.Trim()} was added and emailed a link to set a password.";
            username = firstName = lastName = email = "";
            await Load();
        });

    private sealed record Member(int Id, string Username, string FirstName, string LastName, string Email, string Status);
}
