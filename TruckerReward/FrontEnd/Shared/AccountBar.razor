@namespace FrontEnd.Shared
@using System.Security.Claims
@inject IHttpClientFactory HttpClientFactory

<nav class="account-bar">
    <a href="">Home</a>
    <a href="about-us">About Us</a>
    <a href="products">Products</a>
    <AuthorizeView>
        <Authorized>
            <a href="dashboard">Dashboard</a>
            <AuthorizeView Roles="sponsor,admin" Context="applicationsNav">
                @if (applicationsNav.User.IsInRole("admin") ||
                    (applicationsNav.User.IsInRole("sponsor") && sponsorCompanyId is not null && sponsorCompanyLoaded))
                {
                    <a href="applications">Applications</a>
                }
            </AuthorizeView>
            <AuthorizeView Roles="admin" Context="admin">
                <a href="admin/security">Security</a>
            </AuthorizeView>
            <span class="spacer"></span>
            <a href="cart"><img src="cart.jpg" alt="Cart" width="24" height="24" style="object-fit: contain;" /></a>
            <span>@context.User.Identity?.Name</span>
            <form method="post" action="account/logout">
                <button type="submit">Log out</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <span class="spacer"></span>
            <a href="login">Log in</a>
            <a href="register">Create account</a>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private int? sponsorCompanyId;
    private bool sponsorCompanyLoaded;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        if (!user.IsInRole("sponsor"))
            return;

        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(id))
            return;

        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            var account = await client.GetFromJsonAsync<SponsorAccount>($"users/{id}");
            sponsorCompanyId = account?.CompanyId;
            sponsorCompanyLoaded = account is not null;
        }
        catch (HttpRequestException)
        {
            // Fail closed: don't show this tab if sponsor company status can't be confirmed.
        }
    }

    private sealed record SponsorAccount(int? CompanyId);
}

<style>
    .account-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 18px;
        padding: 12px 24px;
        background: var(--brand);
        color: white;
    }

    .account-bar a {
        color: white;
        text-decoration: none;
    }

    .account-bar .spacer {
        flex: 1;
    }

    .account-bar button {
        padding: 6px 12px;
        background: transparent;
        color: white;
        border: 1px solid white;
        border-radius: 6px;
        cursor: pointer;
        white-space: nowrap;
    }
</style>
