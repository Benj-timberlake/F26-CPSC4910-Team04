@namespace FrontEnd.Shared
@using System.Security.Claims
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@implements IDisposable

@* <base href> would send a bare #main-content to the home page *@
<a class="skip-link" href="#main-content" onclick="document.getElementById('main-content').focus(); return false;">Skip to main content</a>

<nav class="account-bar" aria-label="Main">
    <AuthorizeView>
        <Authorized>
            <div class="profile-menu" @onkeydown="HandleProfileKey">
                <button type="button" class="profile-link" aria-label="Profile menu"
                        aria-expanded="@(profileOpen ? "true" : "false")" aria-controls="profile-options"
                        @onclick="() => profileOpen = !profileOpen">
                    <span class="profile-label">
                        <span class="profile-username">@context.User.Identity?.Name</span>
                        @if (!string.IsNullOrWhiteSpace(profileCompany))
                        {
                            <span class="profile-company">@profileCompany</span>
                        }
                    </span>
                    <span class="profile-chevron" aria-hidden="true">▾</span>
                </button>
                @if (profileOpen)
                {
                    <div id="profile-options" class="profile-options" aria-label="Account options">
                        <a href="profile" @onclick="CloseProfile">Profile</a>
                        <a href="settings" @onclick="CloseProfile">Settings</a>
                        <form method="post" action="account/logout">
                            <button type="submit">Logout</button>
                        </form>
                    </div>
                }
            </div>
            @if (profileOpen)
            {
                <button type="button" class="profile-backdrop" tabindex="-1" aria-label="Close profile menu" @onclick="CloseProfile"></button>
            }
            <div class="sidebar-quick-links" aria-label="Quick links">
                <NotificationBell />
                <AuthorizeView Roles="sponsor" Context="catalogNav">
                    <a href="catalog" class='catalog-link @NavClass("catalog")' aria-label="Sponsor catalog" title="Catalog">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9 5 3h14l2 6" /><path d="M4 9v12h16V9M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0" /><path d="M9 21v-6h6v6" /></svg>
                    </a>
                    <a href="sponsor/orders" class='sponsor-orders-link @NavClass("sponsor/orders")' aria-label="Driver orders" title="Driver orders">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h18v13H3zM7 21h10M12 17v4" /><path d="M7 8h10M7 12h6" /></svg>
                    </a>
                </AuthorizeView>
                <AuthorizeView Roles="driver" Context="cartNav">
                    <a href="cart" class='cart-link @NavClass("cart")' aria-label="Cart" title="Cart">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="9" cy="21" r="1" />
                            <circle cx="20" cy="21" r="1" />
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                        </svg>
                    </a>
                </AuthorizeView>
                <AuthorizeView Roles="driver" Context="wishlistNav">
                    <a href="pastorders" class='past-orders-link @NavClass("pastorders")' aria-label="Past Orders" title="Past Orders">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M4 3h13l3 3v15H4z" />
                            <path d="M17 3v4h4M8 11h8M8 15h8M8 19h5" />
                        </svg>
                    </a>
                    <a href="wishlist" class='wishlist-link @NavClass("wishlist")' aria-label="Favorites" title="Favorites"><HeartIcon /></a>
                </AuthorizeView>
            </div>
            <a href="" class='@NavClass("home")'>Home</a>
            <a href="about-us" class='@NavClass("about-us")'>About Us</a>
            <a href="products" class='@NavClass("products")'>Products</a>
            <AuthorizeView Roles="admin" Context="admin">
                <a href="admin/security" class='@NavClass("admin/security")'>Security</a>
                <a href="manage-accounts" class='@NavClass("manage-accounts")'>Manage Accounts</a>
                <a href="admin/reports" class='@NavClass("admin/reports")'>Sales Report</a>
                <a href="admin/banner" class='@NavClass("admin/banner")'>Banner</a>
            </AuthorizeView>
            <AuthorizeView Roles="driver" Context="driver">
                <a href="points" class='@NavClass("points")'>Points</a>
                <a href="achievements" class='@NavClass("achievements")'>Achievements</a>
            </AuthorizeView>
            <AuthorizeView Roles="driver,sponsor" Context="news">
                <a href="announcements" class='@NavClass("announcements")'>Announcements</a>
            </AuthorizeView>
            <AuthorizeView Roles="sponsor,admin" Context="pointsNav">
                <a href="audit" class='@NavClass("audit")'>Audit log</a>
            </AuthorizeView>
            <AuthorizeView Roles="sponsor" Context="sponsorNav">
                <a href="sponsor-report" class='@NavClass("sponsor-report")'>Report</a>
                <a href="accounts" class='@NavClass("accounts")'>Accounts</a>
                <a href="achievement-goals" class='@NavClass("achievement-goals")'>Achievement goals</a>
            </AuthorizeView>
        </Authorized>
        <NotAuthorized>
            <a href="about-us" class='@NavClass("about-us")'>About Us</a>
            <a href="login" class='@NavClass("login")'>Log in</a>
            <a href="register" class='@NavClass("register")'>Create account</a>
        </NotAuthorized>
    </AuthorizeView>
</nav>

<style>
    .account-bar {
        display: flex;
        flex: 0 0 250px;
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
        box-sizing: border-box;
        width: 250px;
        height: 100vh;
        position: fixed;
        inset: 0 auto 0 0;
        overflow-y: auto;
        padding: 18px 14px;
        background: var(--brand);
        color: white;
    }

    .account-bar a {
        display: flex;
        align-items: center;
        box-sizing: border-box;
        width: 100%;
        min-height: 48px;
        padding: 0 12px;
        border-radius: 6px;
        color: white;
        font-size: 18px;
        line-height: 1.25;
        text-decoration: none;
    }

    .account-bar a:hover, .account-bar a:focus-visible { background: #ffffff24; }
    .account-bar a.nav-current { background: #ffffff35; box-shadow: inset 4px 0 #fef3c7; font-weight: 700; }

    .account-bar .wishlist-link,
    .account-bar .cart-link,
    .account-bar .past-orders-link,
    .account-bar .catalog-link,
    .account-bar .sponsor-orders-link {
        display: inline-flex;
        justify-content: center;
        flex: 0 0 48px;
        width: 48px;
        min-height: 48px;
        padding: 0;
    }

    .sidebar-quick-links { display: flex; align-items: center; gap: 8px; }
    .sidebar-quick-links .notification-bell { flex: 0 0 48px; width: 48px; min-height: 48px; justify-content: center; padding: 0; }

    .account-bar .spacer {
        flex: 1;
        min-height: 8px;
    }

    .profile-menu {
        position: relative;
        z-index: 101;
        width: 100%;
    }

    .account-bar .profile-link { box-sizing: border-box; width: 100%; min-height: 48px; text-align: left; white-space: normal; }
    .account-bar .profile-link { display: flex; align-items: center; gap: 8px; }
    .profile-label { display: flex; flex: 1; flex-direction: column; min-width: 0; }
    .profile-username { font-weight: 700; }
    .profile-company { overflow: hidden; color: #ffffffd9; font-size: 14px; text-overflow: ellipsis; white-space: nowrap; }
    .profile-chevron { margin-left: auto; }

    .profile-options {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 180px;
        padding: 6px;
        background: white;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        box-shadow: 0 8px 24px #0003;
    }

    .account-bar .profile-options a,
    .account-bar .profile-options button {
        display: block;
        box-sizing: border-box;
        width: 100%;
        padding: 10px 12px;
        border: 0;
        border-radius: 4px;
        background: transparent;
        color: #1f2937;
        font: inherit;
        text-align: left;
        text-decoration: none;
    }

    .profile-options form { margin: 0; }

    .account-bar .profile-options a:hover,
    .account-bar .profile-options button:hover,
    .account-bar .profile-options a:focus-visible,
    .account-bar .profile-options button:focus-visible {
        background: #f3f4f6;
        outline: 2px solid var(--brand);
        outline-offset: -2px;
    }

    .account-bar .profile-backdrop {
        position: fixed;
        inset: 0;
        z-index: 100;
        width: 100%;
        height: 100%;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        cursor: default;
    }

    .account-bar button,
    .account-bar .profile-link {
        padding: 6px 12px;
        background: transparent;
        color: white;
        border: 1px solid white;
        border-radius: 6px;
        cursor: pointer;
        white-space: nowrap;
    }

    @@media (max-width: 720px) {
        .account-bar { position: relative; inset: auto; flex-direction: row; flex-wrap: wrap; width: 100%; height: auto; min-height: 0; padding: 10px 12px; gap: 6px; }
        .account-bar .spacer { display: none; }
        .account-bar a { width: auto; min-height: 44px; }
        .sidebar-quick-links { flex-direction: row; }
    }
</style>

@code {
    private bool profileOpen;
    private string? profileCompany;
    private bool isAdmin;
    private bool isSponsor;
    private string currentRoute = "";

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        isAdmin = user.IsInRole("admin");
        isSponsor = user.IsInRole("sponsor");
        currentRoute = Route();
        Navigation.LocationChanged += OnLocationChanged;
        if (!user.IsInRole("driver") && !user.IsInRole("sponsor")) return;
        var id = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(id)) return;
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            profileCompany = (await client.GetFromJsonAsync<HeaderAccount>($"users/{id}"))?.CompanyName;
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            profileCompany = null;
        }
    }

    private string Route() => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();

    private string NavClass(string item)
    {
        var active = item switch
        {
            "home" => currentRoute is "" or "dashboard",
            "accounts" => currentRoute == "accounts" || (isSponsor && currentRoute is "applications" or "leaderboard"),
            "manage-accounts" => currentRoute is "manage-accounts" or "admin/accounts" or "admin/users" || (isAdmin && currentRoute is "applications" or "manage-points"),
            "points" => currentRoute is "points",
            "cart" => currentRoute is "cart",
            "pastorders" => currentRoute is "pastorders",
            "wishlist" => currentRoute is "wishlist",
            "catalog" => currentRoute is "catalog",
            "sponsor/orders" => currentRoute is "sponsor/orders",
            _ => currentRoute == item
        };
        return active ? "nav-current" : "";
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        currentRoute = Route();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void CloseProfile() => profileOpen = false;

    private void HandleProfileKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseProfile();
    }

    private sealed record HeaderAccount(string? CompanyName);
}
