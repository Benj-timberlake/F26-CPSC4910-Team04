@namespace FrontEnd.Shared

@* <base href> would send a bare #main-content to the home page *@
<a class="skip-link" href="#main-content" onclick="document.getElementById('main-content').focus(); return false;">Skip to main content</a>

<nav class="account-bar" aria-label="Main">
    <AuthorizeView Context="homeNav">
        @if (!homeNav.User.IsInRole("sponsor"))
        {
            <a href="">Home</a>
        }
    </AuthorizeView>
    <a href="about-us">About Us</a>
    <a href="products">Products</a>
    <AuthorizeView>
        <Authorized>
            @if (context.User.HasClaim(c => c.Type == FrontEnd.Auth.TruckerSignIn.SponsorViewClaim))
            {
                <span>Viewing as @context.User.Identity?.Name</span>
                <form method="post" action="account/driver-view/return">
                    <button type="submit">Return to sponsor view</button>
                </form>
            }
            <a href="dashboard">Dashboard</a>
            <AuthorizeView Roles="admin" Context="admin">
                <a href="admin/security">Security</a>
                <a href="admin/accounts">Accounts</a>
                <a href="admin/banner">Banner</a>
            </AuthorizeView>
            <AuthorizeView Roles="driver" Context="driver">
                <a href="points">Points</a>
                <a href="achievements">Achievements</a>
            </AuthorizeView>
            <AuthorizeView Roles="driver,sponsor" Context="news">
                <a href="announcements">Announcements</a>
            </AuthorizeView>
            <AuthorizeView Roles="sponsor,admin" Context="pointsNav">
                @if (pointsNav.User.IsInRole("admin"))
                {
                    <a href="manage-points">Driver points</a>
                }
                <a href="audit">Audit log</a>
            </AuthorizeView>
            <AuthorizeView Roles="sponsor" Context="sponsorNav">
                <a href="sponsor-team">Your team</a>
                <a href="achievement-goals">Achievement goals</a>
                <a href="sponsors">Other sponsors</a>
            </AuthorizeView>
            <span class="spacer"></span>
            <NotificationBell />
            <AuthorizeView Roles="driver" Context="wishlistNav">
                <a href="wishlist" class="wishlist-link" aria-label="Wishlist" title="Wishlist"><HeartIcon /></a>
            </AuthorizeView>
            <a href="cart" class="cart-link" aria-label="Cart">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="21" r="1" />
                    <circle cx="20" cy="21" r="1" />
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                </svg>
            </a>
            <a href="profile" class="profile-link">@context.User.Identity?.Name</a>
            <form method="post" action="account/logout">
                <button type="submit">Log out</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <span class="spacer"></span>
            <a href="login">Log in</a>
            <a href="register">Create account</a>
        </NotAuthorized>
    </AuthorizeView>
</nav>
<SiteBanner />
<AuthorizeView Context="viewing">
    @if (viewing.User.FindFirst(FrontEnd.Auth.ViewAs.ViewerNameClaim) is { } viewer)
    {
        <div class="view-as-banner" role="status">
            Viewing the site as @viewing.User.Identity?.Name, read-only.
            <form method="post" action="account/view-as/stop">
                <button type="submit">Return to @viewer.Value</button>
            </form>
        </div>
    }
</AuthorizeView>

<style>
    .account-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 18px;
        padding: 12px 24px;
        background: var(--brand);
        color: white;
    }

    .account-bar a {
        color: white;
        text-decoration: none;
    }

    .account-bar .wishlist-link,
    .account-bar .cart-link {
        display: inline-flex;
    }

    .account-bar .spacer {
        flex: 1;
    }

    .view-as-banner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        padding: 8px 24px;
        background: #fef3c7;
        color: #78350f;
    }

    .view-as-banner button {
        padding: 4px 10px;
        border: 1px solid #78350f;
        border-radius: 6px;
        background: transparent;
        color: inherit;
        cursor: pointer;
    }

    .account-bar button,
    .account-bar .profile-link {
        padding: 6px 12px;
        background: transparent;
        color: white;
        border: 1px solid white;
        border-radius: 6px;
        cursor: pointer;
        white-space: nowrap;
    }
</style>
