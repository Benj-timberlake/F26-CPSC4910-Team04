@namespace FrontEnd.Shared
@implements IAsyncDisposable
@inject IJSRuntime JS

<nav class="account-bar">
    <AuthorizeView Context="homeNav">
        @if (!homeNav.User.IsInRole("sponsor"))
        {
            <a href="">Home</a>
        }
    </AuthorizeView>
    <a href="about-us">About Us</a>
    <a href="products">Products</a>
    <AuthorizeView>
        <Authorized>
            @if (context.User.HasClaim(c => c.Type == FrontEnd.Auth.TruckerSignIn.SponsorViewClaim))
            {
                <span>Viewing as @context.User.Identity?.Name</span>
                <form method="post" action="account/driver-view/return">
                    <button type="submit">Return to sponsor view</button>
                </form>
            }
            <a href="dashboard">Dashboard</a>
            <AuthorizeView Roles="admin" Context="admin">
                <a href="admin/security">Security</a>
                <a href="admin/accounts">Accounts</a>
            </AuthorizeView>
            <AuthorizeView Roles="driver" Context="driver">
                <a href="points">Points</a>
            </AuthorizeView>
            <AuthorizeView Roles="sponsor,admin" Context="pointsNav">
                @if (pointsNav.User.IsInRole("admin"))
                {
                    <a href="manage-points">Driver points</a>
                }
                <a href="audit">Audit log</a>
            </AuthorizeView>
            <AuthorizeView Roles="sponsor" Context="sponsorNav">
                <a href="sponsor-team">Your team</a>
                <a href="sponsors">Other sponsors</a>
            </AuthorizeView>
            <span class="spacer"></span>
            <NotificationBell />
            <AuthorizeView Roles="driver" Context="wishlistNav">
                <a href="wishlist" class="wishlist-link" aria-label="Wishlist" title="Wishlist"><HeartIcon /></a>
            </AuthorizeView>
            <a href="cart" class="cart-link" aria-label="Cart">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="21" r="1" />
                    <circle cx="20" cy="21" r="1" />
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                </svg>
            </a>
            <details class="profile-dropdown">
                <summary class="profile-link">@context.User.Identity?.Name</summary>
                <div class="profile-dropdown-items">
                    <a href="profile">Profile</a>
                    <button type="button" disabled>Settings</button>
                    <form method="post" action="account/logout">
                        <button type="submit">Log out</button>
                    </form>
                </div>
            </details>
        </Authorized>
        <NotAuthorized>
            <span class="spacer"></span>
            <a href="login">Log in</a>
            <a href="register">Create account</a>
        </NotAuthorized>
    </AuthorizeView>
</nav>
<AuthorizeView Context="viewing">
    @if (viewing.User.FindFirst(FrontEnd.Auth.ViewAs.ViewerNameClaim) is { } viewer)
    {
        <div class="view-as-banner" role="status">
            Viewing the site as @viewing.User.Identity?.Name, read-only.
            <form method="post" action="account/view-as/stop">
                <button type="submit">Return to @viewer.Value</button>
            </form>
        </div>
    }
</AuthorizeView>

@code {
    private IJSObjectReference? dropdownModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        dropdownModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/profileDropdown.js");
        await dropdownModule.InvokeVoidAsync("initialize");
    }

    public async ValueTask DisposeAsync()
    {
        if (dropdownModule is null) return;
        try
        {
            await dropdownModule.InvokeVoidAsync("dispose");
            await dropdownModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser connection may already be closed.
        }
    }
}

<style>
    .account-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 18px;
        padding: 12px 24px;
        background: var(--brand);
        color: white;
    }

    .account-bar a {
        color: white;
        text-decoration: none;
    }

    .account-bar .wishlist-link,
    .account-bar .cart-link {
        display: inline-flex;
    }

    .account-bar .spacer {
        flex: 1;
    }

    .view-as-banner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        padding: 8px 24px;
        background: #fef3c7;
        color: #78350f;
    }

    .view-as-banner button {
        padding: 4px 10px;
        border: 1px solid #78350f;
        border-radius: 6px;
        background: transparent;
        color: inherit;
        cursor: pointer;
    }

    .account-bar button,
    .account-bar .profile-link {
        padding: 6px 12px;
        background: transparent;
        color: white;
        border: 1px solid white;
        border-radius: 6px;
        cursor: pointer;
        white-space: nowrap;
    }

    .profile-dropdown { position: relative; }
    .profile-dropdown summary { display: flex; align-items: center; gap: 8px; list-style: none; }
    .profile-dropdown summary::-webkit-details-marker { display: none; }
    .profile-dropdown-items { position: absolute; right: 0; top: calc(100% + 8px); z-index: 1100; min-width: 160px; padding: 6px; border: 1px solid #e3e9f0; border-radius: 8px; background: white; box-shadow: 0 8px 24px #18283d26; }
    .profile-dropdown-items form { margin: 0; }
    .account-bar .profile-dropdown-items a,
    .account-bar .profile-dropdown-items button { display: block; width: 100%; padding: 10px 12px; border: 0; border-radius: 4px; background: white; color: #1f2937; font: inherit; text-align: left; }
    .profile-dropdown-items a:hover,
    .profile-dropdown-items button:not(:disabled):hover { background: #edf1f6; }
    .account-bar .profile-dropdown-items button:disabled { color: #8a94a3; cursor: default; }
    .profile-dropdown summary:focus-visible,
    .profile-dropdown-items a:focus-visible,
    .profile-dropdown-items button:focus-visible { outline: 2px solid #2455a4; outline-offset: 2px; }
</style>
