@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Routing
@using System.Text.Json
@inject FrontEnd.DifyChatClient DifyChat
@inject ILogger<ChatBot> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

@if (showProfessor)
{
    <div class="professor-container">
        <div class="professor-speech">
            You can't escape me!
        </div>

        <img src="/images/professor-door.png"
             class="professor-popup"
             alt="Professor Easter Egg" />
    </div>
}
<div class="trucker-chat" @ref="chatbotElement">
    <button type="button" class="chat-reset-position" data-no-drag hidden
            aria-label="Move chatbot to bottom-right corner" title="Move chatbot to bottom-right corner"
            @onclick="ResetChatPosition">↘</button>
    @if (isOpen)
    {
        <div class="chat-window">
            <div class="chat-header chat-drag-handle">
                🚚 TruckerBot
                <button @onclick="ToggleChat" data-no-drag>✕</button>
            </div>

            <div class="chat-messages" aria-live="polite">
                @foreach (var message in messages)
                {
                    <div class="chat-message @(message.IsBot ? "bot" : "user")">
                        @message.Text
                    </div>
                }
                @if (isSending)
                {
                    <div class="chat-message bot" role="status">Thinking...</div>
                }
            </div>

            <div class="chat-input">
                <input @bind="userMessage"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       disabled="@isSending"
                       placeholder="Ask me something..." />

                <button @onclick="SendMessage" disabled="@isSending">Send</button>
            </div>
        </div>
    }

    <button class="chat-toggle chat-drag-handle" @onclick="ToggleChat">
        🚚 @(isOpen ? "Close" : "Chat with Your Best Friend")
    </button>
</div>

@code {
    private bool isOpen = false;
    private bool isSending;
    private string userMessage = "";
    private string? conversationId;
    private readonly string difyUserId = Guid.NewGuid().ToString("N");
    private ElementReference chatbotElement;
    private IJSObjectReference? dragModule;
    
protected override void OnInitialized()
{
    Navigation.LocationChanged += OnLocationChanged;
}

protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (firstRender)
    {
        dragModule = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./js/chatbotDrag.js?v=4");

        await dragModule.InvokeVoidAsync(
            "enableChatbotDrag", chatbotElement);
    }

    if (dragModule is not null && isOpen)
        await dragModule.InvokeVoidAsync("updateChatOpenDirection", chatbotElement);
}

private async Task ResetChatPosition()
{
    if (dragModule is not null)
        await dragModule.InvokeVoidAsync("resetChatbotPosition", chatbotElement);
}

private void OnLocationChanged(
    object? sender,
    LocationChangedEventArgs e)
{
    _ = InvokeAsync(async () =>
    {
        if (dragModule is null) return;

        try
        {
            await dragModule.InvokeVoidAsync(
                "resetChatbotPosition", chatbotElement);
        }
        catch (JSDisconnectedException)
        {
            // Ignore disconnected browser sessions.
        }
    });
}

public async ValueTask DisposeAsync()
{
    Navigation.LocationChanged -= OnLocationChanged;

    if (dragModule is not null)
    {
        try
        {
            await dragModule.InvokeVoidAsync(
                "disableChatbotDrag", chatbotElement);

            await dragModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Ignore disconnected browser sessions.
        }
    }
}


    private List<ChatMessage> messages = new()
    {
        new ChatMessage
        {
            Text = "Welcome to TruckerReward! How can I help?",
            IsBot = true
        }
    };

    private bool showProfessor = false;
private int professorPopupVersion = 0;

private async Task ToggleChat()
{
    bool wasOpen = isOpen;
    isOpen = !isOpen;

    if (wasOpen)
    {
        professorPopupVersion++;
        int version = professorPopupVersion;

        showProfessor = true;

        // Immediately update the interface
        StateHasChanged();

        await Task.Delay(1500);

        if (version == professorPopupVersion)
        {
            showProfessor = false;
            StateHasChanged();
        }
    }
    else
    {
        professorPopupVersion++;
        showProfessor = false;
        StateHasChanged();
    }
}

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendMessage();
    }

    private async Task SendMessage()
    {
        if (isSending || string.IsNullOrWhiteSpace(userMessage))
            return;

        string question = userMessage.Trim();

        messages.Add(new ChatMessage
        {
            Text = question,
            IsBot = false
        });

        userMessage = "";
        isSending = true;
        StateHasChanged();

        try
        {
            var reply = await DifyChat.SendAsync(question, difyUserId, conversationId);
            conversationId = reply.ConversationId ?? conversationId;
            messages.Add(new ChatMessage { Text = reply.Answer, IsBot = true });
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogError(ex, "Unable to get a response from Dify.");
            messages.Add(new ChatMessage { Text = GetFallbackResponse(question), IsBot = true });
        }
        finally
        {
            isSending = false;
        }
    }

    private static string GetFallbackResponse(string question)
    {
        string text = question.ToLowerInvariant();

        if (text.Contains("point"))
            return "Check your dashboard to view your points balance.";

        if (text.Contains("friend"))
            return "You're a silly little boyyyyy";

        if (text.Contains("reward") || text.Contains("redeem"))
            return "Visit the Products page to explore available rewards.";

        if (text.Contains("sponsor"))
            return "Sponsors participate in the TruckerReward program.";

        if (text.Contains("hello") || text.Contains("hi"))
            return "Hey there! How can I help you today dawggggg?";

        return "I can help with points, rewards, and sponsors. Could you rephrase your question dudeeee? " +
            "Don't play with me you know what you're doing kid";
    }

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsBot { get; set; }
    }
}
