@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Routing
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

@if (showProfessor)
{
    <img src="images/professor.png"
         class="professor-popup"
         alt="Professor Easter Egg" />
}
<div class="trucker-chat" @ref="chatbotElement">
    @if (isOpen)
    {
        <div class="chat-window">
            <div class="chat-header chat-drag-handle">
                🚚 TruckerBot
                <button @onclick="ToggleChat" data-no-drag>✕</button>
            </div>

            <div class="chat-messages">
                @foreach (var message in messages)
                {
                    <div class="chat-message @(message.IsBot ? "bot" : "user")">
                        @message.Text
                    </div>
                }
            </div>

            <div class="chat-input">
                <input @bind="userMessage"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       placeholder="Ask me something..." />

                <button @onclick="SendMessage">Send</button>
            </div>
        </div>
    }

    <button class="chat-toggle chat-drag-handle" @onclick="ToggleChat">
        🚚 @(isOpen ? "Close" : "Chat with Your Best Friend")
    </button>
</div>

@code {
    private bool isOpen = false;
    private string userMessage = "";
    private ElementReference chatbotElement;
    private IJSObjectReference? dragModule;
    
protected override void OnInitialized()
{
    Navigation.LocationChanged += OnLocationChanged;
}

protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (firstRender)
    {
        dragModule = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./js/chatbotDrag.js");

        await dragModule.InvokeVoidAsync(
            "enableChatbotDrag", chatbotElement);
    }
}

private void OnLocationChanged(
    object? sender,
    LocationChangedEventArgs e)
{
    _ = InvokeAsync(async () =>
    {
        if (dragModule is null) return;

        try
        {
            await dragModule.InvokeVoidAsync(
                "resetChatbotPosition", chatbotElement);
        }
        catch (JSDisconnectedException)
        {
            // Ignore disconnected browser sessions.
        }
    });
}

public async ValueTask DisposeAsync()
{
    Navigation.LocationChanged -= OnLocationChanged;

    if (dragModule is not null)
    {
        try
        {
            await dragModule.InvokeVoidAsync(
                "disableChatbotDrag", chatbotElement);

            await dragModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Ignore disconnected browser sessions.
        }
    }
}


    private List<ChatMessage> messages = new()
    {
        new ChatMessage
        {
            Text = "Welcome to TruckerReward! How can I help?",
            IsBot = true
        }
    };

    private bool showProfessor = false;
private int professorPopupVersion = 0;

private async Task ToggleChat()
{
    bool wasOpen = isOpen;
    isOpen = !isOpen;

    if (wasOpen)
    {
        // Show professor when chatbot closes
        showProfessor = true;
        int version = ++professorPopupVersion;

        // Keep professor visible for 1.5 seconds
        await Task.Delay(1500);

        if (version == professorPopupVersion)
        {
            showProfessor = false;
            StateHasChanged();
        }
    }
    else
    {
        // Hide professor if chatbot reopens
        professorPopupVersion++;
        showProfessor = false;
    }
}

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            SendMessage();
    }

    private void SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userMessage))
            return;

        string question = userMessage.Trim();

        messages.Add(new ChatMessage
        {
            Text = question,
            IsBot = false
        });

        messages.Add(new ChatMessage
        {
            Text = GetResponse(question),
            IsBot = true
        });

        userMessage = "";
    }

    private string GetResponse(string question)
    {
        string text = question.ToLowerInvariant();

        if (text.Contains("point"))
            return "Check your dashboard to view your points balance.";
        
        if (text.Contains("friend"))
            return "You're a silly little boyyyyy";

        if (text.Contains("reward") || text.Contains("redeem"))
            return "Visit the Products page to explore available rewards.";

        if (text.Contains("sponsor"))
            return "Sponsors participate in the TruckerReward program.";

        if (text.Contains("hello") || text.Contains("hi"))
            return "Hey there! How can I help you today dawggggg?";

        return ("I can help with points, rewards, and sponsors. Could you rephrase your question dudeeee? " +
            "Don't play with me you know what you're doing kid");
    }

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsBot { get; set; }
    }
}
