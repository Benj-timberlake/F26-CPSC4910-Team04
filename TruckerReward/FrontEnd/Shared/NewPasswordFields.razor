@namespace FrontEnd.Shared

@* new password + confirmation, with the policy sentence and a browser-side match check.
   the backend is what actually enforces the policy *@
<label for="password">New password</label>
<input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" @oninput="e => password = e.Value?.ToString()" />
<p class="help">@Policy</p>

<label for="confirm">Confirm new password</label>
<input id="confirm" name="confirm" type="password" required autocomplete="new-password" @oninput="e => confirm = e.Value?.ToString()" />
@if (!string.IsNullOrEmpty(confirm) && confirm != password)
{
    <p class="help tr-mismatch">Passwords don't match yet.</p>
}

@code {
    [Parameter] public string? Policy { get; set; }

    private string? password;
    private string? confirm;
}
