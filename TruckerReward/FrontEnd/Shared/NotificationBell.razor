@namespace FrontEnd.Shared
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<a href="notifications" class="notification-bell" aria-label="@Label">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
    </svg>
    @if (ShowBadge)
    {
        <span class="notification-count">@(unread > 99 ? "99+" : unread.ToString())</span>
    }
</a>

<style>
    .notification-bell {
        position: relative;
        display: inline-flex;
    }

    .notification-count {
        position: absolute;
        top: -6px;
        right: -8px;
        min-width: 18px;
        padding: 0 4px;
        border-radius: 9px;
        background: #dc2626;
        color: white;
        font-size: 11px;
        line-height: 18px;
        text-align: center;
    }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private int unread;

    // hidden on the notifications page
    private bool ShowBadge => unread > 0 && !Nav.ToBaseRelativePath(Nav.Uri).StartsWith("notifications");

    private string Label => ShowBadge ? $"Notifications, {unread} unread" : "Notifications";

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await LoadCount();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await LoadCount();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadCount()
    {
        var id = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
        try
        {
            using var client = HttpClientFactory.CreateClient("Backend");
            unread = (await client.GetFromJsonAsync<Unread>($"users/{id}/notifications/unread"))?.Count ?? 0;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            // keeps the last count until the next page
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private sealed record Unread(int Count);
}
